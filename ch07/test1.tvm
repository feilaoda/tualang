OP_MOV Ra 0        ; a = 0
OP_MOV Rb 1        ; b = 1
OP_MOV Rc 1        ; c = 1
OP_MOV Ri 1        ; i = 1
OP_MOV Rn $ARGV0   ; n = input argument
OP_LABEL L1
OP_SUB Rt Rn Ri    ; t = n - i
OP_JZ Rt L2  ; if (t == 0) jump to END_LOOP
OP_MOV Ra Rb       ; a = b
OP_MOV Rb Rc       ; b = c
OP_ADD Rc Ra Rb    ; c = a + b
OP_ADD Ri Ri 1     ; i = i + 1
OP_JMP L1  ; jump to LOOP_START
OP_LABEL L2
OP_RET Rc          ; return a