import "std/rt" as rt

object Fs {
    // Reads an entire file into a NUL-terminated buffer. Caller must free via `rt.Rt.free`.
    fn readFile(path: string) -> int, string, int {
        let data: string = null
        let n: int = 0
        let err = tua_fs_readfile_alloc(path, &data, &n)
        return err, data, n
    }

    // Writes a string to a file (truncate/create).
    fn writeFile(path: string, data: string) int {
        return tua_fs_writefile_str(path, data)
    }

    // Stat info: `(err, kind, size, mtimeNs, mode)`
    fn stat(path: string) -> int, int, long, long, int {
        let kind: int = 0
        let size: long = 0
        let mtimeNs: long = 0
        let mode: int = 0
        let err = tua_fs_stat_simple(path, &kind, &size, &mtimeNs, &mode)
        return err, kind, size, mtimeNs, mode
    }

    fn mkdir(path: string, mode: int) int {
        return tua_fs_mkdir(path, mode)
    }

    // Resolves absolute path. Caller must free via `rt.Rt.free`.
    fn realpath(path: string) -> int, string {
        let out: string = null
        let err = tua_fs_realpath_alloc(path, &out)
        return err, out
    }

    // Reads directory entries as `string[]`. Free via `Fs.freeStringArray`.
    fn readdir(path: string) -> int, string[] {
        let err: int = 0
        let arr: string[] = tua_fs_readdir_arr(path, &err)
        return err, arr
    }

    fn freeStringArray(names: string[]) {
        tua_fs_string_array_free(names)
    }
}
