import "std/bytes" as bstd

extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string

private fn _imod(a: int, b: int) -> int {
 
 
  return a - (a / b) * b
}

// UTF-8 utilities (v0): validation, decode, boundary helpers, and basic encoding.
// Note: Slice<T> is not yet supported as a function parameter ABI, so this module operates on `bytes`.
object Utf8 {
    // Decode one UTF-8 codepoint starting at `off`.
    // Returns `(err, codepoint, sizeBytes)`.
 
 
  fn decode1(b: bytes, off: long) -> int, long, int{
 
 
 
 
 
   if b == null { return 0, 0L, 1}
 
 
 
 
 
   let n = bstd.Bytes.len(b)
 
 
 
 
 
   if off < 0L { return 0, 0L, 1}
 
 
 
 
 
   if off >= n { return 0, 0L, 1}

 
 
 
 
 
   let b0, e0 = bstd.Bytes.getU8(b, off)
 
 
 
 
 
   if e0 != 0 { return 0, 0L, 1}
 
 
 
 
 
   if b0 < 128 { return b0, 1L, 0}

        // 2-byte: 110xxxxx 10xxxxxx (0xC2..0xDF)
 
 
 
 
 
   if b0 >= 194 && b0 <= 223 {
 
 
 
 
 
       if off + 1L >= n { return 0, 0L, 1}
 
 
 
 
 
       let b1, e1 = bstd.Bytes.getU8(b, off + 1L)
 
 
 
 
 
       if e1 != 0 { return 0, 0L, 1}
 
 
 
 
 
       if b1 < 128 || b1 >= 192 { return 0, 0L, 1}
 
 
 
 
 
       let cp: int = (b0 - 192) * 64 + (b1 - 128)
 
 
 
 
 
       return cp, 2L, 0
 
       }

        // 3-byte: 1110xxxx 10xxxxxx 10xxxxxx (0xE0..0xEF)
 
 
 
 
 
   if b0 >= 224 && b0 <= 239 {
 
 
 
 
 
       if off + 2L >= n { return 0, 0L, 1}
 
 
 
 
 
       let b1, e1 = bstd.Bytes.getU8(b, off + 1L)
 
 
 
 
 
       if e1 != 0 { return 0, 0L, 1}
 
 
 
 
 
       let b2, e2 = bstd.Bytes.getU8(b, off + 2L)
 
 
 
 
 
       if e2 != 0 { return 0, 0L, 1}
 
 
 
 
 
       if b1 < 128 || b1 >= 192 { return 0, 0L, 1}
 
 
 
 
 
       if b2 < 128 || b2 >= 192 { return 0, 0L, 1}

            // Reject overlong (E0 80..9F ..) and surrogate (ED A0..BF ..).
 
 
 
 
 
       if b0 == 224 && b1 < 160 { return 0, 0L, 1}
 
 
 
 
 
       if b0 == 237 && b1 >= 160 { return 0, 0L, 1}

 
 
 
 
 
       let cp: int = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)
 
 
 
 
 
       if cp < 2048 { return 0, 0L, 1}
 
 
 
 
 
       if cp >= 55296 && cp <= 57343 { return 0, 0L, 1} // surrogate range
 
 
 
 
 
       return cp, 3L, 0
 
       }

        // 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx (0xF0..0xF4)
 
 
 
 
 
   if b0 >= 240 && b0 <= 244 {
 
 
 
 
 
       if off + 3L >= n { return 0, 0L, 1}
 
 
 
 
 
       let b1, e1 = bstd.Bytes.getU8(b, off + 1L)
 
 
 
 
 
       if e1 != 0 { return 0, 0L, 1}
 
 
 
 
 
       let b2, e2 = bstd.Bytes.getU8(b, off + 2L)
 
 
 
 
 
       if e2 != 0 { return 0, 0L, 1}
 
 
 
 
 
       let b3, e3 = bstd.Bytes.getU8(b, off + 3L)
 
 
 
 
 
       if e3 != 0 { return 0, 0L, 1}
 
 
 
 
 
       if b1 < 128 || b1 >= 192 { return 0, 0L, 1}
 
 
 
 
 
       if b2 < 128 || b2 >= 192 { return 0, 0L, 1}
 
 
 
 
 
       if b3 < 128 || b3 >= 192 { return 0, 0L, 1}

            // Reject overlong (F0 80..8F ..) and out-of-range (F4 90..BF ..).
 
 
 
 
 
       if b0 == 240 && b1 < 144 { return 0, 0L, 1}
 
 
 
 
 
       if b0 == 244 && b1 >= 144 { return 0, 0L, 1}

 
 
 
 
 
       let cp: int = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)
 
 
 
 
 
       if cp < 65536 { return 0, 0L, 1}
 
 
 
 
 
       if cp > 1114111 { return 0, 0L, 1}
 
 
 
 
 
       return cp, 4L, 0
 
       }

 
 
 
 
 
   return 0, 0L, 1
 
   }

 
 
  fn isValid(b: bytes) -> bool {
 
 
 
 
 
   if b == null { return false }
 
 
 
 
 
   let i: long = 0L
 
 
 
 
 
   let n = bstd.Bytes.len(b)
 
 
 
 
 
   while i < n {
 
 
 
 
 
       let cp, sz, e = Utf8.decode1(b, i)
 
 
 
 
        if e != 0 { return false }
 
 
 
 
 
       if sz <= 0L { return false }
            i = i + sz
 
       }
 
 
 
 
 
   return true
 
   }

    // UTF-8 boundary at `off` (0..len). True for 0/len or if byte at off is not a continuation byte.
 
 
  fn isBoundary(b: bytes, off: long) -> bool {
 
 
 
 
 
   if b == null { return false }
 
 
 
 
 
   if off < 0L { return false }
 
 
 
 
 
   let n = bstd.Bytes.len(b)
 
 
 
 
 
   if off == 0L { return true }
 
 
 
 
 
   if off == n { return true }
 
 
 
 
 
   if off > n { return false }
 
 
 
 
 
   let v, e = bstd.Bytes.getU8(b, off)
 
 
 
 
 
   if e != 0 { return false }
 
 
 
 
 
   if v >= 128 && v < 192 { return false }
 
 
 
 
 
   return true
 
   }

    // Clamp `off` to the nearest boundary at-or-before it.
 
 
  fn clampBoundaryBefore(b: bytes, off: long) -> long {
 
 
 
 
 
   if b == null { return 0L }
 
 
 
 
 
   let n = bstd.Bytes.len(b)
 
 
 
 
 
   if off <= 0L { return 0L }
 
 
 
 
 
   if off >= n { return n }
 
 
 
 
 
   let i = off
 
 
 
 
 
   while i > 0L && !Utf8.isBoundary(b, i) {
            i = i - 1L
 
       }
 
 
 
 
 
   return i
 
   }

    // Clamp `off` to the nearest boundary at-or-after it.
 
 
  fn clampBoundaryAfter(b: bytes, off: long) -> long {
 
 
 
 
 
   if b == null { return 0L }
 
 
 
 
 
   let n = bstd.Bytes.len(b)
 
 
 
 
 
   if off <= 0L { return 0L }
 
 
 
 
 
   if off >= n { return n }
 
 
 
 
 
   let i = off
 
 
 
 
 
   while i < n && !Utf8.isBoundary(b, i) {
            i = i + 1L
 
       }
 
 
 
 
 
   return i
 
   }

 
 
  fn encodedLen(cp: int) -> long {
 
 
 
 
 
   if cp < 0 { return 0L }
 
 
 
 
 
   if cp < 128 { return 1L }
 
 
 
 
 
   if cp < 2048 { return 2L }
 
 
 
 
 
   if cp < 65536 { return 3L }
 
 
 
 
 
   if cp <= 1114111 { return 4L }
 
 
 
 
 
   return 0L
 
   }

    // Encode one codepoint at `dst[off..]`. Returns `(err, sizeBytes)`.
 
 
  fn encode1(cp: int, dst: bytes, off: long) -> long, int{
 
 
 
 
 
   if dst == null { return 0L, 1}
 
 
 
 
 
   if off < 0L { return 0L, 1}
 
 
 
 
 
   let cap = bstd.Bytes.len(dst)
 
 
 
 
 
   let need = Utf8.encodedLen(cp)
 
 
 
 
 
   if need <= 0L { return 0L, 1}
 
 
 
 
 
   if off + need > cap { return 0L, 1}
 
 
 
 
 
   if cp >= 55296 && cp <= 57343 { return 0L, 1} // surrogate

 
 
 
 
 
   if need == 1L {
            bstd.Bytes.setU8(dst, off, cp)
 
 
 
 
 
       return 1L, 0
 
       }
 
 
 
 
 
   if need == 2L {
 
 
 
 
 
       let b0: int = 192 + (cp / 64)
 
 
 
 
 
       let b1: int = 128 + _imod(cp, 64)
            bstd.Bytes.setU8(dst, off, b0)
            bstd.Bytes.setU8(dst, off + 1L, b1)
 
 
 
 
 
       return 2L, 0
 
       }
 
 
 
 
 
   if need == 3L {
 
 
 
 
 
       let b0: int = 224 + (cp / 4096)
 
 
 
 
 
       let b1: int = 128 + _imod(cp / 64, 64)
 
 
 
 
 
       let b2: int = 128 + _imod(cp, 64)
            bstd.Bytes.setU8(dst, off, b0)
            bstd.Bytes.setU8(dst, off + 1L, b1)
            bstd.Bytes.setU8(dst, off + 2L, b2)
 
 
 
 
 
       return 3L, 0
 
       }
        // need == 4
 
 
 
 
 
   let b0: int = 240 + (cp / 262144)
 
 
 
 
 
   let b1: int = 128 + _imod(cp / 4096, 64)
 
 
 
 
 
   let b2: int = 128 + _imod(cp / 64, 64)
 
 
 
 
 
   let b3: int = 128 + _imod(cp, 64)
        bstd.Bytes.setU8(dst, off, b0)
        bstd.Bytes.setU8(dst, off + 1L, b1)
        bstd.Bytes.setU8(dst, off + 2L, b2)
        bstd.Bytes.setU8(dst, off + 3L, b3)
 
 
 
 
 
   return 4L, 0
 
   }

    // Convert possibly-invalid UTF-8 bytes into a valid UTF-8 `string` by replacing invalid sequences with U+FFFD.
 
 
  fn lossyString(s: string) -> string {
 
 
 
 
 
   if s == null { return null }
 
 
 
 
 
   let src: bytes = bstd.Bytes.fromString(s)
 
 
 
 
 
   if Utf8.isValid(src) { return s }

 
 
 
 
 
   let n: long = bstd.Bytes.len(src)
 
 
 
 
 
   let dst: bytes = bstd.Bytes.newLong(n * 3L)
 
 
 
 
 
   let di: long = 0L
 
 
 
 
 
   let i: long = 0L
 
 
 
 
 
   while i < n {
 
 
 
 
 
       let _cp, sz, e = Utf8.decode1(src, i)
 
 
 
 
        if e == 0 {
 
 
 
 
 
           let _ = bstd.Bytes.copy(dst, di, src, i, sz)
                di = di + sz
                i = i + sz
 
 
 
 
 
           continue
 
           }
            // U+FFFD (replacement character) => EF BF BD
 
 
 
 
 
       let wrote, ee = Utf8.encode1(65533, dst, di)
 
 
 
 
        if ee != 0 || wrote != 3L {
                // Fallback to ASCII '?' if encoding fails for any reason.
                bstd.Bytes.setU8(dst, di, 63)
                di = di + 1L
                i = i + 1L
 
 
 
 
 
           continue
 
           }
            di = di + wrote
            i = i + 1L
 
       }
 
 
 
 
 
   return tua_str_from_bytes_copy(dst, 0L, di)
 
   }
}
