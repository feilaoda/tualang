import "std/rt" as rt

extern fn tua_bytes_new(len: long) -> bytes
extern fn tua_bytes_new_uninit(len: long) -> bytes
extern fn tua_bytes_from_string_copy(s: string) -> bytes
extern fn tua_bytes_mmap_file(path: string, outBytes: &bytes) int
extern fn tua_bytes_len(b: bytes) long
extern fn tua_bytes_get_u8(b: bytes, idx: long, out: &int) int
extern fn tua_bytes_set_u8(b: bytes, idx: long, v: int) int
extern fn tua_bytes_copy(dst: bytes, dstOff: long, src: bytes, srcOff: long, n: long) int
extern fn tua_bytes_is_readonly(b: bytes) int
extern fn tua_panic(msg: string)

impl bytes {
 
 
  fn len() long {
 
 
 
 
 
   return tua_bytes_len(this)
 
   }

 
 
  fn isReadonly() int {
 
 
 
 
 
   return tua_bytes_is_readonly(this)
 
   }

 
 
  fn getU8(idx: long) -> byte {
 
 
 
 
 
   let out: int = 0
 
 
 
 
 
   let err = tua_bytes_get_u8(this, idx, &out)
 
 
 
 
 
   if err != 0 {
            tua_panic("bytes.get out of bounds or null")
 
 
 
 
 
       return (byte)0
 
       }
 
 
 
 
 
   return (byte)out
 
   }

 
 
  fn get(idx: long) -> byte {
 
 
 
 
 
   return this.getU8(idx)
 
   }

 
 
  fn setU8(idx: long, v: int) int {
 
 
 
 
 
   return tua_bytes_set_u8(this, idx, v)
 
   }

 
 
  fn set(idx: long, v: int) int {
 
 
 
 
 
   return this.setU8(idx, v)
 
   }

 
 
  fn copy(dstOff: long, src: bytes, srcOff: long, n: long) int {
 
 
 
 
 
   return tua_bytes_copy(this, dstOff, src, srcOff, n)
 
   }
}

object Bytes {
 
 
  fn new(len: int) -> bytes {
 
 
 
 
 
   let n: long = len
 
 
 
 
 
   return tua_bytes_new(n)
 
   }

 
 
  fn newLong(len: long) -> bytes {
 
 
 
 
 
   return tua_bytes_new(len)
 
   }

 
 
  fn newLongUninit(len: long) -> bytes {
 
 
 
 
 
   return tua_bytes_new_uninit(len)
 
   }

 
 
  fn fromString(s: string) -> bytes {
 
 
 
 
 
   return tua_bytes_from_string_copy(s)
 
   }

 
 
  fn mmapFile(path: string) -> bytes, int{
 
 
 
 
 
   let b: bytes = null
 
 
 
 
 
   let err = tua_bytes_mmap_file(path, &b)
 
 
 
 
 
   return b, err
 
   }

 
 
  fn len(b: bytes) long {
 
 
 
 
 
   return tua_bytes_len(b)
 
   }

 
 
  fn isReadonly(b: bytes) int {
 
 
 
 
 
   return tua_bytes_is_readonly(b)
 
   }

    // Go-style multi-return: value first, error code last.
 
 
  fn getU8(b: bytes, idx: long) -> int, int {
 
 
 
 
 
   let out: int = 0
 
 
 
 
 
   let err = tua_bytes_get_u8(b, idx, &out)
 
 
 
 
 
   return out, err
 
   }

 
 
  fn setU8(b: bytes, idx: long, v: int) int {
 
 
 
 
 
   return tua_bytes_set_u8(b, idx, v)
 
   }

 
 
  fn copy(dst: bytes, dstOff: long, src: bytes, srcOff: long, n: long) int {
 
 
 
 
 
   return tua_bytes_copy(dst, dstOff, src, srcOff, n)
 
   }

    // ====================
    // Binary reads (LE)
    // ====================

 
 
  fn readU16LE(b: bytes, off: long) -> u16, int{
 
 
 
 
 
   let v0, e0 = Bytes.getU8(b, off)
 
 
 
 
 
   if e0 != 0 { return (u16)0, e0}
 
 
 
 
 
   let v1, e1 = Bytes.getU8(b, off + 1L)
 
 
 
 
 
   if e1 != 0 { return (u16)0, e1}
 
 
 
 
 
   let r: int = ((int)v0) + (((int)v1) * 256)
 
 
 
 
 
   return (u16)r, 0
 
   }

 
 
  fn readU32LE(b: bytes, off: long) -> u32, int{
 
 
 
 
 
   let v0, e0 = Bytes.getU8(b, off)
 
 
 
 
 
   if e0 != 0 { return (u32)0, e0}
 
 
 
 
 
   let v1, e1 = Bytes.getU8(b, off + 1L)
 
 
 
 
 
   if e1 != 0 { return (u32)0, e1}
 
 
 
 
 
   let v2, e2 = Bytes.getU8(b, off + 2L)
 
 
 
 
 
   if e2 != 0 { return (u32)0, e2}
 
 
 
 
 
   let v3, e3 = Bytes.getU8(b, off + 3L)
 
 
 
 
 
   if e3 != 0 { return (u32)0, e3}

 
 
 
 
 
   let r: long = ((long)v0)
        r = r + (((long)v1) * 256L)
        r = r + (((long)v2) * 65536L)
        r = r + (((long)v3) * 16777216L)
 
 
 
 
 
   return (u32)r, 0
 
   }

 
 
  fn readU64LE(b: bytes, off: long) -> u64, int{
 
 
 
 
 
   let v0, e0 = Bytes.getU8(b, off)
 
 
 
 
 
   if e0 != 0 { return (u64)0, e0}
 
 
 
 
 
   let v1, e1 = Bytes.getU8(b, off + 1L)
 
 
 
 
 
   if e1 != 0 { return (u64)0, e1}
 
 
 
 
 
   let v2, e2 = Bytes.getU8(b, off + 2L)
 
 
 
 
 
   if e2 != 0 { return (u64)0, e2}
 
 
 
 
 
   let v3, e3 = Bytes.getU8(b, off + 3L)
 
 
 
 
 
   if e3 != 0 { return (u64)0, e3}
 
 
 
 
 
   let v4, e4 = Bytes.getU8(b, off + 4L)
 
 
 
 
 
   if e4 != 0 { return (u64)0, e4}
 
 
 
 
 
   let v5, e5 = Bytes.getU8(b, off + 5L)
 
 
 
 
 
   if e5 != 0 { return (u64)0, e5}
 
 
 
 
 
   let v6, e6 = Bytes.getU8(b, off + 6L)
 
 
 
 
 
   if e6 != 0 { return (u64)0, e6}
 
 
 
 
 
   let v7, e7 = Bytes.getU8(b, off + 7L)
 
 
 
 
 
   if e7 != 0 { return (u64)0, e7}

 
 
 
 
 
   let r: long = ((long)v0)
        r = r + (((long)v1) * 256L)
        r = r + (((long)v2) * 65536L)
        r = r + (((long)v3) * 16777216L)
        r = r + (((long)v4) * 4294967296L)
        r = r + (((long)v5) * 1099511627776L)
        r = r + (((long)v6) * 281474976710656L)
        r = r + (((long)v7) * 72057594037927936L)
 
 
 
 
 
   return (u64)r, 0
 
   }

 
 
  fn readI16LE(b: bytes, off: long) -> i16, int{
 
 
 
 
 
   let u, e = Bytes.readU16LE(b, off)
 
 
 
 
    if e != 0 { return (i16)0, e}
 
 
 
 
 
   return (i16)u, 0
 
   }

 
 
  fn readI32LE(b: bytes, off: long) -> int, int {
 
 
 
 
 
   let u, e = Bytes.readU32LE(b, off)
 
 
 
 
    if e != 0 { return 0, e}
 
 
 
 
 
   return (int)u, 0
 
  }

 
 
  fn readI64LE(b: bytes, off: long) -> long, int{
 
 
 
 
 
   let u, e = Bytes.readU64LE(b, off)
 
 
 
 
    if e != 0 { return 0L, e}
 
 
 
 
 
   return (long)u, 0
 
   }
}
