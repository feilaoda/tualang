// Small convenience methods for primitive scalars.

import "std/bytes" as bstd
import "std/utf8" as utf8

extern fn tua_str_len(s: string) int
extern fn tua_str_byte_len(s: string) long
extern fn tua_str_substring(s: string, i: int) string
extern fn tua_bytes_from_string_view(s: string) bytes
extern fn tua_str_to_bytes_encoding(s: string, encoding: string, out: &bytes) int
extern fn tua_str_from_bytes_encoding(b: bytes, encoding: string, out: &string) int

impl int {
  fn abs() int {
    if this < 0 { return -this }
    return this
  }
}

impl long {
  fn abs() long {
    if this < 0L { return -this }
    return this
  }
}

impl string {
  fn isEmpty() bool {
    return this == ""
  }

  fn len() int {
    return tua_str_len(this)
  }

  fn byteLen() long {
    return tua_str_byte_len(this)
  }

  fn substring(i: int) string {
    return tua_str_substring(this, i)
  }

  // Read-only UTF-8 bytes view (no copy).
  fn asBytes() -> bytes {
    return tua_bytes_from_string_view(this)
  }

  // UTF-8 bytes copy.
  fn toBytes() -> bytes {
    if this == null { return null }
    // Return via a local to avoid dropping temporaries (bytes are non-refcounted).
    let out: bytes = bstd.Bytes.fromString(this)
    return out
  }

  // Encode to bytes with the given encoding name (case-insensitive).
  // Supported: "UTF-8", "GBK". Unsupported encodings return TUA_E_NOTSUP.
  fn toBytesEnc(encoding: string) -> bytes, int {
    let out: bytes = null
    let err = tua_str_to_bytes_encoding(this, encoding, &out)
    return out, err
  }

  // Unicode codepoints (best-effort): invalid UTF-8 sequences are replaced with U+FFFD.
  fn toIntArray() -> int[] {
    if this == null { return null }
    let src: bytes = bstd.Bytes.fromString(this)
    let out: int[] = {}
    if src == null { return out }
    let n: long = bstd.Bytes.len(src)
    let i: long = 0L
    while i < n {
      let cp, sz, e = utf8.Utf8.decode1(src, i)
      if e == 0 && sz > 0L {
        out.push(cp)
        i = i + sz
        continue
      }
      out.push(65533) // U+FFFD
      i = i + 1L
    }
    return out
  }

  // Unicode codepoints widened to long (best-effort): invalid UTF-8 sequences are replaced with U+FFFD.
  fn toLongArray() -> long[] {
    if this == null { return null }
    let src: bytes = bstd.Bytes.fromString(this)
    let out: long[] = {}
    if src == null { return out }
    let n: long = bstd.Bytes.len(src)
    let i: long = 0L
    while i < n {
      let cp, sz, e = utf8.Utf8.decode1(src, i)
      if e == 0 && sz > 0L {
        out.push((long)cp)
        i = i + sz
        continue
      }
      out.push(65533L) // U+FFFD
      i = i + 1L
    }
    return out
  }
}

object String {
  // Decode bytes to string with the given encoding name (case-insensitive).
  // Supported: "UTF-8", "GBK". Unsupported encodings return TUA_E_NOTSUP.
  // Invalid sequences decode to U+FFFD (not an error).
  fn fromBytes(b: bytes, encoding: string) -> string, int {
    let out: string = null
    let err = tua_str_from_bytes_encoding(b, encoding, &out)
    return out, err
  }
}

impl bool {
  fn not2() bool {
    return !this
  }
}
