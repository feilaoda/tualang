import "std/rt" as rt

extern fn tua_io_readline_alloc(outData: &string, outLen: &int) int

object Stdin {
    // Reads one line from stdin. On EOF: returns (0, null, 0).
    // Caller must free returned string via `rt.Rt.free`.
    fn readLine() -> int, string, int {
        let s: string = null
        let n: int = 0
        let e = tua_io_readline_alloc(&s, &n)
        return e, s, n
    }
}

