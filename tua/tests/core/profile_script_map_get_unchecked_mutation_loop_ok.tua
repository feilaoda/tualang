fn main() {

  let m: map<int, int> = {}

  for i = 0; i < 2048; i++ {
    m[i] = i + 1
  }

  let acc: long = 0L

  for i = 0; i < 2048; i++ {
    acc = acc + (long)m.getUnchecked(i)
    // Structural growth in-loop: compiler must not cache stale IMAP internals.
    m[i + 4096] = i
  }

  assert(acc == 2098176L)
}
