import "std/strconv" as strconv

fn main() {
 
 
  let o1 = strconv.Float.parse("0.7")
    assert(o1.isSome())
 
 
  let v1: float = o1.unwrap()
    assert(v1 > 0.69)
    assert(v1 < 0.71)

 
 
  let o2 = strconv.Float.parse(" -1.25 ")
    assert(o2.isSome())
 
 
  let v2: float = o2.unwrap()
    assert(v2 > -1.26)
    assert(v2 < -1.24)

    assert(strconv.Float.parse("").isNone())
    assert(strconv.Float.parse("x").isNone())
}

