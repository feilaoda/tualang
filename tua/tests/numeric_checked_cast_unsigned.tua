fn main() {

  let big: u32 = (u32)4294967295L

  let o1: Option<u8> = big as u8
  assert(o1.isNone())

  let o2: Option<u8> = (-1) as u8
  assert(o2.isNone())

  let o3: Option<int> = big as int
  assert(o3.isNone())

  let ok: Option<u8> = (u32)255L as u8
  assert(ok.isSome())
  assert(ok.unwrap() == 255)
}
