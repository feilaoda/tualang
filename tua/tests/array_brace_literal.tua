fn main() {
 
 
  let a:int[3] = {7}
    assert(a[0] == 7)
    assert(a[2] == 7)

 
 
  let b:int[5] = {10, 20}
    assert(b[0] == 10)
    assert(b[1] == 20)
    assert(b[4] == 0)

 
 
  let c:int[] = {1, 2, 3}
    assert(c.len() == 3)
    assert(c[2] == 3)

 
 
  let d:int[] = {}
    assert(d.len() == 0)
    d.push(1)
    assert(d.len() == 1)
 
 
  let m:map = {}
    assert(m.len() == 0)

 
 
  let m2 = {"a": 1}
    assert(m2["a"].unwrap() == 1)
}
