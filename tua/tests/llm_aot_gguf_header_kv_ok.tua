// tuac: -L build/clib -l tuallm

import "std/bytes" as bstd
import "../packages/llm/gguf" as g

private fn _lmod(a: long, b: long) -> long {

  return a - (a / b) * b
}

private fn _wU32LE(b: bytes, off: long, v: long) {
  bstd.Bytes.setU8(b, off + 0L, (int)_lmod(v, 256L))
  bstd.Bytes.setU8(b, off + 1L, (int)_lmod(v / 256L, 256L))
  bstd.Bytes.setU8(b, off + 2L, (int)_lmod(v / 65536L, 256L))
  bstd.Bytes.setU8(b, off + 3L, (int)_lmod(v / 16777216L, 256L))
}

private fn _wU64LE(b: bytes, off: long, v: long) {

  let x = v

  let i: long = 0L

  while i < 8L {
    bstd.Bytes.setU8(b, off + i, (int)_lmod(x, 256L))
    x = x / 256L
    i = i + 1L

  }
}

private fn _wStr(b: bytes, off: long, s: string) long {

  let bs = bstd.Bytes.fromString(s)

  let n = bstd.Bytes.len(bs)
  _wU64LE(b, off, n)
  bstd.Bytes.copy(b, off + 8L, bs, 0L, n)

  return 8L + n
}

// Build a minimal GGUF buffer:
// - 2 kv entries: one STRING and one UINT32
// Magic "GGUF"

// kv1: "general.architecture" = "llama"

// kv2: "llama.context_length" = 2048 (UINT32)

fn main() {

  let buf = bstd.Bytes.new(105)
  bstd.Bytes.setU8(buf, 0L, 71)
  bstd.Bytes.setU8(buf, 1L, 71)
  bstd.Bytes.setU8(buf, 2L, 85)
  bstd.Bytes.setU8(buf, 3L, 70)
  _wU32LE(buf, 4L, 2L)   // version
  _wU64LE(buf, 8L, 0L)   // n_tensors
  _wU64LE(buf, 16L, 2L)  // n_kv

  let at: long = 24L
  at = at + _wStr(buf, at, "general.architecture")
  _wU32LE(buf, at, 8L) // gguf_value_type: STRING
  at = at + 4L
  at = at + _wStr(buf, at, "llama")
  at = at + _wStr(buf, at, "llama.context_length")
  _wU32LE(buf, at, 4L) // gguf_value_type: UINT32
  at = at + 4L
  _wU32LE(buf, at, 2048L)
  at = at + 4L
  assert(at == 105L)

  let f, e = g.Gguf.parseBytes(move buf, 0)
  assert(e == 0)
  assert(f.version == 2)
  assert(f.tensorCount == 0L)
  assert(f.arch == "llama")
  assert(f.ctxLen == 2048)
}
