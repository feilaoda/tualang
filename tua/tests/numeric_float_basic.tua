



fn main() {
    let a:float = 1.5
    let b:float = a + 2
    assert(b > 3.4)
    assert(b < 3.6)
    let d:double = b + 0.25
    assert(d > 3.7)
    assert(d < 3.8)
    let arr:float[] = {1.0, 2.0, 3.0}
    assert(arr.len() == 3)
    assert(arr[0] > 0.9)
    assert(arr[2] < 3.1)
    println(b)
}
