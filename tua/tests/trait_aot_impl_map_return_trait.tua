trait HasId { fn id() -> int }

struct Base { id: int }
impl Base { fn id() -> int { return id } }

struct Girl { ...Base, extra2: int }
struct Boy  { ...Base, extra3: int }

impl HasId for Girl {}
impl HasId for Boy {}




fn whos(t: string) -> HasId {
if t == "girl" {
  return Girl{ base: Base{ id: 5 }, extra2: 2 }
}
return Boy{ base: Base{ id: 6 }, extra3: 3 }
}




fn main() {
    let p: HasId = whos("girl")
    assert(p.id() == 5)
    let p2: HasId = whos("boy")
    assert(p2.id() == 6)
}
