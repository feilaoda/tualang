

// Unsigned comparisons must treat 0xFF as 255, not -1.

// Unsigned division must treat 0xFF / 2 as 127.

fn main() {
 
 
  let a: u8 = (u8)255
 
 
  let b: u8 = (u8)1
 
 
  let s: u32 = a + b
    assert(s == (u32)256)
    assert(a > (u8)0)
 
 
  let d: u32 = a / (u8)2
    assert(d == (u32)127)
 
 
  let c: u16 = (u16)65535
 
 
  let e: u32 = c + (u16)1
    assert(e == (u32)65536)
}
