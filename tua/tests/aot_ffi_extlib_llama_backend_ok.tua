// tuac: -L build/clib -l tuaextllama -L /usr/local/opt/llama.cpp/lib --link-arg=-Wl,-rpath,/usr/local/opt/llama.cpp/lib -l llama

extern fn tuaext_llama_backend_init()
extern fn tuaext_llama_time_us() long

fn main(args: string[]) -> int {
    tuaext_llama_backend_init()
    let t = tuaext_llama_time_us()
    assert(t > 0L)
    return 0
}
