import BpeTokenizer from "../packages/llm/tokenizer_bpe"

fn main() {
    let e, tok = BpeTokenizer.loadFromTokenizerJson("tests/fixtures/tokenizer_small.json")
    assert(e == 0)

    let ae, sid = BpeTokenizer.addedId(tok, "<s>")
    assert(ae == 0)
    assert(sid == 3L)

    let ee, ids0 = BpeTokenizer.encode(tok, "ab")
    assert(ee == 0)
    let ids: long[] = ids0
    assert(ids.len() == 1)
    assert(ids[0] == 2L)

    let de, out = BpeTokenizer.decode(tok, ids)
    assert(de == 0)
    assert(out == "ab")
}
