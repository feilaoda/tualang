  trait HasId { fn id() -> int }

  struct Base { id: int }
  impl Base { fn id() -> int { return id } }

  struct Girl { ...Base, extra2: int }
  struct Boy  { ...Base, extra3: int }

  impl HasId for Girl {}
  impl HasId for Boy {}


let users:map<string, HasId> = {
    "girl": Girl{ base: Base{ id: 5 }, extra2: 2 },
    "boy": Boy{ base: Base{ id: 6 }, extra3: 3 }
  }

let g = users.get("girl").unwrap()
println(g.id())
let b = users.get("boy").unwrap()
assert(g.id() == 5)
assert(b.id() == 6)


let a = users.get("girl1")
println(a.isSome())

  
