// tuac: -L build/clib -l tuallm

import "../packages/llm/options" as o

fn main() {
    let a0: string[] = {"prog"}
    let e0, opt0 = o.LlmArgs.parseArgv(a0)
    assert(e0 == 0)
    assert(opt0.weightsDtype == 0)
    assert(opt0.kvDtype == 0)

    let a1: string[] = {"prog", "--w-bf16"}
    let e1, opt1 = o.LlmArgs.parseArgv(a1)
    assert(e1 == 0)
    assert(opt1.weightsDtype == 1)

    let a2: string[] = {"prog", "--w-fp16"}
    let e2, opt2 = o.LlmArgs.parseArgv(a2)
    assert(e2 == 0)
    assert(opt2.weightsDtype == 2)

    let a3: string[] = {"prog", "--w-f32"}
    let e3, opt3 = o.LlmArgs.parseArgv(a3)
    assert(e3 == 0)
    assert(opt3.weightsDtype == 0)

    let a4: string[] = {"prog", "--kv-bf16"}
    let e4, opt4 = o.LlmArgs.parseArgv(a4)
    assert(e4 == 0)
    assert(opt4.kvDtype == 1)
}
