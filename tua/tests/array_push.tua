


//b.push(4)
//assert(b.len() == 4)

fn main() {
    let s2:string[] = {}
    assert(s2.len() == 0)
    s2.push("?")
    assert(s2.len() == 1)
    assert(s2[0] == "?")
    let a:int[] = {}
    a.push(1)
    a.push(2)
    assert(a.len() == 2)
    assert(a[0] == 1)
    assert(a[1] == 2)
    a[0] = 10
    assert(a[0] == 10)
    let b:int[3] = {1, 2, 3}
    assert(b.len() == 3)
    assert(b[0] == 1)
}
