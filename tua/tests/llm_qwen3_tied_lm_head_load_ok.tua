import "../packages/llm/qwen3" as q
import LlmArgs, LlmOptions from "../packages/llm/options"

fn main() {
    let opt0: LlmOptions = LlmArgs.defaults()
    let opt: LlmOptions = opt0
    opt.kvMaxSeq = 8
    let e, st = q.Qwen3.loadState("tests/fixtures/qwen3_tied_lm", opt)
    assert(e == 0)
    // `lm_head.weight` is missing in this fixture and must be tied to embeddings.
    assert(st.wOffLmHead == st.wOffEmbed)
}
