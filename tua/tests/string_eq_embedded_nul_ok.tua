import "std/bytes" as bstd

extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string

fn main() {
  let b: bytes = bstd.Bytes.new(3)
  let _ = b.setU8(0L, 65) // 'A'
  let _ = b.setU8(1L, 0)  // '\0'
  let _ = b.setU8(2L, 66) // 'B'

  let s1: string = tua_str_from_bytes_copy(b, 0L, 3L)
  let s2: string = tua_str_from_bytes_copy(b, 0L, 3L)

  assert(s1 == s2)
  assert(s1 != "A")

  let a: string = s1
  let c: string = a
  assert(a == c)
}

