import "std/bytes" as bstd
import "std/fs" as fs
import "json" as json
import "std/rt" as rt

fn main() {
    let fe, data, _ = fs.Fs.readFile("tests/fixtures/json_key_path_string.json")
    assert(fe == 0)
    assert(data != null)
    let b = bstd.Bytes.fromString(data)
    rt.Rt.free(data)

    let e1, v1 = json.Json.scanKeyPathString(b, "a.b.c")
    assert(e1 == 0)
    assert(v1 == "ok")

    let e2, v2 = json.Json.scanKeyPathString(b, "a.b.z")
    assert(e2 == 2)
    assert(v2 == null)

    let e3, v3 = json.Json.scanKeyPathString(b, "d.x")
    assert(e3 == 1)
    assert(v3 == null)
}
