


struct S {
    a: int
    b: int
}


fn main() {
 
 
  let m: map = { "a": 1, "b": 2, 3: 4 }
 
 
  let sum = 0
 
 
  for k,v in m {
 
 
 
 
 
   let vi:int = v
        sum = sum + vi
 
   }
    assert(sum == 7)
 
 
  let m2: map<string,S> = { "a": S{a:1,b:2}, "b": S{a:3,b:4} }
 
 
  for k2,v2 in m2 {
 
 
 
 
 
   const s: S = v2.get()
        v2.b = s.b + 1
 
   }
 
 
  const a = m2.get("a").unwrap().get()
 
 
  const b = m2.get("b").unwrap().get()
    assert(a.b == 3)
    assert(b.b == 5)
}
