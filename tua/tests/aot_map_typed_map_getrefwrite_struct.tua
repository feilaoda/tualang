struct S {
  a: int
  b: int
}

let m: map<string, S> = { "x": S{ a: 1, b: 2 } }
{
  let r1 = m.getRef("x").unwrap()
  assert(r1.a == 1)
  assert(r1.b == 2)
}

{
let r = m.getRefWrite("x").unwrap()
r.a = 10
r.b = 20
}


let r2 = m.getRef("x").unwrap()
assert(r2.a == 10)
assert(r2.b == 20)
//r.a = 100
//assert(r.a == 100)