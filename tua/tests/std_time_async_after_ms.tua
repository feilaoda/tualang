import "std/rt" as rt
import "std/time/async" as time

fn main() {
 
 
  let loop = rt.Rt.loopCreate()
    assert(loop != null)

 
 
  let fired = 0
 
 
  let err = time.TimeAsync.afterMs(loop, 1, fn() {
        fired = 1
        rt.Rt.loopStop(loop)
 
   })
    assert(err == 0)

 
 
  let rc = rt.Rt.loopRun(loop)
    assert(rc == 0)
    assert(fired == 1)

    rt.Rt.loopFree(loop)
}

