trait HasId {
  fn id() -> int
}

struct S {
  id: int
}

impl S {
  fn id() -> int {
    return 1
  }
}

impl HasId for S {
  fn id() -> int {
    return 2
  }
}

fn getId<T: HasId>(x: T) -> int {
  return x.id()
}


fn main() {
    let s: S = S{id: 10}
    assert(s.id() == 1)
    assert(getId<S>(s) == 2)
}
