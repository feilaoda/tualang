
impl<T> Option<T> {
 
 
  fn isSome2() bool {
 
 
 
 
 
   if let Some(x) = this {
 
 
 
 
 
       return true
 
       }
 
 
 
 
 
   return false
 
   }

 
 
  fn unwrapOr2(def: T) -> T {
 
 
 
 
 
   if let Some(x) = this {
 
 
 
 
 
       return x
 
       }
 
 
 
 
 
   return def
 
   }
}

fn main() {
 
 
  let o: Option<int> = Some(1)
    assert(o.isSome2())
    assert(Some(1).isSome2())
    assert(o.unwrapOr2(0) == 1)
    assert(None().unwrapOr2(7) == 7)
}
