import "std/bytes" as bstd



// mmap bytes are read-only

fn main() {
    let err, b = bstd.Bytes.mmapFile("README.md")
    assert(err == 0)
    assert(b != null)
    assert(bstd.Bytes.len(b) > 0L)
    let e0, v0 = bstd.Bytes.getU8(b, 0L)
    assert(e0 == 0)
    assert(v0 == 35) // '#'
    let we = bstd.Bytes.setU8(b, 0L, 36) // '$'
    assert(we != 0)
}
