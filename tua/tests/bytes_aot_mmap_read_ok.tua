import "std/bytes" as bstd



// mmap bytes are read-only

fn main() {
 
 
  let b, err = bstd.Bytes.mmapFile("README.md")
    assert(err == 0)
    assert(b != null)
    assert(bstd.Bytes.len(b) > 0L)
 
 
  let v0, e0 = bstd.Bytes.getU8(b, 0L)
    assert(e0 == 0)
    assert(v0 == 35) // '#'
 
 
  let we = bstd.Bytes.setU8(b, 0L, 36) // '$'
    assert(we != 0)
}
