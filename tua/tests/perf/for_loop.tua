import "std/strconv"

fn loop(u:int, r:int, t:int) -> int {

  let a:int[100000] = {1}

  let res = 0

  for let i=0; i<t; i++ {

    let acc = a[i]

    for let j=0; j<t; j++ {
      acc = acc + j / u

    }
    a[i] = acc + r
    res = res + acc

  }

  return res
}

fn main(args: string[]) int {
  // Use `tuac file.tua u r times`; defaults are stable for CI/bench runs.

  let u: int = 10

  let r: int = 10

  let times: int = 100

  if args.len() > 1 { u = Int.parse(args[1]) ?? 10 }

  if args.len() > 2 { r = Int.parse(args[2]) ?? 10 }

  if args.len() > 3 { times = Int.parse(args[3]) ?? 100 }
  println(loop(u, r, times))

  return 0
}
