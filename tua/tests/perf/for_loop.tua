import "std/strconv"

fn loop(u:int, r:int, t:int) int {
    let a:int[100000] = {1}
    let res = 0
    for let i=0; i<t; i++ {
      let acc = a[i]
      for let j=0; j<t; j++ {
          acc = acc + j / u
      }
      a[i] = acc + r
      res = res + acc
    }
    return res
}

let u:int = Int.parse(ARGV[1]) ?? 10
let r:int = Int.parse(ARGV[2]) ?? 10
let times = Int.parse(ARGV[3]) ?? 100
println(loop(u,10,times))

