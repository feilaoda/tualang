// tuac: -L build/clib -l tuallm

import "../packages/llm/options" as o

fn main(args: string[]) -> int {

  let opt, e = o.LlmArgs.parseArgv(args)
  assert(e == 0)
  assert(opt.threads == 0)
  assert(opt.weightsDtype == 0)
  assert(opt.kvDtype == 0)
  assert(opt.kvMaxBytes == 0L)
  assert(opt.maxNewTokens == 1)
  assert(opt.topK == 20)
  assert(opt.topP > 0.79)
  assert(opt.topP < 0.81)
  assert(opt.temperature > 0.69)
  assert(opt.temperature < 0.71)
  assert(opt.repeatPenalty > 1.09)
  assert(opt.repeatPenalty < 1.11)
  assert(opt.repeatLastN == 64)
  assert(opt.noRepeatNgram == 3)
  assert(opt.seed == 0L)
  assert(opt.chat == 1)
  assert(opt.enableThinking == 1)
  assert(opt.profile == 0)

  return 0
}
