import "std/bytes" as bstd
import "std/utf8" as u

extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string

fn main() {
    // Invalid leading byte 0xFF.
    let inv = bstd.Bytes.new(1)
    bstd.Bytes.setU8(inv, 0L, 255)
    assert(!u.Utf8.isValid(inv))

    let s = tua_str_from_bytes_copy(inv, 0L, 1L)
    let s2 = u.Utf8.lossyString(s)
    let b2 = bstd.Bytes.fromString(s2)
    assert(u.Utf8.isValid(b2))
    assert(bstd.Bytes.len(b2) == 3L)
    let c0, e0 = bstd.Bytes.getU8(b2, 0L)
    let c1, e1 = bstd.Bytes.getU8(b2, 1L)
    let c2, e2 = bstd.Bytes.getU8(b2, 2L)
    assert(e0 == 0 && e1 == 0 && e2 == 0)
    assert(c0 == 239 && c1 == 191 && c2 == 189) // U+FFFD => EF BF BD
}
