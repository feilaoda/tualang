struct S {
  a: int
  b: int
}



fn main() {
 
 
  let m: map<string, S> = { "x": S{ a: 1, b: 2 } }
 
 
  if let Some(r) = m.getMut("x") {
      r.a = 10
      r.b = 20
 
   }
 
 
  if let Some(r2) = m.get("x") {
 
 
 
 
  const s: S = r2.get()
      assert(s.a == 10)
      assert(s.b == 20)
 
   } else {
      assert(false)
 
   }
}
