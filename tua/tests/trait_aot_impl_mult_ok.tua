  trait HasId { fn id() -> int }

  struct Base { id: int }
  impl Base { fn id() -> int { return id } }

  struct Girl { ...Base as b, extra2: int }
  struct Boy  { ...Base, extra3: int }
struct None { ...Base as b }
  impl HasId for Girl {}
  impl HasId for Boy {}
  impl HasId for None {}

  fn whos(t: string) -> HasId {
 
 
  if t == "girl" {
 
 
 
 
  return Girl{ b: Base{ id: 5 }, extra2: 2 }
 
   } else if t == "boy" {
 
 
 
 
  return Boy{ base: Base{ id: 6 }, extra3: 3 }
 
   } else {
 
 
 
 
  return None{ b: Base{ id: 7 } }
 
   }
  }


fn main() {
 
 
 
 
  let p: HasId = whos("girl1")
      println(p.id())
}
