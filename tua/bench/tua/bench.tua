import "std/time" as t
import "std/bytes" as bstd
import "std/fs" as fs
import "std/rt" as rt
import "std/strconv" as conv
//import "json" as json

extern fn tua_iimap_new(cap_pow2: int) -> ptr
extern fn tua_iimap_free(h: ptr)
extern fn tua_iimap_set(h: ptr, key: int, value: int)
extern fn tua_iimap_get_present(h: ptr, key: int) -> int

struct Foo {
  a: int
}

private fn parseIntArg(s: string, def: int) -> int {

  let o = conv.Int.parse(s)

  if o.isNone() { return def }

  return o.unwrap()
}

private fn nowNs() -> long { return t.Time.monoNs() }

private fn report(name: string, iters: long, dtNs: long, sink: long) {

  let nsPerIter: double = (double)dtNs / (double)iters
  println("{} iters={} dt_ns={} ns/iter={} sink={}", name, iters, dtNs, nsPerIter, sink)
}

private fn benchArithInt(iters: long) -> long {

  let x: long = 1L

  let acc: long = 0L

  for i = 0L; i < iters; i++ {
    x = (x * 1664525L) + 1013904223L
    acc = acc + (x & 65535L)

  }

  return acc
}

private fn makeFloatArray(n: int, seed: float) -> float[] {

  let a: float[] = {}

  for i = 0; i < n; i++ {
    a.push(((float)i * 0.001) + seed)

  }

  return a
}

private fn benchDotF32(iters: int, a: float[], b: float[]) -> double {

  let sum: double = 0.0

  let n: int = a.len()

  for k = 0; k < iters; k++ {

    let s: double = 0.0

    for i = 0; i < n; i++ {
      s = s + ((double)a[i]) * ((double)b[i])

    }
    sum = sum + s

  }

  return sum
}

private fn makeBytes(n: long) -> bytes {

  let b = bstd.Bytes.newLongUninit(n)
  // Deterministic fill; done outside timed loops.

  for i = 0L; i < n; i++ {

    let v: int = (int)((i * 131L + 7L) & 255L)
    bstd.Bytes.setU8(b, i, v)

  }

  return b
}

private fn benchBytesScan(iters: int, b: bytes, needle: int) -> long {

  let n: long = b.len()

  let total: long = 0L

  for k = 0; k < iters; k++ {

    let cnt: long = 0L

    for i = 0L; i < n; i++ {
      unsafe {

        let c, err = bstd.Bytes.getU8(b, i)

        if c == needle { cnt = cnt + 1L }

      }

    }
    total = total + cnt

  }

  return total
}

private fn benchBytesScanSlice(iters: int, s: Slice<byte>, needle: int) -> long {

  let n: long = s.len()

  let nn: byte = (byte)needle

  let total: long = 0L

  for k = 0; k < iters; k++ {

    let cnt: long = 0L

    for i = 0L; i < n; i++ {

      let c: byte = s.get(i)
      // Branchless count to help LLVM vectorize.
      cnt = cnt + (long)(int)(c == nn)

    }
    total = total + cnt

  }

  return total
}

private fn makeMap(size: int) -> map<int, int> {

  let m: map<int, int> = {}

  for i = 0; i < size; i++ {
    m[i] = (i * 2) + 1

  }

  return m
}

private fn benchMapLookup(iters: long, m: map<int, int>, mod: int) -> long {

  let acc: long = 0L

  let x: long = 1L

  let mask: long = (long)(mod - 1)

  for i = 0L; i < iters; i++ {
    x = (x * 1103515245L + 12345L) & 2147483647L

    let k: int = (int)(x & mask)
    acc = acc + (long)m[k].unwrap()

  }

  return acc
}

private fn makeMapFoo(size: int) -> map<int, Foo> {

  let m: map<int, Foo> = {}

  for i = 0; i < size; i++ {
    m[i] = Foo{ a: (i * 2) + 1 }

  }

  return m
}

private fn benchMapLookupFoo(iters: long, m: map<int, Foo>, mod: int) -> long {

  let acc: long = 0L

  let x: long = 1L

  let mask: long = (long)(mod - 1)

  for i = 0L; i < iters; i++ {
    x = (x * 1103515245L + 12345L) & 2147483647L

    let k: int = (int)(x & mask)
    let r = m.get(k).unwrap()
    acc = acc + (long)r.a

  }

  return acc
}

private fn makeIntIntMap(size: int, capPow2: int) -> ptr {

  let h = tua_iimap_new(capPow2)
  if h == null { return null }

  for i = 0; i < size; i++ {
    tua_iimap_set(h, i, (i * 2) + 1)

  }

  return h
}

private fn benchIntIntMapLookup(iters: long, h: ptr, mod: int) -> long {

  let acc: long = 0L

  let x: long = 1L

  let mask: long = (long)(mod - 1)

  for i = 0L; i < iters; i++ {
    x = (x * 1103515245L + 12345L) & 2147483647L

    let k: int = (int)(x & mask)
    acc = acc + (long)tua_iimap_get_present(h, k)

  }

  return acc
}

