private fn runAll() -> int {
  // Keep defaults quick-ish; override via CLI.

  let itersArith: long = 50000000L

  let itersLookup: long = 20000000L

  let itersBytes: int = 50

  let itersDot: int = 3000

  let itersJson: int = 2000

  // Warmup (helps both JIT and AOT: cache, branch predictors).
  benchArithInt(10000L)

  // 1) Integer arithmetic

  let t0 = nowNs()

  let s0 = benchArithInt(itersArith)

  let t1 = nowNs()
  report("tua/arith_int", itersArith, t1 - t0, s0)

  // 2) Dot product

  let a = makeFloatArray(1024, 0.25)

  let b = makeFloatArray(1024, 0.75)

  let td0 = nowNs()

  let sd = benchDotF32(itersDot, a, b)

  let td1 = nowNs()
  report("tua/dot_f32_1024", (long)itersDot, td1 - td0, (long)sd)

  // 3) Bytes scan

  let big: bytes = makeBytes(1024L * 1024L)

  let tb0 = nowNs()

  let sb = benchBytesScan(itersBytes, big, 127)

  let tb1 = nowNs()
  report("tua/bytes_scan_1m", (long)itersBytes, tb1 - tb0, sb)

  let sl: Slice<byte> = big.slice(0L, big.len())

  let tb2 = nowNs()

  let sb2 = benchBytesScanSlice(itersBytes, sl, 127)

  let tb3 = nowNs()
  report("tua/bytes_scan_1m_slice", (long)itersBytes, tb3 - tb2, sb2)

  // 4) Map lookup

  let m = makeMap(8192)

  let tm0 = nowNs()

  let sm = benchMapLookup(itersLookup, m, 8192)

  let tm1 = nowNs()
  report("tua/map_lookup_8k", itersLookup, tm1 - tm0, sm)

  let mf = makeMapFoo(8192)

  let tf0 = nowNs()

  let sf = benchMapLookupFoo(itersLookup, mf, 8192)

  let tf1 = nowNs()
  report("tua/map_lookup_foo_8k", itersLookup, tf1 - tf0, sf)

  let m2: ptr = makeIntIntMap(8192, 16384)

  if m2 != null {

    let tm2 = nowNs()

    let sm2 = benchIntIntMapLookup(itersLookup, m2, 8192)

    let tm3 = nowNs()
    report("tua/intintmap_lookup_8k", itersLookup, tm3 - tm2, sm2)

    tua_iimap_free(m2)

  } else {
    println("tua/intintmap_lookup_8k skipped (alloc failed)")

  }

  // 5) JSON scan (top-level long)
/*
  let jb = loadJsonBytes("bench/data/scan_top_level.json")

  if jb != null {

    let tj0 = nowNs()

    let sj = benchJsonScanTopLevelLong(itersJson, jb, "id")

    let tj1 = nowNs()
    report("tua/json_scan_top_long", (long)itersJson, tj1 - tj0, sj)

  } else {
    println("tua/json_scan_top_long skipped (missing input)")

  }
  */

  return 0
}

fn main(args: string[]) -> int {
  // Minimal CLI:
  //   bench.tua --all
  //   bench.tua --bench arith_int --iters 10000000
  // Defaults to --all.

  if args.len() <= 1 { return runAll() }

  let mode: string = args[1]

  if mode == "--all" { return runAll() }

  if mode != "--bench" {
    println("usage: bench.tua --all | --bench <name> [--iters N]")

    return 2

  }

  if args.len() < 3 {
    println("missing bench name")

    return 2

  }

  let name = args[2]

  let iters: long = 10000000L

  for i = 3; i + 1 < args.len(); i++ {

    if args[i] == "--iters" {
      iters = (long)parseIntArg(args[i + 1], (int)iters)

    }

  }

  if name == "arith_int" {

    let t0 = nowNs()

    let s = benchArithInt(iters)

    let t1 = nowNs()
    report("tua/arith_int", iters, t1 - t0, s)

    return 0

  }

  if name == "map_lookup" {

    let m = makeMap(8192)

    let t0 = nowNs()

    let s = benchMapLookup(iters, m, 8192)

    let t1 = nowNs()
    report("tua/map_lookup_8k", iters, t1 - t0, s)

    return 0

  }

  if name == "map_lookup_foo" {

    let m = makeMapFoo(8192)

    let t0 = nowNs()

    let s = benchMapLookupFoo(iters, m, 8192)

    let t1 = nowNs()
    report("tua/map_lookup_foo_8k", iters, t1 - t0, s)

    return 0

  }

  if name == "intintmap_lookup" {

    let m: ptr = makeIntIntMap(8192, 16384)

    if m == null { return 2 }

    let t0 = nowNs()

    let s = benchIntIntMapLookup(iters, m, 8192)

    let t1 = nowNs()
    report("tua/intintmap_lookup_8k", iters, t1 - t0, s)

    tua_iimap_free(m)

    return 0

  }

  if name == "dot_f32" {

    let a = makeFloatArray(1024, 0.25)

    let b = makeFloatArray(1024, 0.75)

    let t0 = nowNs()

    let s = benchDotF32((int)iters, a, b)

    let t1 = nowNs()
    report("tua/dot_f32_1024", iters, t1 - t0, (long)s)

    return 0

  }

  if name == "bytes_scan" {

    let b = makeBytes(1024L * 1024L)

    let t0 = nowNs()

    let s = benchBytesScan((int)iters, b, 127)

    let t1 = nowNs()
    report("tua/bytes_scan_1m", iters, t1 - t0, s)

    return 0

  }

  if name == "bytes_scan_slice" {

    let big: bytes = makeBytes(1024L * 1024L)

    let sl: Slice<byte> = big.slice(0L, big.len())

    let t0 = nowNs()

    let s = benchBytesScanSlice((int)iters, sl, 127)

    let t1 = nowNs()
    report("tua/bytes_scan_1m_slice", iters, t1 - t0, s)

    return 0

  }

  /*

  if name == "json_scan_top_long" {

    let jb = loadJsonBytes("bench/data/scan_top_level.json")

    if jb == null { return 2 }

    let t0 = nowNs()

    let s = benchJsonScanTopLevelLong((int)iters, jb, "id")

    let t1 = nowNs()
    report("tua/json_scan_top_long", iters, t1 - t0, s)

    return 0

  }

  */

  println("unknown bench: {}", name)

  return 2
}
