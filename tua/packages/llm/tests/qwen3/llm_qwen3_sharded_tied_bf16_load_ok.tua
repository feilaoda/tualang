// tuac: -L build/clib -l tuallm

import Qwen3 from "llm/qwen3"

fn main() {

  let cfg, ce = Qwen3.loadConfig("packages/llm/tests/fixtures/qwen3_sharded_tied/config.json")
  assert(ce == 0)

  let w, we = Qwen3.loadWeightsBF16Auto("packages/llm/tests/fixtures/qwen3_sharded_tied", cfg)
  assert(we == 0)
  assert(w.dtype == 1)
  assert(w.arena != null)

  // `lm_head.weight` is missing from the weight_map; loader must tie it to embeddings.
  assert(w.offLmHead == w.offEmbed)
}
