import "std/bytes" as bstd
import "std/strconv" as conv
import "std/fs" as fs
import "std/time" as time
import BpeTokenizer from "llm/tokenizer_bpe"

extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string

fn main(args: string[]) -> int {

  let modelDir: string = "examples/models/qwen3-0.6b"

  let iters: int = 20

  let repeat: int = 1

  let noAdded: int = 0

  let textPath: string = modelDir + "/README.md"

  if args.len() >= 2 { textPath = args[1] }

  if args.len() >= 3 {

    let o = conv.Int.parse(args[2])

    if o.isSome() { iters = o.unwrap() }

  }

  if args.len() >= 4 {

    let o2 = conv.Int.parse(args[3])

    if o2.isSome() { repeat = o2.unwrap() }

  }

  if args.len() >= 5 {

    if args[4] == "noadded" { noAdded = 1 }

  }

  let tok, te = BpeTokenizer.loadFromTokenizerJson(modelDir + "/tokenizer.json")

  if te != 0 { println("load tokenizer failed"); return 1 }

  let text, _, fe = fs.Fs.readFile(textPath)

  if fe != 0 { println("read file failed err={} path={}", fe, textPath); return 1 }

  let tb = bstd.Bytes.fromString(text)

  let tlen = bstd.Bytes.len(tb)

  if repeat > 1 && tlen > 0L {

    let bigLen: long = ((long)repeat) * tlen

    let big = bstd.Bytes.newLong(bigLen)

    let ri: int = 0

    while ri < repeat {

      let _ = bstd.Bytes.copy(big, ((long)ri) * tlen, tb, 0L, tlen)
      ri = ri + 1

    }
    text = tua_str_from_bytes_copy(big, 0L, bigLen)
    tb = big
    tlen = bigLen

  }

  // Warmup + timed loop.

  let warm: long[] = null

  let totalTokens: long = 0L

  let t0 = time.Time.monoNs()

  let t1 = t0

  if noAdded == 1 {

    let wids, we = BpeTokenizer.encodeNoAdded(tok, text)

    if we != 0 { println("warmup encode failed"); return 1 }
    warm = wids
    t0 = time.Time.monoNs()

    let i: int = 0

    while i < iters {

      let ids0, e = BpeTokenizer.encodeNoAdded(tok, text)

      if e != 0 { println("encode failed iter={}", i); return 1 }

      let ids: long[] = ids0
      totalTokens = totalTokens + (long)ids.len()
      i = i + 1

    }
    t1 = time.Time.monoNs()

  } else {

    let wids, we = BpeTokenizer.encode(tok, text)

    if we != 0 { println("warmup encode failed"); return 1 }
    warm = wids
    t0 = time.Time.monoNs()

    let i: int = 0

    while i < iters {

      let ids0, e = BpeTokenizer.encode(tok, text)

      if e != 0 { println("encode failed iter={}", i); return 1 }

      let ids: long[] = ids0
      totalTokens = totalTokens + (long)ids.len()
      i = i + 1

    }
    t1 = time.Time.monoNs()

  }

  let dtNs: long = t1 - t0

  let tokPerSec: long = 0L

  if dtNs > 0L {
    tokPerSec = (totalTokens * 1000000000L) / dtNs

  }

  println("textPath={} bytes={} repeat={} warmTokens={} iters={} totalTokens={} dtMs={} tokPerSec={}", textPath, tlen, repeat, warm.len(), iters, totalTokens, dtNs / 1000000L, tokPerSec)

  return 0
}
