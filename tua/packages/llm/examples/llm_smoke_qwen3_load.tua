import Qwen3 from "llm/qwen3"
import LlmArgs from "llm/options"

fn main(args: string[]) -> int {

  let modelDir = "examples/models/qwen3-0.6b"

  if args.len() >= 2 { modelDir = args[1] }

  let opts, oe = LlmArgs.parseArgv(args)

  if oe != 0 { println("bad args"); return 1 }

  let st, e = Qwen3.loadState(modelDir, opts)

  let _ = st
  println("loadState e={}", e)

  return 0
}
