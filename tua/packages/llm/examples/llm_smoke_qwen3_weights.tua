import Qwen3 from "llm/qwen3"

fn main(args: string[]) -> int {

  let modelDir = "examples/models/qwen3-0.6b"

  if args.len() >= 2 { modelDir = args[1] }

  let cfg, ce = Qwen3.loadConfig(modelDir + "/config.json")
  println("loadConfig e={}", ce)

  if ce != 0 { return 0 }

  let w, we = Qwen3.loadWeightsF32(modelDir + "/model.safetensors", cfg)

  let _ = w
  println("loadWeightsF32 e={}", we)

  return 0
}
