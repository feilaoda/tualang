import OpsBackend, OpTranspose from "./ops"

// CBLAS constants (Apple Accelerate).
private enum CblasOrder {
    rowMajor = 101,
    colMajor = 102,
}

private enum CblasTranspose {
    noTrans = 111,
    trans = 112,
}

extern fn cblas_sgemm(order: int, transA: int, transB: int, m: int, n: int, k: int, alpha: float, a: ptr, lda: int, b: ptr, ldb: int, beta: float, c: ptr, ldc: int)

extern fn cblas_sgemv(order: int, transA: int, m: int, n: int, alpha: float, a: ptr, lda: int, x: ptr, incx: int, beta: float, y: ptr, incy: int)

extern fn tua_llm_set_threads(n: int) int

struct AccelerateOps {}

private fn _toCblasTranspose(t: int) int {
    if t == OpTranspose.trans { return CblasTranspose.trans }
    return CblasTranspose.noTrans
}

impl AccelerateOps {
    fn setThreads(n: int) int {
        return tua_llm_set_threads(n)
    }

    fn gemmF32(transA: int, transB: int, m: int, n: int, k: int, alpha: float, a: ptr, lda: int, b: ptr, ldb: int, beta: float, c: ptr, ldc: int) int {
        cblas_sgemm(CblasOrder.rowMajor, _toCblasTranspose(transA), _toCblasTranspose(transB), m, n, k, alpha, a, lda, b, ldb, beta, c, ldc)
        return 0
    }

    fn gemvF32(transA: int, m: int, n: int, alpha: float, a: ptr, lda: int, x: ptr, incx: int, beta: float, y: ptr, incy: int) int {
        // Accelerate's cblas_sgemv can be surprisingly brittle in some environments; use sgemm with n=1
        // which is widely supported and tends to be more robust.
        if incx != 1 || incy != 1 {
            cblas_sgemv(CblasOrder.rowMajor, _toCblasTranspose(transA), m, n, alpha, a, lda, x, incx, beta, y, incy)
            return 0
        }
        if transA == OpTranspose.trans {
            // y[n] = A^T[n,m] * x[m]
            cblas_sgemm(CblasOrder.rowMajor, CblasTranspose.trans, CblasTranspose.noTrans, n, 1, m, alpha, a, lda, x, 1, beta, y, 1)
            return 0
        }
        // y[m] = A[m,n] * x[n]
        cblas_sgemm(CblasOrder.rowMajor, CblasTranspose.noTrans, CblasTranspose.noTrans, m, 1, n, alpha, a, lda, x, 1, beta, y, 1)
        return 0
    }
}

impl OpsBackend for AccelerateOps {}
