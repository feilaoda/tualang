import "std/strconv" as conv

struct LlmOptions {
    threads: int
    kvMaxBytes: long
    kvMaxSeq: int
    maxNewTokens: int
    temperature: float
    topK: int
    topP: float
    repeatPenalty: float
    repeatLastN: int
    noRepeatNgram: int
    seed: long
    chat: int
    enableThinking: int
}

object LlmArgs {
    fn defaults() -> LlmOptions {
        // Default sampling follows Qwen3 README recommendations (non-thinking mode):
        // Temperature=0.7, TopP=0.8, TopK=20. Seed=0 means auto-seed.
        // Repetition penalty helps avoid loopy outputs (especially in greedy mode).
        return LlmOptions{ threads: 0, kvMaxBytes: 0L, kvMaxSeq: 0, maxNewTokens: 1, temperature: 0.7, topK: 20, topP: 0.8, repeatPenalty: 1.1, repeatLastN: 64, noRepeatNgram: 3, seed: 0L, chat: 1, enableThinking: 1 }
    }

    fn parseArgv(argv: string[]) -> int, LlmOptions {
        let out: LlmOptions = LlmArgs.defaults()
        if argv == null { return 0, out }
        let n = argv.len()

        let i: int = 1
        while i < n {
            let a = argv[i]
            if a == "--threads" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                out.threads = opt.unwrap()
                i = i + 2
                continue
            }
            if a == "--kv-mib" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let mib = opt.unwrap()
                if mib < 0 { return 1, out }
                out.kvMaxBytes = (long)mib * 1024L * 1024L
                i = i + 2
                continue
            }
            if a == "--kv-max-seq" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0 { return 1, out }
                out.kvMaxSeq = v
                i = i + 2
                continue
            }
            if a == "--max-new-tokens" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0 { return 1, out }
                out.maxNewTokens = v
                i = i + 2
                continue
            }
            if a == "--temp" || a == "--temperature" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Float.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0.0 { return 1, out }
                out.temperature = v
                i = i + 2
                continue
            }
            if a == "--top-k" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0 { return 1, out }
                out.topK = v
                i = i + 2
                continue
            }
            if a == "--top-p" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Float.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0.0 { return 1, out }
                out.topP = v
                i = i + 2
                continue
            }
            if a == "--repeat-penalty" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Float.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0.0 { return 1, out }
                out.repeatPenalty = v
                i = i + 2
                continue
            }
            if a == "--repeat-last-n" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0 { return 1, out }
                out.repeatLastN = v
                i = i + 2
                continue
            }
            if a == "--no-repeat-ngram" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                let v = opt.unwrap()
                if v < 0 { return 1, out }
                out.noRepeatNgram = v
                i = i + 2
                continue
            }
            if a == "--seed" {
                if i + 1 >= n { return 1, out }
                let opt = conv.Int.parse(argv[i + 1])
                if opt.isNone() { return 1, out }
                out.seed = (long)opt.unwrap()
                i = i + 2
                continue
            }
            if a == "--chat" {
                out.chat = 1
                i = i + 1
                continue
            }
            if a == "--raw" {
                out.chat = 0
                i = i + 1
                continue
            }
            if a == "--thinking" {
                out.enableThinking = 1
                i = i + 1
                continue
            }
            if a == "--no-thinking" {
                out.enableThinking = 0
                i = i + 1
                continue
            }
            if a == "--greedy" {
                out.temperature = 0.0
                out.topK = 1
                out.topP = 0.0
                i = i + 1
                continue
            }
            i = i + 1
        }
        return 0, out
    }
}
