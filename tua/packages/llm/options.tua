import "std/strconv" as conv

struct LlmOptions {
    threads: int
    // 0 = load weights as f32 (convert BF16/F16 -> F32),
    // 1 = keep weights as BF16, 2 = keep weights as FP16,
    // 3 = quantize weights to Q4_0 (from BF16),
    // 4 = quantize weights to Q4_K (from BF16).
    weightsDtype: int
    // KV cache dtype:
    // 0 = F32 KV (default), 1 = BF16 KV, 2 = FP16 KV.
    kvDtype: int
    kvMaxBytes: long
    kvMaxSeq: int
    maxNewTokens: int
    temperature: float
    topK: int
    topP: float
    repeatPenalty: float
    repeatLastN: int
    noRepeatNgram: int
    seed: long
    chat: int
    enableThinking: int
    profile: int
}

object LlmArgs {
 
 
  fn defaults() -> LlmOptions {
        // Default sampling follows Qwen3 README recommendations (non-thinking mode):
        // Temperature=0.7, TopP=0.8, TopK=20. Seed=0 means auto-seed.
        // Repetition penalty helps avoid loopy outputs (especially in greedy mode).
 
 
 
 
 
   return LlmOptions{ threads: 0, weightsDtype: 0, kvDtype: 0, kvMaxBytes: 0L, kvMaxSeq: 0, maxNewTokens: 1, temperature: 0.7, topK: 20, topP: 0.8, repeatPenalty: 1.1, repeatLastN: 64, noRepeatNgram: 3, seed: 0L, chat: 1, enableThinking: 1, profile: 0 }
 
   }

 
 
  fn parseArgv(argv: string[]) -> LlmOptions, int{
 
 
 
 
 
   let out: LlmOptions = LlmArgs.defaults()
 
 
 
 
 
   if argv == null { return out, 0}
 
 
 
 
 
   let n = argv.len()

 
 
 
 
 
   let i: int = 1
 
 
 
 
 
   while i < n {
 
 
 
 
 
       let a = argv[i]
 
 
 
 
 
       if a == "--threads" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
                out.threads = opt.unwrap()
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--w-f32" || a == "--weights-f32" {
                out.weightsDtype = 0
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--w-bf16" || a == "--weights-bf16" {
                out.weightsDtype = 1
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--w-fp16" || a == "--weights-fp16" {
                out.weightsDtype = 2
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--w-q4" || a == "--weights-q4" || a == "--w-q4_0" || a == "--weights-q4_0" {
                out.weightsDtype = 3
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--w-q4km" || a == "--weights-q4km" || a == "--w-q4_k" || a == "--weights-q4_k" || a == "--w-q4_k_m" || a == "--weights-q4_k_m" {
                out.weightsDtype = 4
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--kv-f32" {
                out.kvDtype = 0
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--kv-bf16" {
                out.kvDtype = 1
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--kv-fp16" {
                out.kvDtype = 2
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--kv-mib" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let mib = opt.unwrap()
 
 
 
 
 
           if mib < 0 { return out, 1}
                out.kvMaxBytes = (long)mib * 1024L * 1024L
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--kv-max-seq" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0 { return out, 1}
                out.kvMaxSeq = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--max-new-tokens" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0 { return out, 1}
                out.maxNewTokens = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--temp" || a == "--temperature" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Float.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0.0 { return out, 1}
                out.temperature = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--top-k" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0 { return out, 1}
                out.topK = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--top-p" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Float.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0.0 { return out, 1}
                out.topP = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--repeat-penalty" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Float.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0.0 { return out, 1}
                out.repeatPenalty = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--repeat-last-n" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0 { return out, 1}
                out.repeatLastN = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--no-repeat-ngram" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
 
 
 
 
 
           let v = opt.unwrap()
 
 
 
 
 
           if v < 0 { return out, 1}
                out.noRepeatNgram = v
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--seed" {
 
 
 
 
 
           if i + 1 >= n { return out, 1}
 
 
 
 
 
           let opt = conv.Int.parse(argv[i + 1])
 
 
 
 
 
           if opt.isNone() { return out, 1}
                out.seed = (long)opt.unwrap()
                i = i + 2
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--chat" {
                out.chat = 1
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--raw" {
                out.chat = 0
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--thinking" {
                out.enableThinking = 1
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--no-thinking" {
                out.enableThinking = 0
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--greedy" {
                out.temperature = 0.0
                out.topK = 1
                out.topP = 0.0
                i = i + 1
 
 
 
 
 
           continue
 
           }
 
 
 
 
 
       if a == "--profile" {
                out.profile = 1
                i = i + 1
 
 
 
 
 
           continue
 
           }
            i = i + 1
 
       }
 
 
 
 
 
   return out, 0
 
   }
}
