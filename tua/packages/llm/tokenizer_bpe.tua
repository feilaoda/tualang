import "std/bytes" as bstd
import "json" as json
import "std/utf8" as utf8

import Gguf from "./gguf"

extern fn strlen(s: string) long
extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string
extern fn tua_str_ptr(s: string) -> ptr

extern fn tua_bytes_data_at(b: bytes, off: long) -> ptr
extern fn memcmp(a: ptr, b: ptr, n: long) int

extern fn tua_llm_bpe_merge_ids(ids: long[], pairRank: map<long, long>, pairMergeId: map<long, long>, outErr: &int) -> long[]
extern fn tua_llm_bpe_bytes_to_ids(b: bytes, off: long, len: long, byteToId: long[], outErr: &int) -> long[]
extern fn tua_llm_bpe_decode_ids_to_bytes(ids: long[], idToToken: map<long, string>, outErr: &int) -> bytes
extern fn tua_llm_bpe_merges_lines_pair_maps(merges: string[], vocab: map, outRank: &map, outMergeId: &map, outCount: &long) int

extern fn tua_json_parse_key_path_bpe_merges_pair_maps(b: bytes, path: string, vocab: map, outRank: &map, outMergeId: &map, outCount: &long) int

extern fn tua_json_parse_top_level_added_tokens_content_id_map(b: bytes, out: &map) int

struct TokenizerBpe {
    raw: bytes
    vocab: map<string, long>
    idToToken: map<long, string>           // vocab + added
    added: map<string, long>
    addedList: string[]                   // added token contents (desc by strlen)
    pairRank: map<long, long>
    pairMergeId: map<long, long>
    byteToId: long[]                       // 256 entries, -1 if unknown
    cpToByte: map<int, int>
}

private fn _mapGetOptStringLong(m: map<string, long>, k: string) -> Option<long> {
 
 
  return m[k]
}

private fn _mapGetOptLongLong(m: map<long, long>, k: long) -> Option<long> {
 
 
  return m[k]
}

private fn _mapGetOptLongString(m: map<long, string>, k: long) -> Option<string> {
 
 
  return m[k]
}

private fn _mapGetOptIntInt(m: map<int, int>, k: int) -> Option<int> {
 
 
  return m[k]
}

private fn _endsWith(s: string, suf: string) -> bool {
 
 
  if s == null || suf == null { return false }
 
 
  let sb = bstd.Bytes.fromString(s)
 
 
  let tb = bstd.Bytes.fromString(suf)
 
 
  let sn = bstd.Bytes.len(sb)
 
 
  let tn = bstd.Bytes.len(tb)
 
 
  if tn > sn { return false }
 
 
  let i: long = 0L
 
 
  while i < tn {
 
 
 
 
 
   let a, e0 = bstd.Bytes.getU8(sb, sn - tn + i)
 
 
 
 
 
   if e0 != 0 { return false }
 
 
 
 
 
   let b, e1 = bstd.Bytes.getU8(tb, i)
 
 
 
 
 
   if e1 != 0 { return false }
 
 
 
 
 
   if a != b { return false }
        i = i + 1L
 
   }
 
 
  return true
}

private fn _byteToIdAt(a: long[], idx: int) -> long {
 
 
  return a[idx]
}

private fn _isAsciiLetter(cp: int) -> bool {
 
 
  if cp >= 65 && cp <= 90 { return true }
 
 
  if cp >= 97 && cp <= 122 { return true }
 
 
  return false
}

private fn _isAsciiDigit(cp: int) -> bool { return cp >= 48 && cp <= 57 }

private fn _isCrLf(cp: int) -> bool { return cp == 10 || cp == 13 }

private fn _isWs(cp: int) -> bool {
    // Best-effort Unicode whitespace set for tokenizer regex \s.
 
 
  if cp == 32 || cp == 9 || cp == 10 || cp == 13 || cp == 11 || cp == 12 { return true }
 
 
  if cp == 160 { return true } // NBSP
 
 
  if cp == 5760 { return true } // OGHAM SPACE MARK
 
 
  if cp >= 8192 && cp <= 8202 { return true } // EN QUAD..HAIR SPACE
 
 
  if cp == 8232 || cp == 8233 { return true } // LINE/PARAGRAPH SEPARATOR
 
 
  if cp == 8239 { return true } // NARROW NBSP
 
 
  if cp == 8287 { return true } // MEDIUM MATHEMATICAL SPACE
 
 
  if cp == 12288 { return true } // IDEOGRAPHIC SPACE
 
 
  return false
}

private fn _isLetter(cp: int) -> bool {
 
 
  if _isAsciiLetter(cp) { return true }
    // Fullwidth Latin.
 
 
  if cp >= 65313 && cp <= 65338 { return true } // Ａ..Ｚ
 
 
  if cp >= 65345 && cp <= 65370 { return true } // ａ..ｚ
    // Latin-1 supplement + Latin extended + IPA.
 
 
  if cp >= 192 && cp <= 214 { return true }
 
 
  if cp >= 216 && cp <= 246 { return true }
 
 
  if cp >= 248 && cp <= 687 { return true }
    // Greek, Cyrillic, Armenian (rough blocks).
 
 
  if cp >= 880 && cp <= 1327 { return true }
    // Hebrew + Arabic + Indic (rough; better than treating all non-ASCII as letters).
 
 
  if cp >= 1424 && cp <= 1791 { return true }
 
 
  if cp >= 1536 && cp <= 1791 { return true }
 
 
  if cp >= 2304 && cp <= 2431 { return true } // Devanagari
    // Hiragana / Katakana / Hangul / Bopomofo.
 
 
  if cp >= 12352 && cp <= 12543 { return true }
 
 
  if cp >= 12544 && cp <= 12783 { return true }
 
 
  if cp >= 13312 && cp <= 40959 { return true } // CJK Ext A + Unified
 
 
  if cp >= 44032 && cp <= 55215 { return true } // Hangul syllables
 
 
  if cp >= 63744 && cp <= 64255 { return true } // CJK compatibility ideographs
 
 
  return false
}

private fn _isNumber(cp: int) -> bool {
 
 
  if _isAsciiDigit(cp) { return true }
 
 
  if cp >= 65296 && cp <= 65305 { return true } // fullwidth digits
 
 
  if cp >= 1632 && cp <= 1641 { return true } // Arabic-Indic digits
 
 
  if cp >= 1776 && cp <= 1785 { return true } // Extended Arabic-Indic digits
 
 
  return false
}

private fn _isPunctLike(cp: int) -> bool {
    // For `[^\s\p{L}\p{N}]`
 
 
  if _isWs(cp) { return false }
 
 
  if _isLetter(cp) { return false }
 
 
  if _isNumber(cp) { return false }
 
 
  return true
}

private fn _matchContractionAscii(b: bytes, off: long, end: long) -> long {
    // ASCII-only: "'s|'t|'re|'ve|'m|'ll|'d" (case-insensitive)
 
 
  if off + 1L >= end { return 0L }
 
 
  let b0, e0 = bstd.Bytes.getU8(b, off)
 
 
  if e0 != 0 || b0 != 39 { return 0L } // '\''
 
 
  let b1, e1 = bstd.Bytes.getU8(b, off + 1L)
 
 
  if e1 != 0 { return 0L }
 
 
  let c1 = b1
 
 
  if c1 >= 65 && c1 <= 90 { c1 = c1 + 32 }
 
 
  if c1 == 115 || c1 == 116 || c1 == 109 || c1 == 100 { return 2L } // s t m d
 
 
  if off + 2L >= end { return 0L }
 
 
  let b2, e2 = bstd.Bytes.getU8(b, off + 2L)
 
 
  if e2 != 0 { return 0L }
 
 
  let c2 = b2
 
 
  if c2 >= 65 && c2 <= 90 { c2 = c2 + 32 }
 
 
  if c1 == 114 && c2 == 101 { return 3L } // re
 
 
  if c1 == 118 && c2 == 101 { return 3L } // ve
 
 
  if c1 == 108 && c2 == 108 { return 3L } // ll
 
 
  return 0L
}

private fn _matchContraction(b: bytes, off: long) -> long {
    // ASCII-only: "'s|'t|'re|'ve|'m|'ll|'d" (case-insensitive)
 
 
  let cp0, sz0, e0 = utf8.Utf8.decode1(b, off)
 
 
  if e0 != 0 || sz0 != 1L { return 0L }
 
 
  if cp0 != 39 { return 0L } // '\''

 
 
  let cp1, sz1, e1 = utf8.Utf8.decode1(b, off + 1L)
 
 
  if e1 != 0 || sz1 != 1L { return 0L }
 
 
  let c1 = cp1
 
 
  if c1 >= 65 && c1 <= 90 { c1 = c1 + 32 }

 
 
  if c1 == 115 { return 2L } // 's
 
 
  if c1 == 116 { return 2L } // 't
 
 
  if c1 == 109 { return 2L } // 'm
 
 
  if c1 == 100 { return 2L } // 'd

 
 
  if c1 == 114 { // 're
 
 
 
 
 
   let cp2, sz2, e2 = utf8.Utf8.decode1(b, off + 2L)
 
 
 
 
    if e2 != 0 || sz2 != 1L { return 0L }
 
 
 
 
 
   let c2 = cp2
 
 
 
 
 
   if c2 >= 65 && c2 <= 90 { c2 = c2 + 32 }
 
 
 
 
 
   if c2 == 101 { return 3L }
 
 
 
 
 
   return 0L
 
   }
 
 
  if c1 == 118 { // 've
 
 
 
 
 
   let cp2, sz2, e2 = utf8.Utf8.decode1(b, off + 2L)
 
 
 
 
    if e2 != 0 || sz2 != 1L { return 0L }
 
 
 
 
 
   let c2 = cp2
 
 
 
 
 
   if c2 >= 65 && c2 <= 90 { c2 = c2 + 32 }
 
 
 
 
 
   if c2 == 101 { return 3L }
 
 
 
 
 
   return 0L
 
   }
 
 
  if c1 == 108 { // 'll
 
 
 
 
 
   let cp2, sz2, e2 = utf8.Utf8.decode1(b, off + 2L)
 
 
 
 
    if e2 != 0 || sz2 != 1L { return 0L }
 
 
 
 
 
   let c2 = cp2
 
 
 
 
 
   if c2 >= 65 && c2 <= 90 { c2 = c2 + 32 }
 
 
 
 
 
   if c2 == 108 { return 3L }
 
 
 
 
 
   return 0L
 
   }

 
 
  return 0L
}

private fn _splitGpt2RegexSpans(b: bytes, off: long, len: long) -> long[], int{
 
 
  if b == null { return null, 1}
 
 
  if off < 0L || len < 0L { return null, 1}
 
 
  let n = bstd.Bytes.len(b)
 
 
  if off > n { return null, 1}
 
 
  let end = off + len
 
 
  if end > n { return null, 1}

 
 
  let spans: long[] = {}
 
 
  let i: long = off
 
 
  while i < end {
        // 1) Contractions.
 
 
 
 
 
   let clen = _matchContractionAscii(b, i, end)
 
 
 
 
 
   if clen > 0L {
            spans.push(i); spans.push(clen)
            i = i + clen
 
 
 
 
 
       continue
 
       }

 
 
 
 
 
   let cp, sz, e0 = utf8.Utf8.decode1(b, i)
 
 
 
 
    if e0 != 0 { return null, 1}

        // 2) `[^\r\n\p{L}\p{N}]?\p{L}+`
 
 
 
 
 
   if _isLetter(cp) {
 
 
 
 
 
       let j: long = i + sz
 
 
 
 
 
       while j < end {
 
 
 
 
 
           let c1, s1, e1 = utf8.Utf8.decode1(b, j)
 
 
 
 
            if e1 != 0 { return null, 1}
 
 
 
 
 
           if !_isLetter(c1) { break }
                j = j + s1
 
           }
            spans.push(i); spans.push(j - i)
            i = j
 
 
 
 
 
       continue
 
       }
 
 
 
 
 
   if !_isCrLf(cp) && !_isLetter(cp) && !_isNumber(cp) {
 
 
 
 
 
       let j0: long = i + sz
 
 
 
 
 
       if j0 < end {
 
 
 
 
 
           let c1, s1, e1 = utf8.Utf8.decode1(b, j0)
 
 
 
 
            if e1 != 0 { return null, 1}
 
 
 
 
 
           if _isLetter(c1) {
 
 
 
 
 
               let j: long = j0 + s1
 
 
 
 
 
               while j < end {
 
 
 
 
 
                   let c2, s2, e2 = utf8.Utf8.decode1(b, j)
 
 
 
 
                    if e2 != 0 { return null, 1}
 
 
 
 
 
                   if !_isLetter(c2) { break }
                        j = j + s2
 
                   }
                    spans.push(i); spans.push(j - i)
                    i = j
 
 
 
 
 
               continue
 
               }
 
           }
 
       }

        // 3) `\p{N}`
 
 
 
 
 
   if _isNumber(cp) {
            spans.push(i); spans.push(sz)
            i = i + sz
 
 
 
 
 
       continue
 
       }

        // 4) ` ?[^\s\p{L}\p{N}]+[\r\n]*`
 
 
 
 
 
   let hasLeadSpace: int = 0
 
 
 
 
 
   let j: long = i
 
 
 
 
 
   let punctStart: long = i
 
 
 
 
 
   let punctCp: int = cp
 
 
 
 
 
   let punctSz: long = sz
 
 
 
 
 
   if cp == 32 {
 
 
 
 
 
       let nextOff = i + sz
 
 
 
 
 
       if nextOff < end {
 
 
 
 
 
           let c1, s1, e1 = utf8.Utf8.decode1(b, nextOff)
 
 
 
 
            if e1 != 0 { return null, 1}
 
 
 
 
 
           if _isPunctLike(c1) {
                    hasLeadSpace = 1
                    punctStart = nextOff
                    punctCp = c1
                    punctSz = s1
 
               }
 
           }
 
       }
 
 
 
 
 
   if hasLeadSpace == 1 || _isPunctLike(cp) {
 
 
 
 
 
       if hasLeadSpace == 1 {
                j = punctStart + punctSz
 
           } else {
                j = i + sz
 
           }
 
 
 
 
 
       while j < end {
 
 
 
 
 
           let c2, s2, e2 = utf8.Utf8.decode1(b, j)
 
 
 
 
            if e2 != 0 { return null, 1}
 
 
 
 
 
           if !_isPunctLike(c2) { break }
                j = j + s2
 
           }
            // trailing [\r\n]*
 
 
 
 
 
       while j < end {
 
 
 
 
 
           let c3, s3, e3 = utf8.Utf8.decode1(b, j)
 
 
 
 
            if e3 != 0 { return null, 1}
 
 
 
 
 
           if !_isCrLf(c3) { break }
                j = j + s3
 
           }
            spans.push(i); spans.push(j - i)
            i = j
 
 
 
 
 
       continue
 
       }

        // 5) `\s*[\r\n]+` (spaces before newline stick with newline)
 
 
 
 
 
   if _isWs(cp) {
 
 
 
 
 
       let j2: long = i
 
 
 
 
 
       while j2 < end {
 
 
 
 
 
           let c4, s4, e4 = utf8.Utf8.decode1(b, j2)
 
 
 
 
            if e4 != 0 { return null, 1}
 
 
 
 
 
           if !_isWs(c4) { break }
 
 
 
 
 
           if _isCrLf(c4) { break }
                j2 = j2 + s4
 
           }
 
 
 
 
 
       if j2 < end {
 
 
 
 
 
           let c5, s5, e5 = utf8.Utf8.decode1(b, j2)
 
 
 
 
            if e5 != 0 { return null, 1}
 
 
 
 
 
           if _isCrLf(c5) {
 
 
 
 
 
               let j3: long = j2 + s5
 
 
 
 
 
               while j3 < end {
 
 
 
 
 
                   let c6, s6, e6 = utf8.Utf8.decode1(b, j3)
 
 
 
 
                    if e6 != 0 { return null, 1}
 
 
 
 
 
                   if !_isCrLf(c6) { break }
                        j3 = j3 + s6
 
                   }
                    spans.push(i); spans.push(j3 - i)
                    i = j3
 
 
 
 
 
               continue
 
               }
 
           }
 
       }

        // 6) `\s+(?!\S)` => whitespace at end.
 
 
 
 
 
   if _isWs(cp) {
 
 
 
 
 
       let j4: long = i + sz
 
 
 
 
 
       while j4 < end {
 
 
 
 
 
           let c7, s7, e7 = utf8.Utf8.decode1(b, j4)
 
 
 
 
            if e7 != 0 { return null, 1}
 
 
 
 
 
           if !_isWs(c7) { break }
                j4 = j4 + s7
 
           }
 
 
 
 
 
       if j4 == end {
                spans.push(i); spans.push(j4 - i)
                i = j4
 
 
 
 
 
           continue
 
           }
 
       }

        // 7) `\s+`
 
 
 
 
 
   if _isWs(cp) {
 
 
 
 
 
       let j5: long = i + sz
 
 
 
 
 
       while j5 < end {
 
 
 
 
 
           let c8, s8, e8 = utf8.Utf8.decode1(b, j5)
 
 
 
 
            if e8 != 0 { return null, 1}
 
 
 
 
 
           if !_isWs(c8) { break }
                j5 = j5 + s8
 
           }
            spans.push(i); spans.push(j5 - i)
            i = j5
 
 
 
 
 
       continue
 
       }

        // Fallback: 1 codepoint.
        spans.push(i); spans.push(sz)
        i = i + sz
 
   }
 
 
  return spans, 0
}

private fn _pairKey(a: long, b: long) -> long {
 
 
  let hi: long = a << 32L
 
 
  let lo: long = (long)(u32)b
 
 
  return hi | lo
}

private fn _encodeSegmentBytes(t: TokenizerBpe, b: bytes, off: long, len: long) -> long[], int {
 
 
  if len <= 0L {
 
 
 
 
 
   let z: long[] = {}
 
 
 
 
 
   return z, 0
 
   }
 
 
  let spans0, se = _splitGpt2RegexSpans(b, off, len)
 
 
  if se != 0 || spans0 == null { return null, 1 }
 
 
  let spans: long[] = spans0

 
 
  let out: long[] = {}
 
 
  let si: int = 0
 
 
  while si + 1 < spans.len() {
 
 
 
 
 
   let poff: long = spans[si]
 
 
 
 
 
   let plen: long = spans[si + 1]
        si = si + 2
 
 
 
 
 
   if plen <= 0L { continue }

        // Byte-level ids (C runtime fast path).
 
 
 
 
 
   let be: int = 0
 
 
 
 
 
   let ids: long[] = tua_llm_bpe_bytes_to_ids(b, poff, plen, t.byteToId, &be)
 
 
 
 
 
   if be != 0 || ids == null { return null, 1 }

        // BPE merge on ids (C runtime).
 
 
 
 
 
   let me: int = 0
 
 
 
 
 
   let word: long[] = tua_llm_bpe_merge_ids(ids, t.pairRank, t.pairMergeId, &me)
 
 
 
 
 
   if me != 0 || word == null { return null, 1 }

 
 
 
 
 
   let mi: int = 0
 
 
 
 
 
   while mi < word.len() { out.push(word[mi]); mi = mi + 1 }
 
   }

 
 
  return out, 0
}

object BpeTokenizer {
 
 
  fn loadFromTokenizerJson(path: string) -> TokenizerBpe, int {
 
 
 
 
 
   let raw, e0 = bstd.Bytes.mmapFile(path)
 
 
 
 
    if e0 != 0 { return TokenizerBpe{}, 1 }

 
 
 
 
 
   let vocabAny, ve = json.Json.parseKeyPathStringLongMap(raw, "model.vocab")
 
 
 
 
    if ve != 0 || vocabAny == null { return TokenizerBpe{}, 1 }
 
 
 
 
 
	   let vocab: map<string, long> = vocabAny
	   let vocabMap: map = vocabAny

 
 
 
 
 
   let rankAny: map = null
 
 
 
 
 
   let mergeAny: map = null
 
 
 
 
 
   let mergeCount: long = 0L
 
 
 
 
 
	   let me = tua_json_parse_key_path_bpe_merges_pair_maps(raw, "model.merges", vocabMap, &rankAny, &mergeAny, &mergeCount)
 
 
 
 
 
   if me != 0 || rankAny == null || mergeAny == null { return TokenizerBpe{}, 1 }
 
 
 
 
 
   let pairRank: map<long, long> = rankAny
 
 
 
 
 
   let pairMergeId: map<long, long> = mergeAny

 
 
 
 
 
   let addedAny: map = null
 
 
 
 
 
   let ae = tua_json_parse_top_level_added_tokens_content_id_map(raw, &addedAny)
 
 
 
 
 
   let added: map<string, long> = {}
 
 
 
 
 
   if ae == 0 && addedAny != null {
            added = addedAny
 
       }
 
 
 
 
 
   let addedList: string[] = {}
 
 
 
 
 
   if added != null {
 
 
 
 
 
       for content, _ in added {
                addedList.push(content)
 
           }
 
       }
        // Sort addedList by strlen desc (longest match wins).
 
 
 
 
 
   let si: int = 1
 
 
 
 
 
   while si < addedList.len() {
 
 
 
 
 
       let key: string = addedList[si]
 
 
 
 
 
       let keyLen: long = strlen(key)
 
 
 
 
 
       let sj: int = si - 1
 
 
 
 
 
       while sj >= 0 {
 
 
 
 
 
           let cur: string = addedList[sj]
 
 
 
 
 
           if strlen(cur) >= keyLen { break }
                addedList[sj + 1] = cur
                sj = sj - 1
 
           }
            addedList[sj + 1] = key
            si = si + 1
 
       }

        // Build id->token map (vocab + added).
 
 
 
 
 
   let idToToken: map<long, string> = {}
 
 
 
 
 
   for tokStr, idVal in vocab {
 
 
 
 
 
       let id: long = idVal
            idToToken[id] = tokStr
 
       }
 
 
 
 
 
   for content, idVal2 in added {
 
 
 
 
 
       let id2: long = idVal2
            idToToken[id2] = content
 
       }

        // Byte-level mapping (GPT-2 style): byte -> unicode cp and inverse cp -> byte.
 
 
 
 
 
   let byteToId: long[] = {}
 
 
 
 
 
   let i: int = 0
 
 
 
 
 
   while i < 256 {
            byteToId.push(-1L)
            i = i + 1
 
       }
 
 
 
 
 
   let cpToByte: map<int, int> = {}

 
 
 
 
 
   let tmp = bstd.Bytes.new(4)
 
 
 
 
 
   let bval: int = 0
 
 
 
 
 
   let nextCp: int = 256
 
 
 
 
 
   while bval < 256 {
 
 
 
 
 
       let cp: int = -1
 
 
 
 
 
       if bval >= 33 && bval <= 126 { cp = bval }
 
 
 
 
 
       else if bval >= 161 && bval <= 172 { cp = bval }
 
 
 
 
 
       else if bval >= 174 && bval <= 255 { cp = bval }
 
 
 
 
 
       else { cp = nextCp; nextCp = nextCp + 1 }

            cpToByte[cp] = bval
 
 
 
 
 
       let wrote, ee = utf8.Utf8.encode1(cp, tmp, 0L)
 
 
 
 
        if ee != 0 { return TokenizerBpe{}, 1 }
 
 
 
 
 
       let s = tua_str_from_bytes_copy(tmp, 0L, wrote)
 
 
 
 
 
       let o = vocab[s]
 
 
 
 
 
       if o.isSome() {
 
 
 
 
 
           let vid: long = o.unwrap()
                byteToId[bval] = vid
 
           }
            bval = bval + 1
 
       }

 
 
 
 
 
   let out = TokenizerBpe{
            raw: raw,
            vocab: vocab,
            idToToken: idToToken,
            added: added,
            addedList: addedList,
            pairRank: pairRank,
            pairMergeId: pairMergeId,
            byteToId: byteToId,
            cpToByte: cpToByte,
 
       }
 
 
 
 
 
   let _ = mergeCount
 
 
 
 
 
   return out, 0
 
   }

 
 
  fn loadFromGguf(modelDirOrPath: string) -> TokenizerBpe, int {
        // Uses GGUF tokenizer metadata: tokenizer.ggml.tokens + tokenizer.ggml.merges.
 
 
 
 
 
   if modelDirOrPath == null { return TokenizerBpe{}, 1 }
 
 
 
 
 
   let ggufPath: string = modelDirOrPath
 
 
 
 
 
   if !_endsWith(modelDirOrPath, ".gguf") {
 
 
 
 
 
       let p, fe = Gguf.findMainFile(modelDirOrPath)
 
 
 
 
        if fe != 0 { return TokenizerBpe{}, 1 }
            ggufPath = p
 
       }

 
 
 
 
 
   let g, ge = Gguf.parseMmap(ggufPath, 1)
 
 
 
 
    if ge != 0 { return TokenizerBpe{}, 1 }
 
 
 
 
 
   if g.tokens == null || g.merges == null { return TokenizerBpe{}, 1 }
 
 
 
 
 
   let tokensArr: string[] = g.tokens
 
 
 
 
 
   let mergesArr: string[] = g.merges

        // Build vocab map: token string -> id
 
 
 
 
 
   let vocab: map<string, long> = {}
 
 
 
 
 
   let id: int = 0
 
 
 
 
 
   while id < tokensArr.len() {
 
 
 
 
 
       let s: string = tokensArr[id]
            vocab[s] = (long)id
            id = id + 1
 
       }

 
 
 
 
 
   let rankAny: map = null
 
 
 
 
 
   let mergeAny: map = null
 
 
 
 
 
   let mergeCount: long = 0L
 
 
 
 
 
	   let vocabMap: map = vocab
	   let me = tua_llm_bpe_merges_lines_pair_maps(mergesArr, vocabMap, &rankAny, &mergeAny, &mergeCount)
 
 
 
 
 
   if me != 0 || rankAny == null || mergeAny == null { return TokenizerBpe{}, 1 }
 
 
 
 
 
   let pairRank: map<long, long> = rankAny
 
 
 
 
 
   let pairMergeId: map<long, long> = mergeAny

        // GGUF includes special token ids in metadata; keep `added` empty and rely on vocab lookups when needed.
 
 
 
 
 
   let added: map<string, long> = {}
 
 
 
 
 
   let addedList: string[] = {}

        // Build id->token map (vocab only).
 
 
 
 
 
   let idToToken: map<long, string> = {}
 
 
 
 
 
   for tokStr, idVal in vocab {
 
 
 
 
 
       let vid: long = idVal
            idToToken[vid] = tokStr
 
       }

        // Byte-level mapping (GPT-2 style): byte -> unicode cp and inverse cp -> byte.
 
 
 
 
 
   let byteToId: long[] = {}
 
 
 
 
 
   let i: int = 0
 
 
 
 
 
   while i < 256 {
            byteToId.push(-1L)
            i = i + 1
 
       }
 
 
 
 
 
   let cpToByte: map<int, int> = {}

 
 
 
 
 
   let tmp = bstd.Bytes.new(4)
 
 
 
 
 
   let bval: int = 0
 
 
 
 
 
   let nextCp: int = 256
 
 
 
 
 
   while bval < 256 {
 
 
 
 
 
       let cp: int = -1
 
 
 
 
 
       if bval >= 33 && bval <= 126 { cp = bval }
 
 
 
 
 
       else if bval >= 161 && bval <= 172 { cp = bval }
 
 
 
 
 
       else if bval >= 174 && bval <= 255 { cp = bval }
 
 
 
 
 
       else { cp = nextCp; nextCp = nextCp + 1 }

            cpToByte[cp] = bval
 
 
 
 
 
       let wrote, ee = utf8.Utf8.encode1(cp, tmp, 0L)
 
 
 
 
        if ee != 0 { return TokenizerBpe{}, 1 }
 
 
 
 
 
       let s = tua_str_from_bytes_copy(tmp, 0L, wrote)
 
 
 
 
 
       let o = vocab[s]
 
 
 
 
 
       if o.isSome() {
 
 
 
 
 
           let vid: long = o.unwrap()
                byteToId[bval] = vid
 
           }
            bval = bval + 1
 
       }

 
 
 
 
 
   let out = TokenizerBpe{
            raw: g.raw,
            vocab: vocab,
            idToToken: idToToken,
            added: added,
            addedList: addedList,
            pairRank: pairRank,
            pairMergeId: pairMergeId,
            byteToId: byteToId,
            cpToByte: cpToByte,
 
       }
 
 
 
 
 
   let _ = mergeCount
 
 
 
 
 
   return out, 0
 
   }

 
 
  fn idOf(t: TokenizerBpe, s: string) -> long, int {
 
 
 
 
 
   if s == null { return 0L, 1 }
 
 
 
 
 
   let o1 = _mapGetOptStringLong(t.vocab, s)
 
 
 
 
 
   if o1.isSome() { return o1.unwrap(), 0 }
 
 
 
 
 
   let o2 = _mapGetOptStringLong(t.added, s)
 
 
 
 
 
   if o2.isSome() { return o2.unwrap(), 0 }
 
 
 
 
 
   return 0L, 2
 
   }

 
 
  fn addedId(t: TokenizerBpe, s: string) -> long, int {
 
 
 
 
 
   let o = _mapGetOptStringLong(t.added, s)
 
 
 
 
 
   if o.isNone() { return 0L, 2 }
 
 
 
 
 
   let id: long = o.unwrap()
 
 
 
 
 
   return id, 0
 
   }

 
 
  fn encode(t: TokenizerBpe, s: string) -> long[], int {
 
 
 
 
 
   if s == null { return null, 1 }

 
 
 
 
 
   let sb = bstd.Bytes.fromString(s)
 
 
 
 
 
   let n = bstd.Bytes.len(sb)
 
 
 
 
 
   let out: long[] = {}

        // Cache struct fields into locals (tuac has limitations around indexing/calls on non-variables).
 
 
 
 
 
   let addedList: string[] = t.addedList
 
 
 
 
 
   let added: map<string, long> = t.added

        // Fast path: no added tokens.
 
 
 
 
 
   if addedList == null || addedList.len() == 0 {
 
 
 
 
 
       let seg0, e = _encodeSegmentBytes(t, sb, 0L, n)
 
 
 
 
 
       if e != 0 { return null, 1 }
 
 
 
 
 
       let seg: long[] = seg0
 
 
 
 
 
       let si: int = 0
 
 
 
 
 
       while si < seg.len() { out.push(seg[si]); si = si + 1 }
 
 
 
 
 
       return out, 0
 
       }

        // Added token longest-match scan at UTF-8 boundaries.
 
 
 
 
 
   let segStart: long = 0L
 
 
 
 
 
   let i: long = 0L
 
 
 
 
 
   while i < n {
 
 
 
 
 
       let cp, sz, e0 = utf8.Utf8.decode1(sb, i)
 
 
 
 
        if e0 != 0 { return null, 1 }

            // Only attempt matching where it can possibly start (most added tokens start with '<').
 
 
 
 
 
       if cp == 60 {
 
 
 
 
 
           let bestLen: long = 0L
 
 
 
 
 
           let bestId: long = 0L

 
 
 
 
 
           let li: int = 0
 
 
 
 
 
           while li < addedList.len() {
 
 
 
 
 
               let key: string = addedList[li]
 
 
 
 
 
               let o = _mapGetOptStringLong(added, key)
 
 
 
 
 
               if o.isSome() {
 
 
 
 
 
                   let id: long = o.unwrap()
 
 
 
 
 
                   let plen = strlen(key)
 
 
 
 
 
                   if plen > 0L && (i + plen) <= n {
 
 
 
 
 
                       let pA = tua_bytes_data_at(sb, i)
 
 
 
 
 
                       let pB = tua_str_ptr(key)
 
 
 
 
 
                       if pA != null && pB != null {
 
 
 
 
 
                           if memcmp(pA, pB, plen) == 0 {
                                    bestLen = plen
                                    bestId = id
 
 
 
 
 
                               break // addedList is sorted by length desc
 
                               }
 
                           }
 
                       }
 
                   }
                    li = li + 1
 
               }

 
 
 
 
 
           if bestLen > 0L {
 
 
 
 
 
               let seg0, eSeg = _encodeSegmentBytes(t, sb, segStart, i - segStart)
 
 
 
 
 
               if eSeg != 0 { return null, 1 }
 
 
 
 
 
               let seg: long[] = seg0
 
 
 
 
 
               let si: int = 0
 
 
 
 
 
               while si < seg.len() { out.push(seg[si]); si = si + 1 }
                    out.push(bestId)
                    i = i + bestLen
                    segStart = i
 
 
 
 
 
               continue
 
               }
 
           }

            i = i + sz
 
       }

 
 
 
 
 
   let tail0, eTail = _encodeSegmentBytes(t, sb, segStart, n - segStart)
 
 
 
 
 
   if eTail != 0 { return null, 1 }
 
 
 
 
 
   let tail: long[] = tail0
 
 
 
 
 
   let ti: int = 0
 
 
 
 
 
   while ti < tail.len() { out.push(tail[ti]); ti = ti + 1 }
 
 
 
 
 
   return out, 0
 
   }

 
 
  fn encodeNoAdded(t: TokenizerBpe, s: string) -> long[], int {
 
 
 
 
 
   if s == null { return null, 1 }
 
 
 
 
 
   let sb = bstd.Bytes.fromString(s)
 
 
 
 
 
   let n = bstd.Bytes.len(sb)
 
 
 
 
 
   let out, e = _encodeSegmentBytes(t, sb, 0L, n)
 
 
 
 
 
   if e != 0 { return null, 1 }
 
 
 
 
 
   return out, 0
 
   }

 
 
  fn decode(t: TokenizerBpe, ids: long[]) -> string, int {
 
 
 
 
 
   if ids == null { return null, 1 }
 
 
 
 
 
   let de: int = 0
 
 
 
 
 
   let buf = tua_llm_bpe_decode_ids_to_bytes(ids, t.idToToken, &de)
 
 
 
 
 
   if de != 0 || buf == null { return null, 1 }
 
 
 
 
 
   let n = bstd.Bytes.len(buf)
 
 
 
 
 
   return tua_str_from_bytes_copy(buf, 0L, n), 0
 
   }

    // Pure-Tua decode (reference): ids -> token strings -> GPT2 byte-level inverse mapping -> UTF-8 bytes -> string.
    // Returns (string, err). `err!=0` covers missing ids/tokens, invalid UTF-8, or missing cp->byte mapping.
 
 
  fn decode1(t: TokenizerBpe, ids: long[]) -> string, int {
 
 
 
 
 
   if ids == null { return null, 1 }

        // Pass 1: compute output byte length (1 byte per code point in byte-level token string).
 
 
 
 
 
   let outLen: long = 0L
 
 
 
 
 
   let i: int = 0
 
 
 
 
 
   while i < ids.len() {
 
 
 
 
 
       let id: long = ids[i]
 
 
 
 
 
       let oTok = _mapGetOptLongString(t.idToToken, id)
 
 
 
 
 
       if oTok.isNone() { return null, 1 }
 
 
 
 
 
       let tok: string = oTok.unwrap()

 
 
 
 
 
       let tb: bytes = bstd.Bytes.fromString(tok)
 
 
 
 
 
       let n = bstd.Bytes.len(tb)
 
 
 
 
 
       let off: long = 0L
 
 
 
 
 
       while off < n {
 
 
 
 
 
           let cp, sz, ue = utf8.Utf8.decode1(tb, off)
 
 
 
 
            if ue != 0 { return null, 1 }
 
 
 
 
 
           if sz <= 0L { return null, 1 }
 
 
 
 
 
           let ob = _mapGetOptIntInt(t.cpToByte, cp)
 
 
 
 
 
           if ob.isNone() { return null, 1 }
                outLen = outLen + 1L
                off = off + sz
 
           }
            i = i + 1
 
       }

 
 
 
 
 
   let out: bytes = bstd.Bytes.newLongUninit(outLen)
 
 
 
 
 
   if out == null && outLen != 0L { return null, 1 }

        // Pass 2: fill output bytes.
 
 
 
 
 
   let dst: long = 0L
        i = 0
 
 
 
 
 
   while i < ids.len() {
 
 
 
 
 
       let id2: long = ids[i]
 
 
 
 
 
       let oTok2 = _mapGetOptLongString(t.idToToken, id2)
 
 
 
 
 
       if oTok2.isNone() { return null, 1 }
 
 
 
 
 
       let tok2: string = oTok2.unwrap()

 
 
 
 
 
       let tb2: bytes = bstd.Bytes.fromString(tok2)
 
 
 
 
 
       let n2 = bstd.Bytes.len(tb2)
 
 
 
 
 
       let off2: long = 0L
 
 
 
 
 
       while off2 < n2 {
 
 
 
 
 
           let cp2, sz2, ue2 = utf8.Utf8.decode1(tb2, off2)
 
 
 
 
            if ue2 != 0 { return null, 1 }
 
 
 
 
 
           if sz2 <= 0L { return null, 1 }
 
 
 
 
 
           let ob2 = _mapGetOptIntInt(t.cpToByte, cp2)
 
 
 
 
 
           if ob2.isNone() { return null, 1 }
 
 
 
 
 
           let bval: int = ob2.unwrap()
 
 
 
 
 
           let se = bstd.Bytes.setU8(out, dst, bval)
 
 
 
 
 
           if se != 0 { return null, 1 }
                dst = dst + 1L
                off2 = off2 + sz2
 
           }
            i = i + 1
 
       }

 
 
 
 
 
   if dst != outLen { return null, 1 }
 
 
 
 
 
   return tua_str_from_bytes_copy(out, 0L, outLen), 0
 
   }
}
