    private fn _packTensorBF16ToQ4(st: SafeTensorsFile, base: long, name: string, arena: bytes, dstOff: long, m: int, n: int) -> int {
        let te, dataOff, numel = _tensorNumelBF16(st, name)
        if te != 0 { return te }
        let expect: long = (long)m * (long)n
        if numel != expect { return 3 }
        let e = tua_llm_q4_0_pack_bf16(arena, dstOff, st.data, base + dataOff, m, n)
        if e != 0 { return 4 }
        return 0
    }

    private fn _packTensorBF16ToQ4K(st: SafeTensorsFile, base: long, name: string, arena: bytes, dstOff: long, m: int, n: int) -> int {
        let te, dataOff, numel = _tensorNumelBF16(st, name)
        if te != 0 { return te }
        let expect: long = (long)m * (long)n
        if numel != expect { return 3 }
        let e = tua_llm_q4_k_pack_bf16(arena, dstOff, st.data, base + dataOff, m, n)
        if e != 0 { return 4 }
        return 0
    }

    fn loadWeightsQ4(modelPath: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        let z = Qwen3Weights{ dtype: 3, arena: null, offEmbed: 0L, offLmHead: 0L, offNorm: 0L, layerOffs: null, extraOffs: null }

        let e0, st = SafeTensors.parseMmap(modelPath)
        if e0 != 0 { return 10 + e0, z }
        if st.data == null { return 11, z }
        let base: long = 8L + st.headerLen

        let qdim: int = cfg.heads * cfg.headDim
        let kvdim: int = cfg.kvHeads * cfg.headDim
        let qkvdim: int = qdim + 2 * kvdim

        // Pass 1: size (mixed arena: f32 vectors + q4 matrices).
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, _, nEmbed = _tensorNumelBF16(st, "model.embed_tokens.weight")
        if e1 != 0 { return 100 + e1, z }
        if nEmbed != (long)cfg.vocab * (long)cfg.hidden { return 101, z }
        cur = cur + _q4MatBytes(cfg.vocab, cfg.hidden)

        let e2, _, nLm = _tensorNumelBF16(st, "lm_head.weight")
        if e2 == 1 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 200 + e2, z }
            if nLm != (long)cfg.vocab * (long)cfg.hidden { return 201, z }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + _q4MatBytes(cfg.vocab, cfg.hidden)
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, _, nNorm = _tensorNumelBF16(st, "model.norm.weight")
        if e3 != 0 { return 300 + e3, z }
        cur = cur + nNorm * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm/postNorm/qNorm/kNorm (f32 vectors).
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, _, n0 = _tensorNumelBF16(st, pre + "input_layernorm.weight")
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, z }
            cur = cur + n0 * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, _, n1b = _tensorNumelBF16(st, pre + "post_attention_layernorm.weight")
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, z }
            cur = cur + n1b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, _, n2b = _tensorNumelBF16(st, pre + "self_attn.q_norm.weight")
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, z }
            cur = cur + n2b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, _, n3b = _tensorNumelBF16(st, pre + "self_attn.k_norm.weight")
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, z }
            cur = cur + n3b * 4L

            // qkvProj (fused q4 matrix).
            let eq, _, nq = _tensorNumelBF16(st, pre + "self_attn.q_proj.weight")
            if eq != 0 { return 1000 + li * 64 + 4 * 4 + eq, z }
            if nq != (long)qdim * (long)cfg.hidden { return 1000 + li * 64 + 4 * 4 + 3, z }
            let ek, _, nk = _tensorNumelBF16(st, pre + "self_attn.k_proj.weight")
            if ek != 0 { return 1000 + li * 64 + 5 * 4 + ek, z }
            if nk != (long)kvdim * (long)cfg.hidden { return 1000 + li * 64 + 5 * 4 + 3, z }
            let ev, _, nv = _tensorNumelBF16(st, pre + "self_attn.v_proj.weight")
            if ev != 0 { return 1000 + li * 64 + 6 * 4 + ev, z }
            if nv != (long)kvdim * (long)cfg.hidden { return 1000 + li * 64 + 6 * 4 + 3, z }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + _q4MatBytes(qkvdim, cfg.hidden)

            // oProj (q4 matrix [hidden, qdim]).
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, _, n7b = _tensorNumelBF16(st, pre + "self_attn.o_proj.weight")
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, z }
            if n7b != (long)cfg.hidden * (long)qdim { return 1000 + li * 64 + 7 * 4 + 3, z }
            cur = cur + _q4MatBytes(cfg.hidden, qdim)

            // gateUpProj (fused q4 matrix).
            let eg, _, ng = _tensorNumelBF16(st, pre + "mlp.gate_proj.weight")
            if eg != 0 { return 1000 + li * 64 + 8 * 4 + eg, z }
            if ng != (long)cfg.intermediate * (long)cfg.hidden { return 1000 + li * 64 + 8 * 4 + 3, z }
            let eu, _, nu = _tensorNumelBF16(st, pre + "mlp.up_proj.weight")
            if eu != 0 { return 1000 + li * 64 + 9 * 4 + eu, z }
            if nu != (long)cfg.intermediate * (long)cfg.hidden { return 1000 + li * 64 + 9 * 4 + 3, z }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + _q4MatBytes(2 * cfg.intermediate, cfg.hidden)

            // downProj (q4 matrix [hidden, intermediate]).
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10b, _, n10b = _tensorNumelBF16(st, pre + "mlp.down_proj.weight")
            if e10b != 0 { return 1000 + li * 64 + 10 * 4 + e10b, z }
            if n10b != (long)cfg.hidden * (long)cfg.intermediate { return 1000 + li * 64 + 10 * 4 + 3, z }
            cur = cur + _q4MatBytes(cfg.hidden, cfg.intermediate)

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, z }

        // Pass 2: pack/convert.
        let teEmbed = Qwen3._packTensorBF16ToQ4(st, base, "model.embed_tokens.weight", arena, offEmbed, cfg.vocab, cfg.hidden)
        if teEmbed != 0 { return 500 + teEmbed, z }
        if lmIsTied == 0 {
            let teLm = Qwen3._packTensorBF16ToQ4(st, base, "lm_head.weight", arena, offLm, cfg.vocab, cfg.hidden)
            if teLm != 0 { return 600 + teLm, z }
        }
        let ce3, _ = _convertTensorBF16ToF32(st, base, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, z }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm/postNorm/qNorm/kNorm (f32).
            let dstOff0 = layerOffs[idx]
            let e0c, _ = _convertTensorBF16ToF32(st, base, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, z }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = _convertTensorBF16ToF32(st, base, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, z }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, z }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, z }
            idx = idx + 1

            // qkvProj (fused q4).
            let dstQkv = layerOffs[idx]
            let rowbH = _q4RowBytes(cfg.hidden)
            let qDst: long = dstQkv
            let kDst: long = dstQkv + (long)qdim * rowbH
            let vDst: long = dstQkv + (long)(qdim + kvdim) * rowbH
            let eq = Qwen3._packTensorBF16ToQ4(st, base, pre + "self_attn.q_proj.weight", arena, qDst, qdim, cfg.hidden)
            if eq != 0 { return 2000 + idx * 4 + eq, z }
            let ek = Qwen3._packTensorBF16ToQ4(st, base, pre + "self_attn.k_proj.weight", arena, kDst, kvdim, cfg.hidden)
            if ek != 0 { return 2000 + idx * 4 + ek, z }
            let ev = Qwen3._packTensorBF16ToQ4(st, base, pre + "self_attn.v_proj.weight", arena, vDst, kvdim, cfg.hidden)
            if ev != 0 { return 2000 + idx * 4 + ev, z }
            idx = idx + 1

            // oProj (q4).
            let dstO = layerOffs[idx]
            let eo = Qwen3._packTensorBF16ToQ4(st, base, pre + "self_attn.o_proj.weight", arena, dstO, cfg.hidden, qdim)
            if eo != 0 { return 2000 + idx * 4 + eo, z }
            idx = idx + 1

            // gateUpProj (fused q4).
            let dstGateUp = layerOffs[idx]
            let gateDst: long = dstGateUp
            let upDst: long = dstGateUp + (long)cfg.intermediate * rowbH
            let eg = Qwen3._packTensorBF16ToQ4(st, base, pre + "mlp.gate_proj.weight", arena, gateDst, cfg.intermediate, cfg.hidden)
            if eg != 0 { return 2000 + idx * 4 + eg, z }
            let eu = Qwen3._packTensorBF16ToQ4(st, base, pre + "mlp.up_proj.weight", arena, upDst, cfg.intermediate, cfg.hidden)
            if eu != 0 { return 2000 + idx * 4 + eu, z }
            idx = idx + 1

            // downProj (q4).
            let dstDown = layerOffs[idx]
            let ed = Qwen3._packTensorBF16ToQ4(st, base, pre + "mlp.down_proj.weight", arena, dstDown, cfg.hidden, cfg.intermediate)
            if ed != 0 { return 2000 + idx * 4 + ed, z }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 3, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    fn loadWeightsQ4K(modelPath: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        let z = Qwen3Weights{ dtype: 4, arena: null, offEmbed: 0L, offLmHead: 0L, offNorm: 0L, layerOffs: null, extraOffs: null }

        if _q4kRowBytes(cfg.hidden) <= 0L { return 9, z }
        if _q4kRowBytes(cfg.intermediate) <= 0L { return 9, z }

        let e0, st = SafeTensors.parseMmap(modelPath)
        if e0 != 0 { return 10 + e0, z }
        if st.data == null { return 11, z }
        let base: long = 8L + st.headerLen

        let qdim: int = cfg.heads * cfg.headDim
        let kvdim: int = cfg.kvHeads * cfg.headDim
        let qkvdim: int = qdim + 2 * kvdim

        // Pass 1: size (mixed arena: f32 vectors + q4 matrices).
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, _, nEmbed = _tensorNumelBF16(st, "model.embed_tokens.weight")
        if e1 != 0 { return 200 + e1, z }
        if nEmbed != (long)cfg.vocab * (long)cfg.hidden { return 201, z }
        cur = cur + _q4kMatBytes(cfg.vocab, cfg.hidden)

        cur = _align(cur, 64L)
        offLm = cur
        let e2, _, nLm = _tensorNumelBF16(st, "lm_head.weight")
        if e2 == 1 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 202, z }
            if nLm != (long)cfg.vocab * (long)cfg.hidden { return 202, z }
            cur = cur + _q4kMatBytes(cfg.vocab, cfg.hidden)
        }

        // f32 vectors
        cur = _align(cur, 64L)
        offNorm = cur
        let e3, _, nNorm = _tensorNumelBF16(st, "model.norm.weight")
        if e3 != 0 { return 203, z }
        if nNorm != (long)cfg.hidden { return 204, z }
        cur = cur + (long)cfg.hidden * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0b, _, n0b = _tensorNumelBF16(st, pre + "input_layernorm.weight")
            if e0b != 0 { return 1000 + li * 64 + 0 * 4 + e0b, z }
            cur = cur + n0b * 4L

            // postNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, _, n1b = _tensorNumelBF16(st, pre + "post_attention_layernorm.weight")
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, z }
            cur = cur + n1b * 4L

            // qNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, _, n2b = _tensorNumelBF16(st, pre + "self_attn.q_norm.weight")
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, z }
            cur = cur + n2b * 4L

            // kNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, _, n3b = _tensorNumelBF16(st, pre + "self_attn.k_norm.weight")
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, z }
            cur = cur + n3b * 4L

            // qkvProj (fused q4k)
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e4b, _, n4b = _tensorNumelBF16(st, pre + "self_attn.q_proj.weight")
            if e4b != 0 { return 1000 + li * 64 + 4 * 4 + e4b, z }
            let _ = n4b
            cur = cur + _q4kMatBytes(qkvdim, cfg.hidden)

            // oProj (q4k)
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e5b, _, n5b = _tensorNumelBF16(st, pre + "self_attn.o_proj.weight")
            if e5b != 0 { return 1000 + li * 64 + 5 * 4 + e5b, z }
            let _ = n5b
            cur = cur + _q4kMatBytes(cfg.hidden, qdim)

            // gateUpProj (fused q4k)
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e6b, _, n6b = _tensorNumelBF16(st, pre + "mlp.gate_proj.weight")
            if e6b != 0 { return 1000 + li * 64 + 6 * 4 + e6b, z }
            let _ = n6b
            cur = cur + _q4kMatBytes(2 * cfg.intermediate, cfg.hidden)

            // downProj (q4k)
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, _, n7b = _tensorNumelBF16(st, pre + "mlp.down_proj.weight")
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, z }
            let _ = n7b
            cur = cur + _q4kMatBytes(cfg.hidden, cfg.intermediate)

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, z }

        // Pass 2
        let ce = Qwen3._packTensorBF16ToQ4K(st, base, "model.embed_tokens.weight", arena, offEmbed, cfg.vocab, cfg.hidden)
        if ce != 0 { return 500 + ce, z }
        if lmIsTied == 0 {
            let ce2 = Qwen3._packTensorBF16ToQ4K(st, base, "lm_head.weight", arena, offLm, cfg.vocab, cfg.hidden)
            if ce2 != 0 { return 600 + ce2, z }
        }
        let ce3, _ = _convertTensorBF16ToF32(st, base, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, z }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            let dstOff0 = layerOffs[idx]
            let e0c, _ = _convertTensorBF16ToF32(st, base, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, z }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = _convertTensorBF16ToF32(st, base, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, z }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, z }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, z }
            idx = idx + 1

            let rowbH = _q4kRowBytes(cfg.hidden)

            // qkvProj (fused q4k)
            let dstQkv = layerOffs[idx]
            let qDst: long = dstQkv
            let kDst: long = dstQkv + (long)qdim * rowbH
            let vDst: long = dstQkv + (long)(qdim + kvdim) * rowbH
            let eq = Qwen3._packTensorBF16ToQ4K(st, base, pre + "self_attn.q_proj.weight", arena, qDst, qdim, cfg.hidden)
            if eq != 0 { return 2000 + idx * 4 + eq, z }
            let ek = Qwen3._packTensorBF16ToQ4K(st, base, pre + "self_attn.k_proj.weight", arena, kDst, kvdim, cfg.hidden)
            if ek != 0 { return 2000 + idx * 4 + ek, z }
            let ev = Qwen3._packTensorBF16ToQ4K(st, base, pre + "self_attn.v_proj.weight", arena, vDst, kvdim, cfg.hidden)
            if ev != 0 { return 2000 + idx * 4 + ev, z }
            idx = idx + 1

            // oProj
            let dstO = layerOffs[idx]
            let eo = Qwen3._packTensorBF16ToQ4K(st, base, pre + "self_attn.o_proj.weight", arena, dstO, cfg.hidden, qdim)
            if eo != 0 { return 2000 + idx * 4 + eo, z }
            idx = idx + 1

            // gateUpProj (fused q4k)
            let dstGateUp = layerOffs[idx]
            let gateDst: long = dstGateUp
            let upDst: long = dstGateUp + (long)cfg.intermediate * rowbH
            let eg = Qwen3._packTensorBF16ToQ4K(st, base, pre + "mlp.gate_proj.weight", arena, gateDst, cfg.intermediate, cfg.hidden)
            if eg != 0 { return 2000 + idx * 4 + eg, z }
            let eu = Qwen3._packTensorBF16ToQ4K(st, base, pre + "mlp.up_proj.weight", arena, upDst, cfg.intermediate, cfg.hidden)
            if eu != 0 { return 2000 + idx * 4 + eu, z }
            idx = idx + 1

            // downProj
            let dstDown = layerOffs[idx]
            let ed = Qwen3._packTensorBF16ToQ4K(st, base, pre + "mlp.down_proj.weight", arena, dstDown, cfg.hidden, cfg.intermediate)
            if ed != 0 { return 2000 + idx * 4 + ed, z }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 4, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    private fn _loadWeightMap(modelDir: string) -> int, map {
        if modelDir == null { return 1, null }
        let e0, b = bstd.Bytes.mmapFile(modelDir + "/model.safetensors.index.json")
        if e0 != 0 { return 2, null }
        let pe, rootAny = j.Json.parseBytes(b)
        if pe != 0 || rootAny == null { return 3, null }
        let root: map = rootAny
        let opt = root["weight_map"]
        if opt.isNone() { return 4, null }
        let wmAny: any = opt.unwrap()
        if wmAny == null { return 4, null }
        let wm: map = wmAny
        return 0, wm
    }

    private fn _weightFileFor(weightMap: map, tensor: string) -> int, string {
        if weightMap == null || tensor == null { return 1, null }
        let wm: map = weightMap
        let opt = wm[tensor]
        if opt.isNone() { return 2, null }
        let vAny: any = opt.unwrap()
        if vAny == null { return 2, null }
        let v: string = vAny
        return 0, v
    }

    private fn _tensorNumelBF16Sharded(modelDir: string, weightMap: map, name: string) -> int, long {
        // Returns (err, numel)
        if modelDir == null || name == null { return 1, 0L }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2, 0L }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0, 0L }
        let te, dataOff, numel = _tensorNumelBF16(st, name)
        let _ = dataOff
        if te != 0 { return 20 + te, 0L }
        return 0, numel
    }

    private fn _tensorNumelF16Sharded(modelDir: string, weightMap: map, name: string) -> int, long {
        // Returns (err, numel)
        if modelDir == null || name == null { return 1, 0L }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2, 0L }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0, 0L }
        let te, dataOff, numel = _tensorNumelF16(st, name)
        let _ = dataOff
        if te != 0 { return 20 + te, 0L }
        return 0, numel
    }

    private fn _convertBF16ToF32FromSharded(modelDir: string, weightMap: map, name: string, arena: bytes, dstOff: long) -> int, long {
        if modelDir == null || name == null { return 1 }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2, 0L }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0, 0L }
        let base: long = 8L + st.headerLen
        let ce, numel = _convertTensorBF16ToF32(st, base, name, arena, dstOff)
        if ce != 0 { return 20 + ce, 0L }
        return 0, numel
    }

    private fn _packQ4FromSharded(modelDir: string, weightMap: map, name: string, arena: bytes, dstOff: long, m: int, n: int) -> int {
        if modelDir == null || name == null { return 1 }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2 }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0 }
        let base: long = 8L + st.headerLen
        let te, dataOff, numel = _tensorNumelBF16(st, name)
        if te != 0 { return 20 + te }
        let expect: long = (long)m * (long)n
        if numel != expect { return 30 }
        let pe = tua_llm_q4_0_pack_bf16(arena, dstOff, st.data, base + dataOff, m, n)
        if pe != 0 { return 40 }
        return 0
    }

    private fn _packQ4KFromSharded(modelDir: string, weightMap: map, name: string, arena: bytes, dstOff: long, m: int, n: int) -> int {
        if modelDir == null || name == null { return 1 }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2 }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0 }
        let base: long = 8L + st.headerLen
        let te, dataOff, numel = _tensorNumelBF16(st, name)
        if te != 0 { return 20 + te }
        let expect: long = (long)m * (long)n
        if numel != expect { return 30 }
        let pe = tua_llm_q4_k_pack_bf16(arena, dstOff, st.data, base + dataOff, m, n)
        if pe != 0 { return 40 }
        return 0
    }

    fn loadWeightsQ4Auto(modelDir: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        if modelDir == null { return 1, Qwen3Weights{} }
        let eSingle, wSingle = loadWeightsQ4(modelDir + "/model.safetensors", cfg)
        if eSingle == 0 { return 0, move wSingle }

        // Sharded safetensors: use the index + per-shard files.
        let we, weightMap = Qwen3._loadWeightMap(modelDir)
        if we != 0 { return eSingle, Qwen3Weights{} }

        let qdim: int = cfg.heads * cfg.headDim
        let kvdim: int = cfg.kvHeads * cfg.headDim
        let qkvdim: int = qdim + 2 * kvdim

        // Pass 1: size (mixed arena: f32 vectors + q4 matrices).
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, nEmbed = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.embed_tokens.weight")
        if e1 != 0 { return 200 + e1, Qwen3Weights{} }
        if nEmbed != (long)cfg.vocab * (long)cfg.hidden { return 201, Qwen3Weights{} }
        cur = cur + _q4MatBytes(cfg.vocab, cfg.hidden)

        let e2, nLm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "lm_head.weight")
        if e2 == 2 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 250 + e2, Qwen3Weights{} }
            if nLm != (long)cfg.vocab * (long)cfg.hidden { return 251, Qwen3Weights{} }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + _q4MatBytes(cfg.vocab, cfg.hidden)
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, nNorm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.norm.weight")
        if e3 != 0 { return 300 + e3, Qwen3Weights{} }
        cur = cur + nNorm * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, n0 = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "input_layernorm.weight")
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, Qwen3Weights{} }
            cur = cur + n0 * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, n1b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "post_attention_layernorm.weight")
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, Qwen3Weights{} }
            cur = cur + n1b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, n2b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_norm.weight")
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, Qwen3Weights{} }
            cur = cur + n2b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, n3b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.k_norm.weight")
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, Qwen3Weights{} }
            cur = cur + n3b * 4L

            // qkvProj (fused q4 matrix).
            let eq, nq = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_proj.weight")
            if eq != 0 { return 1000 + li * 64 + 4 * 4 + eq, Qwen3Weights{} }
            if nq != (long)qdim * (long)cfg.hidden { return 1000 + li * 64 + 4 * 4 + 3, Qwen3Weights{} }
            let ek, nk = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.k_proj.weight")
            if ek != 0 { return 1000 + li * 64 + 5 * 4 + ek, Qwen3Weights{} }
            if nk != (long)kvdim * (long)cfg.hidden { return 1000 + li * 64 + 5 * 4 + 3, Qwen3Weights{} }
            let ev, nv = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.v_proj.weight")
            if ev != 0 { return 1000 + li * 64 + 6 * 4 + ev, Qwen3Weights{} }
            if nv != (long)kvdim * (long)cfg.hidden { return 1000 + li * 64 + 6 * 4 + 3, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + _q4MatBytes(qkvdim, cfg.hidden)

            // oProj (q4 matrix [hidden, qdim]).
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, n7b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.o_proj.weight")
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, Qwen3Weights{} }
            if n7b != (long)cfg.hidden * (long)qdim { return 1000 + li * 64 + 7 * 4 + 3, Qwen3Weights{} }
            cur = cur + _q4MatBytes(cfg.hidden, qdim)

            // gateUpProj (fused q4 matrix).
            let eg, ng = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.gate_proj.weight")
            if eg != 0 { return 1000 + li * 64 + 8 * 4 + eg, Qwen3Weights{} }
            if ng != (long)cfg.intermediate * (long)cfg.hidden { return 1000 + li * 64 + 8 * 4 + 3, Qwen3Weights{} }
            let eu, nu = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.up_proj.weight")
            if eu != 0 { return 1000 + li * 64 + 9 * 4 + eu, Qwen3Weights{} }
            if nu != (long)cfg.intermediate * (long)cfg.hidden { return 1000 + li * 64 + 9 * 4 + 3, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + _q4MatBytes(2 * cfg.intermediate, cfg.hidden)

            // downProj (q4 matrix [hidden, intermediate]).
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10b, n10b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.down_proj.weight")
            if e10b != 0 { return 1000 + li * 64 + 10 * 4 + e10b, Qwen3Weights{} }
            if n10b != (long)cfg.hidden * (long)cfg.intermediate { return 1000 + li * 64 + 10 * 4 + 3, Qwen3Weights{} }
            cur = cur + _q4MatBytes(cfg.hidden, cfg.intermediate)

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, Qwen3Weights{} }

        // Pass 2: pack/convert.
        let pe = Qwen3._packQ4FromSharded(modelDir, weightMap, "model.embed_tokens.weight", arena, offEmbed, cfg.vocab, cfg.hidden)
        if pe != 0 { return 500 + pe, Qwen3Weights{} }
        if lmIsTied == 0 {
            let pe2 = Qwen3._packQ4FromSharded(modelDir, weightMap, "lm_head.weight", arena, offLm, cfg.vocab, cfg.hidden)
            if pe2 != 0 { return 600 + pe2, Qwen3Weights{} }
        }
        let ce3, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, Qwen3Weights{} }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            let dstOff0 = layerOffs[idx]
            let e0c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, Qwen3Weights{} }
            idx = idx + 1

            let dstQkv = layerOffs[idx]
            let rowbH = _q4RowBytes(cfg.hidden)
            let qDst: long = dstQkv
            let kDst: long = dstQkv + (long)qdim * rowbH
            let vDst: long = dstQkv + (long)(qdim + kvdim) * rowbH
            let eq = Qwen3._packQ4FromSharded(modelDir, weightMap, pre + "self_attn.q_proj.weight", arena, qDst, qdim, cfg.hidden)
            if eq != 0 { return 2000 + idx * 4 + eq, Qwen3Weights{} }
            let ek = Qwen3._packQ4FromSharded(modelDir, weightMap, pre + "self_attn.k_proj.weight", arena, kDst, kvdim, cfg.hidden)
            if ek != 0 { return 2000 + idx * 4 + ek, Qwen3Weights{} }
            let ev = Qwen3._packQ4FromSharded(modelDir, weightMap, pre + "self_attn.v_proj.weight", arena, vDst, kvdim, cfg.hidden)
            if ev != 0 { return 2000 + idx * 4 + ev, Qwen3Weights{} }
            idx = idx + 1

            let dstO = layerOffs[idx]
            let eo = Qwen3._packQ4FromSharded(modelDir, weightMap, pre + "self_attn.o_proj.weight", arena, dstO, cfg.hidden, qdim)
            if eo != 0 { return 2000 + idx * 4 + eo, Qwen3Weights{} }
            idx = idx + 1

            let dstGateUp = layerOffs[idx]
            let gateDst: long = dstGateUp
            let upDst: long = dstGateUp + (long)cfg.intermediate * rowbH
            let eg = Qwen3._packQ4FromSharded(modelDir, weightMap, pre + "mlp.gate_proj.weight", arena, gateDst, cfg.intermediate, cfg.hidden)
            if eg != 0 { return 2000 + idx * 4 + eg, Qwen3Weights{} }
            let eu = Qwen3._packQ4FromSharded(modelDir, weightMap, pre + "mlp.up_proj.weight", arena, upDst, cfg.intermediate, cfg.hidden)
            if eu != 0 { return 2000 + idx * 4 + eu, Qwen3Weights{} }
            idx = idx + 1

            let dstDown = layerOffs[idx]
            let ed = Qwen3._packQ4FromSharded(modelDir, weightMap, pre + "mlp.down_proj.weight", arena, dstDown, cfg.hidden, cfg.intermediate)
            if ed != 0 { return 2000 + idx * 4 + ed, Qwen3Weights{} }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 3, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    fn loadWeightsQ4KAuto(modelDir: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        if modelDir == null { return 1, Qwen3Weights{} }
        let eSingle, wSingle = loadWeightsQ4K(modelDir + "/model.safetensors", cfg)
        if eSingle == 0 { return 0, move wSingle }

        let we, weightMap = Qwen3._loadWeightMap(modelDir)
        if we != 0 { return eSingle, Qwen3Weights{} }

        if _q4kRowBytes(cfg.hidden) <= 0L { return 2, Qwen3Weights{} }
        if _q4kRowBytes(cfg.intermediate) <= 0L { return 2, Qwen3Weights{} }

        let qdim: int = cfg.heads * cfg.headDim
        let kvdim: int = cfg.kvHeads * cfg.headDim
        let qkvdim: int = qdim + 2 * kvdim

        // Pass 1: size (mixed arena: f32 vectors + q4k matrices).
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, nEmbed = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.embed_tokens.weight")
        if e1 != 0 { return 200 + e1, Qwen3Weights{} }
        if nEmbed != (long)cfg.vocab * (long)cfg.hidden { return 201, Qwen3Weights{} }
        cur = cur + _q4kMatBytes(cfg.vocab, cfg.hidden)

        let e2, nLm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "lm_head.weight")
        if e2 == 2 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 250 + e2, Qwen3Weights{} }
            if nLm != (long)cfg.vocab * (long)cfg.hidden { return 251, Qwen3Weights{} }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + _q4kMatBytes(cfg.vocab, cfg.hidden)
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, nNorm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.norm.weight")
        if e3 != 0 { return 300 + e3, Qwen3Weights{} }
        cur = cur + nNorm * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, n0 = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "input_layernorm.weight")
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, Qwen3Weights{} }
            cur = cur + n0 * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, n1b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "post_attention_layernorm.weight")
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, Qwen3Weights{} }
            cur = cur + n1b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, n2b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_norm.weight")
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, Qwen3Weights{} }
            cur = cur + n2b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, n3b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.k_norm.weight")
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, Qwen3Weights{} }
            cur = cur + n3b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e4b, n4b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_proj.weight")
            if e4b != 0 { return 1000 + li * 64 + 4 * 4 + e4b, Qwen3Weights{} }
            if n4b != (long)qdim * (long)cfg.hidden { return 1000 + li * 64 + 4 * 4 + 3, Qwen3Weights{} }
            cur = cur + _q4kMatBytes(qkvdim, cfg.hidden)

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7, n7 = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.o_proj.weight")
            if e7 != 0 { return 1000 + li * 64 + 7 * 4 + e7, Qwen3Weights{} }
            if n7 != (long)cfg.hidden * (long)qdim { return 1000 + li * 64 + 7 * 4 + 3, Qwen3Weights{} }
            cur = cur + _q4kMatBytes(cfg.hidden, qdim)

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e8, n8 = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.gate_proj.weight")
            if e8 != 0 { return 1000 + li * 64 + 8 * 4 + e8, Qwen3Weights{} }
            if n8 != (long)cfg.intermediate * (long)cfg.hidden { return 1000 + li * 64 + 8 * 4 + 3, Qwen3Weights{} }
            cur = cur + _q4kMatBytes(2 * cfg.intermediate, cfg.hidden)

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10, n10 = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.down_proj.weight")
            if e10 != 0 { return 1000 + li * 64 + 10 * 4 + e10, Qwen3Weights{} }
            if n10 != (long)cfg.hidden * (long)cfg.intermediate { return 1000 + li * 64 + 10 * 4 + 3, Qwen3Weights{} }
            cur = cur + _q4kMatBytes(cfg.hidden, cfg.intermediate)

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, Qwen3Weights{} }

        // Pass 2: pack/convert.
        let pe = Qwen3._packQ4KFromSharded(modelDir, weightMap, "model.embed_tokens.weight", arena, offEmbed, cfg.vocab, cfg.hidden)
        if pe != 0 { return 500 + pe, Qwen3Weights{} }
        if lmIsTied == 0 {
            let pe2 = Qwen3._packQ4KFromSharded(modelDir, weightMap, "lm_head.weight", arena, offLm, cfg.vocab, cfg.hidden)
            if pe2 != 0 { return 600 + pe2, Qwen3Weights{} }
        }
        let ce3, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, Qwen3Weights{} }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            let dstOff0 = layerOffs[idx]
            let e0c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, Qwen3Weights{} }
            idx = idx + 1

            let dstQkv = layerOffs[idx]
            let rowbH = _q4kRowBytes(cfg.hidden)
            let qDst: long = dstQkv
            let kDst: long = dstQkv + (long)qdim * rowbH
            let vDst: long = dstQkv + (long)(qdim + kvdim) * rowbH
            let eq = Qwen3._packQ4KFromSharded(modelDir, weightMap, pre + "self_attn.q_proj.weight", arena, qDst, qdim, cfg.hidden)
            if eq != 0 { return 2000 + idx * 4 + eq, Qwen3Weights{} }
            let ek = Qwen3._packQ4KFromSharded(modelDir, weightMap, pre + "self_attn.k_proj.weight", arena, kDst, kvdim, cfg.hidden)
            if ek != 0 { return 2000 + idx * 4 + ek, Qwen3Weights{} }
            let ev = Qwen3._packQ4KFromSharded(modelDir, weightMap, pre + "self_attn.v_proj.weight", arena, vDst, kvdim, cfg.hidden)
            if ev != 0 { return 2000 + idx * 4 + ev, Qwen3Weights{} }
            idx = idx + 1

            let dstO = layerOffs[idx]
            let eo = Qwen3._packQ4KFromSharded(modelDir, weightMap, pre + "self_attn.o_proj.weight", arena, dstO, cfg.hidden, qdim)
            if eo != 0 { return 2000 + idx * 4 + eo, Qwen3Weights{} }
            idx = idx + 1

            let dstGateUp = layerOffs[idx]
            let gateDst: long = dstGateUp
            let upDst: long = dstGateUp + (long)cfg.intermediate * rowbH
            let eg = Qwen3._packQ4KFromSharded(modelDir, weightMap, pre + "mlp.gate_proj.weight", arena, gateDst, cfg.intermediate, cfg.hidden)
            if eg != 0 { return 2000 + idx * 4 + eg, Qwen3Weights{} }
            let eu = Qwen3._packQ4KFromSharded(modelDir, weightMap, pre + "mlp.up_proj.weight", arena, upDst, cfg.intermediate, cfg.hidden)
            if eu != 0 { return 2000 + idx * 4 + eu, Qwen3Weights{} }
            idx = idx + 1

            let dstDown = layerOffs[idx]
            let ed = Qwen3._packQ4KFromSharded(modelDir, weightMap, pre + "mlp.down_proj.weight", arena, dstDown, cfg.hidden, cfg.intermediate)
            if ed != 0 { return 2000 + idx * 4 + ed, Qwen3Weights{} }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 4, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    private fn _ggufCopyRaw(let g: GgufFile, name: string, arena: bytes, dstOff: long, nbytes: long) -> int {
        let e, ti = Gguf.tensorInfo(g, name)
        if e != 0 { return 1 }
        let srcOff: long = g.dataStart + ti.off
        if bstd.Bytes.copy(arena, dstOff, g.raw, srcOff, nbytes) != 0 { return 2 }
        return 0
    }

    fn loadWeightsGgufQ4KM(modelDir: string, let cfg: Qwen3Config) -> int, Qwen3Weights {
        // Load pre-quantized GGUF (Q4_K + Q6_K mix) into a single arena.
        let z = Qwen3Weights{ dtype: 5, arena: null, offEmbed: 0L, offLmHead: 0L, offNorm: 0L, layerOffs: null, extraOffs: null }
        if modelDir == null { return 1, z }

        let fe, ggufPath = Gguf.findMainFile(modelDir)
        if fe != 0 { return 3, z }
        let ge, g = Gguf.parseMmap(ggufPath, 0)
        if ge != 0 { return 4, z }
        if g.raw == null { return 4, z }

        let eEmb0, tiEmb0 = Gguf.tensorInfo(g, "token_embd.weight")
        if eEmb0 != 0 { return 100, z }
        if tiEmb0.t != 14 || tiEmb0.nd != 2 { return 101, z } // Q6_K
        let hidden: int = (int)tiEmb0.d0
        let vocab: int = (int)tiEmb0.d1
        let layers: int = g.blockCount
        let intermediate: int = g.ffn
        let heads: int = g.heads
        let kvHeads: int = g.kvHeads
        let headDim: int = g.headDim
        if hidden <= 0 || vocab <= 0 || layers <= 0 || intermediate <= 0 || heads <= 0 || kvHeads <= 0 || headDim <= 0 { return 2, z }

        if _q4kRowBytes(hidden) <= 0L { return 2, z }
        if _q4kRowBytes(intermediate) <= 0L { return 2, z }
        if _q6kRowBytes(hidden) <= 0L { return 2, z }
        if _q6kRowBytes(intermediate) <= 0L { return 2, z }

        let qdim: int = heads * headDim
        let kvdim: int = kvHeads * headDim

        // Pass 1: size.
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}
        let extraOffs: long[] = {} // per-layer: [kOff, vOff, upOff]

        cur = _align(cur, 64L)
        offEmbed = cur
        cur = cur + _q6kMatBytes(vocab, hidden)

        let eOut, _ = Gguf.tensorInfo(g, "output.weight")
        if eOut != 0 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + _q6kMatBytes(vocab, hidden)
        }

        cur = _align(cur, 64L)
        offNorm = cur
        cur = cur + (long)hidden * 4L

        let li: int = 0
        while li < layers {
            cur = _align(cur, 64L); layerOffs.push(cur); cur = cur + (long)hidden * 4L // attn_norm
            cur = _align(cur, 64L); layerOffs.push(cur); cur = cur + (long)hidden * 4L // ffn_norm
            cur = _align(cur, 64L); layerOffs.push(cur); cur = cur + (long)headDim * 4L // q_norm
            cur = _align(cur, 64L); layerOffs.push(cur); cur = cur + (long)headDim * 4L // k_norm

            cur = _align(cur, 64L); layerOffs.push(cur); cur = cur + _q4kMatBytes(qdim, hidden) // q
            cur = _align(cur, 64L); extraOffs.push(cur); cur = cur + _q4kMatBytes(kvdim, hidden) // k
            // v can be Q4_K or Q6_K in Q4_K_M.
            cur = _align(cur, 64L)
            let vOff: long = cur
            let vName: string = _ggufBlkTensorName(li, "attn_v.weight")
            if vName == null { return 2200 + li, z }
            let ev0, vti = Gguf.tensorInfo(g, vName)
            if ev0 != 0 || vti.nd != 2 || (int)vti.d0 != hidden || (int)vti.d1 != kvdim { return 2200 + li, z }
            let vKind: int = -1
            if vti.t == 12 { vKind = 0 } else if vti.t == 14 { vKind = 1 } else { return 2200 + li, z }
            extraOffs.push(_packOffKind(vOff, vKind))
            if vKind == 0 {
                cur = cur + _q4kMatBytes(kvdim, hidden)
            } else {
                cur = cur + _q6kMatBytes(kvdim, hidden)
            }

            cur = _align(cur, 64L); layerOffs.push(cur); cur = cur + _q4kMatBytes(hidden, qdim) // o

            cur = _align(cur, 64L); layerOffs.push(cur); cur = cur + _q4kMatBytes(intermediate, hidden) // gate
            cur = _align(cur, 64L); extraOffs.push(cur); cur = cur + _q4kMatBytes(intermediate, hidden) // up

            // down can be Q4_K or Q6_K in Q4_K_M; store packed (off, kind) in layerOffs for this slot.
            cur = _align(cur, 64L)
            let downOff: long = cur
            let downName: string = _ggufBlkTensorName(li, "ffn_down.weight")
            if downName == null { return 2400 + li, z }
            let ed0, dti = Gguf.tensorInfo(g, downName)
            if ed0 != 0 || dti.nd != 2 || (int)dti.d0 != intermediate || (int)dti.d1 != hidden { return 2400 + li, z }
            let downKind: int = -1
            if dti.t == 12 { downKind = 0 } else if dti.t == 14 { downKind = 1 } else { return 2400 + li, z }
            layerOffs.push(_packOffKind(downOff, downKind))
            if downKind == 0 {
                cur = cur + _q4kMatBytes(hidden, intermediate)
            } else {
                cur = cur + _q6kMatBytes(hidden, intermediate)
            }

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, z }

        // Pass 2: copy.
        let eEmb, tiEmb = Gguf.tensorInfo(g, "token_embd.weight")
        if eEmb != 0 { return 100, z }
        if tiEmb.t != 14 || tiEmb.nd != 2 || (int)tiEmb.d0 != hidden || (int)tiEmb.d1 != vocab { return 101, z }
        if Qwen3._ggufCopyRaw(g, "token_embd.weight", arena, offEmbed, _q6kMatBytes(vocab, hidden)) != 0 { return 102, z }

        if lmIsTied == 0 {
            let eLm, tiLm = Gguf.tensorInfo(g, "output.weight")
            if eLm != 0 { return 110, z }
            if tiLm.t != 14 || tiLm.nd != 2 || (int)tiLm.d0 != hidden || (int)tiLm.d1 != vocab { return 111, z }
            if Qwen3._ggufCopyRaw(g, "output.weight", arena, offLm, _q6kMatBytes(vocab, hidden)) != 0 { return 112, z }
        }

        let eOn, tiOn = Gguf.tensorInfo(g, "output_norm.weight")
        if eOn != 0 { return 120, z }
        if tiOn.t != 0 || tiOn.nd != 1 { return 121, z }
        let hiddenOn: int = (int)tiOn.d0
        if hiddenOn <= 0 { return 121, z }
        if hiddenOn != hidden { hidden = hiddenOn }
        if Qwen3._ggufCopyRaw(g, "output_norm.weight", arena, offNorm, (long)hiddenOn * 4L) != 0 { return 122, z }

        // layers
        let idx: int = 0
        li = 0
        while li < layers {
            let name0: string = _ggufBlkTensorName(li, "attn_norm.weight")
            if name0 == null { return 2000 + idx, z }
            let inOff = layerOffs[idx]
            let e0, ti0 = Gguf.tensorInfo(g, name0)
            if e0 != 0 || ti0.t != 0 || ti0.nd != 1 || (int)ti0.d0 != hidden { return 2000 + idx, z }
            if Qwen3._ggufCopyRaw(g, name0, arena, inOff, (long)hidden * 4L) != 0 { return 2000 + idx, z }
            idx = idx + 1

            let name1: string = _ggufBlkTensorName(li, "ffn_norm.weight")
            if name1 == null { return 2000 + idx, z }
            let postOff = layerOffs[idx]
            let e1, ti1 = Gguf.tensorInfo(g, name1)
            if e1 != 0 || ti1.t != 0 || ti1.nd != 1 || (int)ti1.d0 != hidden { return 2000 + idx, z }
            if Qwen3._ggufCopyRaw(g, name1, arena, postOff, (long)hidden * 4L) != 0 { return 2000 + idx, z }
            idx = idx + 1

            let name2: string = _ggufBlkTensorName(li, "attn_q_norm.weight")
            if name2 == null { return 2000 + idx, z }
            let qnOff = layerOffs[idx]
            let e2, ti2 = Gguf.tensorInfo(g, name2)
            if e2 != 0 || ti2.t != 0 || ti2.nd != 1 || (int)ti2.d0 != headDim { return 2000 + idx, z }
            if Qwen3._ggufCopyRaw(g, name2, arena, qnOff, (long)headDim * 4L) != 0 { return 2000 + idx, z }
            idx = idx + 1

            let name3: string = _ggufBlkTensorName(li, "attn_k_norm.weight")
            if name3 == null { return 2000 + idx, z }
            let knOff = layerOffs[idx]
            let e3, ti3 = Gguf.tensorInfo(g, name3)
            if e3 != 0 || ti3.t != 0 || ti3.nd != 1 || (int)ti3.d0 != headDim { return 2000 + idx, z }
            if Qwen3._ggufCopyRaw(g, name3, arena, knOff, (long)headDim * 4L) != 0 { return 2000 + idx, z }
            idx = idx + 1

            let qOff = layerOffs[idx]
            let name4: string = _ggufBlkTensorName(li, "attn_q.weight")
            if name4 == null { return 2000 + idx, z }
            let e4, ti4 = Gguf.tensorInfo(g, name4)
            if e4 != 0 || ti4.t != 12 || ti4.nd != 2 || (int)ti4.d0 != hidden || (int)ti4.d1 != qdim { return 2000 + idx, z }
            if Qwen3._ggufCopyRaw(g, name4, arena, qOff, _q4kMatBytes(qdim, hidden)) != 0 { return 2000 + idx, z }
            idx = idx + 1

            let ekOff: long = extraOffs[li * 3 + 0]
            let evPacked: long = extraOffs[li * 3 + 1]
            let vKind: int = _unpackKind(evPacked)
            let evOff: long = _unpackOff(evPacked)

            let name5: string = _ggufBlkTensorName(li, "attn_k.weight")
            if name5 == null { return 2100 + li, z }
            let e5, ti5 = Gguf.tensorInfo(g, name5)
            if e5 != 0 || ti5.t != 12 || ti5.nd != 2 || (int)ti5.d0 != hidden || (int)ti5.d1 != kvdim { return 2100 + li, z }
            if Qwen3._ggufCopyRaw(g, name5, arena, ekOff, _q4kMatBytes(kvdim, hidden)) != 0 { return 2100 + li, z }

            let name6: string = _ggufBlkTensorName(li, "attn_v.weight")
            if name6 == null { return 2200 + li, z }
            let e6, ti6 = Gguf.tensorInfo(g, name6)
            if vKind == 0 {
                if e6 != 0 || ti6.t != 12 || ti6.nd != 2 || (int)ti6.d0 != hidden || (int)ti6.d1 != kvdim { return 2200 + li, z }
                if Qwen3._ggufCopyRaw(g, name6, arena, evOff, _q4kMatBytes(kvdim, hidden)) != 0 { return 2200 + li, z }
            } else {
                if e6 != 0 || ti6.t != 14 || ti6.nd != 2 || (int)ti6.d0 != hidden || (int)ti6.d1 != kvdim { return 2200 + li, z }
                if Qwen3._ggufCopyRaw(g, name6, arena, evOff, _q6kMatBytes(kvdim, hidden)) != 0 { return 2200 + li, z }
            }

            let oOff = layerOffs[idx]
            let name7: string = _ggufBlkTensorName(li, "attn_output.weight")
            if name7 == null { return 2000 + idx, z }
            let e7, ti7 = Gguf.tensorInfo(g, name7)
            if e7 != 0 || ti7.t != 12 || ti7.nd != 2 || (int)ti7.d0 != qdim || (int)ti7.d1 != hidden { return 2000 + idx, z }
            if Qwen3._ggufCopyRaw(g, name7, arena, oOff, _q4kMatBytes(hidden, qdim)) != 0 { return 2000 + idx, z }
            idx = idx + 1

            let gateOff = layerOffs[idx]
            let name8: string = _ggufBlkTensorName(li, "ffn_gate.weight")
            if name8 == null { return 2000 + idx, z }
            let e8, ti8 = Gguf.tensorInfo(g, name8)
            if e8 != 0 || ti8.t != 12 || ti8.nd != 2 || (int)ti8.d0 != hidden || (int)ti8.d1 != intermediate { return 2000 + idx, z }
            if Qwen3._ggufCopyRaw(g, name8, arena, gateOff, _q4kMatBytes(intermediate, hidden)) != 0 { return 2000 + idx, z }
            idx = idx + 1

            let upOff: long = extraOffs[li * 3 + 2]
            let name9: string = _ggufBlkTensorName(li, "ffn_up.weight")
            if name9 == null { return 2300 + li, z }
            let e9, ti9 = Gguf.tensorInfo(g, name9)
            if e9 != 0 || ti9.t != 12 || ti9.nd != 2 || (int)ti9.d0 != hidden || (int)ti9.d1 != intermediate { return 2300 + li, z }
            if Qwen3._ggufCopyRaw(g, name9, arena, upOff, _q4kMatBytes(intermediate, hidden)) != 0 { return 2300 + li, z }

            let downPacked: long = layerOffs[idx]
            let downKind: int = _unpackKind(downPacked)
            let downOff: long = _unpackOff(downPacked)
            let name10: string = _ggufBlkTensorName(li, "ffn_down.weight")
            if name10 == null { return 2000 + idx, z }
            let e10, ti10 = Gguf.tensorInfo(g, name10)
            if downKind == 0 {
                if e10 != 0 || ti10.t != 12 || ti10.nd != 2 || (int)ti10.d0 != intermediate || (int)ti10.d1 != hidden { return 2000 + idx, z }
                if Qwen3._ggufCopyRaw(g, name10, arena, downOff, _q4kMatBytes(hidden, intermediate)) != 0 { return 2000 + idx, z }
            } else {
                if e10 != 0 || ti10.t != 14 || ti10.nd != 2 || (int)ti10.d0 != intermediate || (int)ti10.d1 != hidden { return 2000 + idx, z }
                if Qwen3._ggufCopyRaw(g, name10, arena, downOff, _q6kMatBytes(hidden, intermediate)) != 0 { return 2000 + idx, z }
            }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 5, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: extraOffs }
        return 0, out
    }

    fn loadWeightsF32Auto(modelDir: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        if modelDir == null { return 1, Qwen3Weights{} }
        let eSingle, wSingle = loadWeightsF32(modelDir + "/model.safetensors", cfg)
        if eSingle == 0 { return 0, move wSingle }

        // Sharded safetensors: use the index + per-shard files.
        let we, weightMap = Qwen3._loadWeightMap(modelDir)
        if we != 0 { return eSingle, Qwen3Weights{} }

        // Pass 1: size.
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, nEmbed = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.embed_tokens.weight")
        if e1 != 0 { return 200 + e1, Qwen3Weights{} }
        cur = cur + nEmbed * 4L

        let e2, nLm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "lm_head.weight")
        if e2 == 2 {
            // Missing lm_head in sharded checkpoint: assume tied embeddings.
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 250 + e2, Qwen3Weights{} }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + nLm * 4L
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, nNorm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.norm.weight")
        if e3 != 0 { return 300 + e3, Qwen3Weights{} }
        cur = cur + nNorm * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, n0 = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "input_layernorm.weight")
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, Qwen3Weights{} }
            cur = cur + n0 * 4L

            // postNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, n1b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "post_attention_layernorm.weight")
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, Qwen3Weights{} }
            cur = cur + n1b * 4L

            // qNorm/kNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, n2b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_norm.weight")
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, Qwen3Weights{} }
            cur = cur + n2b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, n3b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.k_norm.weight")
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, Qwen3Weights{} }
            cur = cur + n3b * 4L

            // qkvProj (fused)
            let eq, nq = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_proj.weight")
            if eq != 0 { return 1000 + li * 64 + 4 * 4 + eq, Qwen3Weights{} }
            let ek, nk = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.k_proj.weight")
            if ek != 0 { return 1000 + li * 64 + 5 * 4 + ek, Qwen3Weights{} }
            let ev, nv = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.v_proj.weight")
            if ev != 0 { return 1000 + li * 64 + 6 * 4 + ev, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (nq + nk + nv) * 4L

            // oProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, n7b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.o_proj.weight")
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, Qwen3Weights{} }
            cur = cur + n7b * 4L

            // gateUpProj (fused)
            let eg, ng = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.gate_proj.weight")
            if eg != 0 { return 1000 + li * 64 + 8 * 4 + eg, Qwen3Weights{} }
            let eu, nu = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.up_proj.weight")
            if eu != 0 { return 1000 + li * 64 + 9 * 4 + eu, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (ng + nu) * 4L

            // downProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10b, n10b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.down_proj.weight")
            if e10b != 0 { return 1000 + li * 64 + 10 * 4 + e10b, Qwen3Weights{} }
            cur = cur + n10b * 4L

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, Qwen3Weights{} }

        // Pass 2: convert.
        let ce, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "model.embed_tokens.weight", arena, offEmbed)
        if ce != 0 { return 500 + ce, Qwen3Weights{} }
        if lmIsTied == 0 {
            let ce2, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "lm_head.weight", arena, offLm)
            if ce2 != 0 { return 600 + ce2, Qwen3Weights{} }
        }
        let ce3, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, Qwen3Weights{} }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            let dstOff0 = layerOffs[idx]
            let e0c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, Qwen3Weights{} }
            idx = idx + 1

            let dstQkv = layerOffs[idx]
            let eq, nQ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.q_proj.weight", arena, dstQkv)
            if eq != 0 { return 2000 + idx * 4 + eq, Qwen3Weights{} }
            let kDst: long = dstQkv + nQ * 4L
            let ek, nK = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.k_proj.weight", arena, kDst)
            if ek != 0 { return 2000 + idx * 4 + ek, Qwen3Weights{} }
            let vDst: long = kDst + nK * 4L
            let ev, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.v_proj.weight", arena, vDst)
            if ev != 0 { return 2000 + idx * 4 + ev, Qwen3Weights{} }
            idx = idx + 1

            let dstO = layerOffs[idx]
            let eo, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "self_attn.o_proj.weight", arena, dstO)
            if eo != 0 { return 2000 + idx * 4 + eo, Qwen3Weights{} }
            idx = idx + 1

            let dstGateUp = layerOffs[idx]
            let eg, nGate = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "mlp.gate_proj.weight", arena, dstGateUp)
            if eg != 0 { return 2000 + idx * 4 + eg, Qwen3Weights{} }
            let upDst: long = dstGateUp + nGate * 4L
            let eu, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "mlp.up_proj.weight", arena, upDst)
            if eu != 0 { return 2000 + idx * 4 + eu, Qwen3Weights{} }
            idx = idx + 1

            let dstDown = layerOffs[idx]
            let ed, _ = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, pre + "mlp.down_proj.weight", arena, dstDown)
            if ed != 0 { return 2000 + idx * 4 + ed, Qwen3Weights{} }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 0, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    private fn _copyBF16FromSharded(modelDir: string, weightMap: map, name: string, arena: bytes, dstOff: long) -> int, long {
        if modelDir == null || name == null { return 1, 0L }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2, 0L }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0, 0L }
        let base: long = 8L + st.headerLen
        let ce, numel = Qwen3._copyTensorBF16(st, base, name, arena, dstOff)
        if ce != 0 { return 20 + ce, 0L }
        return 0, numel
    }

    private fn _copyF16FromSharded(modelDir: string, weightMap: map, name: string, arena: bytes, dstOff: long) -> int, long {
        if modelDir == null || name == null { return 1, 0L }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2, 0L }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0, 0L }
        let base: long = 8L + st.headerLen
        let ce, numel = Qwen3._copyTensorF16(st, base, name, arena, dstOff)
        if ce != 0 { return 20 + ce, 0L }
        return 0, numel
    }

    fn loadWeightsBF16Auto(modelDir: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        if modelDir == null { return 1, Qwen3Weights{} }
        let eSingle, wSingle = loadWeightsBF16(modelDir + "/model.safetensors", cfg)
        if eSingle == 0 { return 0, move wSingle }

        // Sharded safetensors: use the index + per-shard files.
        let we, weightMap = Qwen3._loadWeightMap(modelDir)
        if we != 0 { return eSingle, Qwen3Weights{} }

        // Pass 1: size (bf16 bytes).
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, nEmbed = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.embed_tokens.weight")
        if e1 != 0 { return 200 + e1, Qwen3Weights{} }
        cur = cur + nEmbed * 2L

        let e2, nLm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "lm_head.weight")
        if e2 == 2 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 250 + e2, Qwen3Weights{} }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + nLm * 2L
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, nNorm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.norm.weight")
        if e3 != 0 { return 300 + e3, Qwen3Weights{} }
        cur = cur + nNorm * 2L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, n0 = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "input_layernorm.weight")
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, Qwen3Weights{} }
            cur = cur + n0 * 2L

            // postNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, n1b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "post_attention_layernorm.weight")
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, Qwen3Weights{} }
            cur = cur + n1b * 2L

            // qNorm/kNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, n2b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_norm.weight")
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, Qwen3Weights{} }
            cur = cur + n2b * 2L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, n3b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.k_norm.weight")
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, Qwen3Weights{} }
            cur = cur + n3b * 2L

            // qkvProj (fused)
            let eq, nq = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.q_proj.weight")
            if eq != 0 { return 1000 + li * 64 + 4 * 4 + eq, Qwen3Weights{} }
            let ek, nk = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.k_proj.weight")
            if ek != 0 { return 1000 + li * 64 + 5 * 4 + ek, Qwen3Weights{} }
            let ev, nv = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.v_proj.weight")
            if ev != 0 { return 1000 + li * 64 + 6 * 4 + ev, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (nq + nk + nv) * 2L

            // oProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, n7b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "self_attn.o_proj.weight")
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, Qwen3Weights{} }
            cur = cur + n7b * 2L

            // gateUpProj (fused)
            let eg, ng = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.gate_proj.weight")
            if eg != 0 { return 1000 + li * 64 + 8 * 4 + eg, Qwen3Weights{} }
            let eu, nu = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.up_proj.weight")
            if eu != 0 { return 1000 + li * 64 + 9 * 4 + eu, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (ng + nu) * 2L

            // downProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10b, n10b = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, pre + "mlp.down_proj.weight")
            if e10b != 0 { return 1000 + li * 64 + 10 * 4 + e10b, Qwen3Weights{} }
            cur = cur + n10b * 2L

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, Qwen3Weights{} }

        // Pass 2: copy bf16 bytes.
        let ce, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, "model.embed_tokens.weight", arena, offEmbed)
        if ce != 0 { return 500 + ce, Qwen3Weights{} }
        if lmIsTied == 0 {
            let ce2, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, "lm_head.weight", arena, offLm)
            if ce2 != 0 { return 600 + ce2, Qwen3Weights{} }
        }
        let ce3, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, Qwen3Weights{} }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            let dstOff0 = layerOffs[idx]
            let e0c, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, Qwen3Weights{} }
            idx = idx + 1

            let dstQkv = layerOffs[idx]
            let eq, nQ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "self_attn.q_proj.weight", arena, dstQkv)
            if eq != 0 { return 2000 + idx * 4 + eq, Qwen3Weights{} }
            let kDst: long = dstQkv + nQ * 2L
            let ek, nK = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "self_attn.k_proj.weight", arena, kDst)
            if ek != 0 { return 2000 + idx * 4 + ek, Qwen3Weights{} }
            let vDst: long = kDst + nK * 2L
            let ev, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "self_attn.v_proj.weight", arena, vDst)
            if ev != 0 { return 2000 + idx * 4 + ev, Qwen3Weights{} }
            idx = idx + 1

            let dstO = layerOffs[idx]
            let eo, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "self_attn.o_proj.weight", arena, dstO)
            if eo != 0 { return 2000 + idx * 4 + eo, Qwen3Weights{} }
            idx = idx + 1

            let dstGateUp = layerOffs[idx]
            let eg, nGate = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "mlp.gate_proj.weight", arena, dstGateUp)
            if eg != 0 { return 2000 + idx * 4 + eg, Qwen3Weights{} }
            let upDst: long = dstGateUp + nGate * 2L
            let eu, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "mlp.up_proj.weight", arena, upDst)
            if eu != 0 { return 2000 + idx * 4 + eu, Qwen3Weights{} }
            idx = idx + 1

            let dstDown = layerOffs[idx]
            let ed, _ = Qwen3._copyBF16FromSharded(modelDir, weightMap, pre + "mlp.down_proj.weight", arena, dstDown)
            if ed != 0 { return 2000 + idx * 4 + ed, Qwen3Weights{} }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 1, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    fn loadWeightsF16Auto(modelDir: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        if modelDir == null { return 1, Qwen3Weights{} }
        let eSingle, wSingle = loadWeightsF16(modelDir + "/model.safetensors", cfg)
        if eSingle == 0 { return 0, move wSingle }

        // Sharded safetensors: use the index + per-shard files.
        let we, weightMap = Qwen3._loadWeightMap(modelDir)
        if we != 0 { return eSingle, Qwen3Weights{} }

        // Pass 1: size (fp16 bytes).
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, nEmbed = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, "model.embed_tokens.weight")
        if e1 != 0 { return 200 + e1, Qwen3Weights{} }
        cur = cur + nEmbed * 2L

        let e2, nLm = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, "lm_head.weight")
        if e2 == 2 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 250 + e2, Qwen3Weights{} }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + nLm * 2L
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, nNorm = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, "model.norm.weight")
        if e3 != 0 { return 300 + e3, Qwen3Weights{} }
        cur = cur + nNorm * 2L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, n0 = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "input_layernorm.weight")
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, Qwen3Weights{} }
            cur = cur + n0 * 2L

            // postNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, n1b = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "post_attention_layernorm.weight")
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, Qwen3Weights{} }
            cur = cur + n1b * 2L

            // qNorm/kNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, n2b = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "self_attn.q_norm.weight")
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, Qwen3Weights{} }
            cur = cur + n2b * 2L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, n3b = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "self_attn.k_norm.weight")
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, Qwen3Weights{} }
            cur = cur + n3b * 2L

            // qkvProj (fused)
            let eq, nq = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "self_attn.q_proj.weight")
            if eq != 0 { return 1000 + li * 64 + 4 * 4 + eq, Qwen3Weights{} }
            let ek, nk = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "self_attn.k_proj.weight")
            if ek != 0 { return 1000 + li * 64 + 5 * 4 + ek, Qwen3Weights{} }
            let ev, nv = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "self_attn.v_proj.weight")
            if ev != 0 { return 1000 + li * 64 + 6 * 4 + ev, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (nq + nk + nv) * 2L

            // oProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, n7b = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "self_attn.o_proj.weight")
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, Qwen3Weights{} }
            cur = cur + n7b * 2L

            // gateUpProj (fused)
            let eg, ng = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "mlp.gate_proj.weight")
            if eg != 0 { return 1000 + li * 64 + 8 * 4 + eg, Qwen3Weights{} }
            let eu, nu = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "mlp.up_proj.weight")
            if eu != 0 { return 1000 + li * 64 + 9 * 4 + eu, Qwen3Weights{} }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (ng + nu) * 2L

            // downProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10b, n10b = Qwen3._tensorNumelF16Sharded(modelDir, weightMap, pre + "mlp.down_proj.weight")
            if e10b != 0 { return 1000 + li * 64 + 10 * 4 + e10b, Qwen3Weights{} }
            cur = cur + n10b * 2L

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, Qwen3Weights{} }

        // Pass 2: copy fp16 bytes.
        let ce, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, "model.embed_tokens.weight", arena, offEmbed)
        if ce != 0 { return 500 + ce, Qwen3Weights{} }
        if lmIsTied == 0 {
            let ce2, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, "lm_head.weight", arena, offLm)
            if ce2 != 0 { return 600 + ce2, Qwen3Weights{} }
        }
        let ce3, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, Qwen3Weights{} }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            let dstOff0 = layerOffs[idx]
            let e0c, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, Qwen3Weights{} }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, Qwen3Weights{} }
            idx = idx + 1

            let dstQkv = layerOffs[idx]
            let eq, nQ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "self_attn.q_proj.weight", arena, dstQkv)
            if eq != 0 { return 2000 + idx * 4 + eq, Qwen3Weights{} }
            let kDst: long = dstQkv + nQ * 2L
            let ek, nK = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "self_attn.k_proj.weight", arena, kDst)
            if ek != 0 { return 2000 + idx * 4 + ek, Qwen3Weights{} }
            let vDst: long = kDst + nK * 2L
            let ev, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "self_attn.v_proj.weight", arena, vDst)
            if ev != 0 { return 2000 + idx * 4 + ev, Qwen3Weights{} }
            idx = idx + 1

            let dstO = layerOffs[idx]
            let eo, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "self_attn.o_proj.weight", arena, dstO)
            if eo != 0 { return 2000 + idx * 4 + eo, Qwen3Weights{} }
            idx = idx + 1

            let dstGateUp = layerOffs[idx]
            let eg, nGate = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "mlp.gate_proj.weight", arena, dstGateUp)
            if eg != 0 { return 2000 + idx * 4 + eg, Qwen3Weights{} }
            let upDst: long = dstGateUp + nGate * 2L
            let eu, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "mlp.up_proj.weight", arena, upDst)
            if eu != 0 { return 2000 + idx * 4 + eu, Qwen3Weights{} }
            idx = idx + 1

            let dstDown = layerOffs[idx]
            let ed, _ = Qwen3._copyF16FromSharded(modelDir, weightMap, pre + "mlp.down_proj.weight", arena, dstDown)
            if ed != 0 { return 2000 + idx * 4 + ed, Qwen3Weights{} }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 2, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    fn loadWeightsAuto(modelDir: string, cfg: Qwen3Config, dtype: int) -> int, Qwen3Weights {
        if dtype == 1 {
            return Qwen3.loadWeightsBF16Auto(modelDir, cfg)
        }
        if dtype == 2 {
            return Qwen3.loadWeightsF16Auto(modelDir, cfg)
        }
        if dtype == 3 {
            return Qwen3.loadWeightsQ4Auto(modelDir, cfg)
        }
        if dtype == 4 {
            // Prefer GGUF q4_k_m / q4_k_s distributions when present.
            let ge, w = Qwen3.loadWeightsGgufQ4KM(modelDir, cfg)
            if ge == 0 { return 0, move w }
            return Qwen3.loadWeightsQ4KAuto(modelDir, cfg)
        }
        return Qwen3.loadWeightsF32Auto(modelDir, cfg)
    }

    fn newScratch(cfg: Qwen3Config, maxSeq: int) -> Qwen3Scratch {
        let hidden: long = (long)cfg.hidden
        let qdim: long = (long)cfg.heads * (long)cfg.headDim
        let kvdim: long = (long)cfg.kvHeads * (long)cfg.headDim
        let inter: long = (long)cfg.intermediate
        let vocab: long = (long)cfg.vocab
        let qkvdim: long = qdim + 2L * kvdim
        let gateUpDim: long = 2L * inter
        return Qwen3Scratch{ x: _f32Bytes(hidden), x1: _f32Bytes(hidden), x2: _f32Bytes(hidden), qkv: _f32Bytes(qkvdim), attn: _f32Bytes(qdim), gateUp: _f32Bytes(gateUpDim), inter: _f32Bytes(inter), logits: _f32Bytes(vocab), scores: _f32Bytes((long)maxSeq) }
    }

    fn loadState(modelDir: string, opts: LlmOptions) -> int, Qwen3State {
        let z = Qwen3State{
            cfg: Qwen3Config{},
            be: AccelerateOps{},
            pos: 0,
            wDtype: 0,
            wArena: null,
            wOffEmbed: 0L,
            wOffLmHead: 0L,
            wOffNorm: 0L,
            wLayerOffs: null,
            wLayerExtraOffs: {},
            kvDtype: 0,
            kvBuf: null,
            kvKBase: 0L,
            kvVBase: 0L,
            kvLayerBytes: 0L,
            kvTokenBytes: 0L,
            kvMaxSeq: 0,
            x: null,
            x1: null,
            x2: null,
            qkv: null,
            attn: null,
            gateUp: null,
            inter: null,
            logits: null,
            scores: null,
            prof: Qwen3Profile{},
        }

        // Config: prefer config.json; fall back to GGUF metadata if present.
        let ce, cfg = Qwen3.loadConfig(modelDir + "/config.json")
        if ce != 0 {
            let fe, ggufPath = Gguf.findMainFile(modelDir)
            if fe != 0 { return 1, z }
            let ge, gg = Gguf.parseMmap(ggufPath, 0)
            if ge != 0 { return 1, z }
            let eTok, tiTok = Gguf.tensorInfo(gg, "token_embd.weight")
            if eTok != 0 { return 1, z }
            // token_embd.weight dims: [hidden, vocab]
            let vocab: int = (int)tiTok.d1
            let rope: float = gg.ropeTheta
            if rope == 0.0 { rope = 1000000.0 }
            let eps: float = gg.rmsEps
            if eps == 0.0 { eps = 0.000001 }
            cfg = Qwen3Config{
                hidden: gg.embd,
                intermediate: gg.ffn,
                layers: gg.blockCount,
                heads: gg.heads,
                kvHeads: gg.kvHeads,
                headDim: gg.headDim,
                vocab: vocab,
                maxPos: gg.ctxLen,
                ropeTheta: rope,
                rmsEps: eps,
                bos: gg.bos,
                eos: gg.eos,
            }
        }

        let we, w = Qwen3.loadWeightsAuto(modelDir, cfg, opts.weightsDtype)
        if we != 0 { return 1, z }
        let wExtraOffs: long[] = w.extraOffs
        if wExtraOffs == null { wExtraOffs = {} }

        let maxSeq = _maxSeq(cfg, opts)
        if maxSeq <= 0 { return 2, z }
        let kvMaxSeq: int = maxSeq

        let kvVec: long = (long)cfg.kvHeads * (long)cfg.headDim
        let kvElemBytes: long = 4L
        if opts.kvDtype == 1 || opts.kvDtype == 2 { kvElemBytes = 2L }
        let kvTokenBytes: long = kvVec * kvElemBytes
        let kvLayerBytes: long = (long)kvMaxSeq * kvTokenBytes
        let kvNeed: long = 2L * (long)cfg.layers * kvLayerBytes
        if opts.kvMaxBytes > 0L {
            if kvNeed > opts.kvMaxBytes { return 2, z }
        }
        let kvBuf = bstd.Bytes.newLongUninit(kvNeed)
        if kvBuf == null { return 3, z }
        let kvKBase: long = 0L
        let kvVBase: long = (long)cfg.layers * kvLayerBytes

        let scratch: Qwen3Scratch = Qwen3.newScratch(cfg, kvMaxSeq)

        let beImpl: AccelerateOps = AccelerateOps()
        beImpl.setThreads(opts.threads)
        let be: OpsBackend = beImpl

        let out = Qwen3State{
            cfg: cfg,
            be: be,
            pos: 0,
            wDtype: w.dtype,
            wArena: w.arena,
            wOffEmbed: w.offEmbed,
            wOffLmHead: w.offLmHead,
            wOffNorm: w.offNorm,
            wLayerOffs: w.layerOffs,
            wLayerExtraOffs: wExtraOffs,
            kvDtype: opts.kvDtype,
            kvBuf: kvBuf,
            kvKBase: kvKBase,
            kvVBase: kvVBase,
            kvLayerBytes: kvLayerBytes,
            kvTokenBytes: kvTokenBytes,
            kvMaxSeq: kvMaxSeq,
            x: scratch.x,
            x1: scratch.x1,
            x2: scratch.x2,
            qkv: scratch.qkv,
            attn: scratch.attn,
            gateUp: scratch.gateUp,
            inter: scratch.inter,
            logits: scratch.logits,
            scores: scratch.scores,
            prof: Qwen3Profile{ enabled: opts.profile, prefillTokens: 0, decodeTokens: 0, replayTokens: 0,
                nsPrefillForward: 0L, nsDecodeForward: 0L, nsReplayForward: 0L, nsLogits: 0L, nsPenalty: 0L, nsSample: 0L,
                nsEmbed: 0L, nsInNorm: 0L, nsQkv: 0L, nsQkNorm: 0L, nsRope: 0L, nsKvStore: 0L, nsAttn: 0L, nsO: 0L,
                nsPostNorm: 0L, nsGateUp: 0L, nsSiluMul: 0L, nsDown: 0L, nsFinalNorm: 0L, nsLmHead: 0L, nsArgmax: 0L, nsSampleTop: 0L,
                cQkv: 0, cO: 0, cGateUp: 0, cDown: 0, cLmHead: 0 },
        }
        return 0, out
    }
}

private fn _embedRowBytes(cfg: Qwen3Config, id: long) -> long {
    return id * (long)cfg.hidden * 4L
}

private fn _gemv(let s: Qwen3State, m: int, n: int, aOff: long, x: bytes, xOff: long, y: bytes, yOff: long) -> int {
    if s.wDtype == 1 {
        return tua_llm_gemv_bf16_f32(y, yOff, s.wArena, aOff, x, xOff, m, n)
    }
    if s.wDtype == 2 {
        return tua_llm_gemv_f16_f32(y, yOff, s.wArena, aOff, x, xOff, m, n)
    }
    if s.wDtype == 3 {
        return tua_llm_gemv_q4_0_f32(y, yOff, s.wArena, aOff, x, xOff, m, n)
    }
    if s.wDtype == 4 {
        return tua_llm_gemv_q4_k_f32(y, yOff, s.wArena, aOff, x, xOff, m, n)
    }
    return tua_llm_gemv_f32(y, yOff, s.wArena, aOff, x, xOff, m, n)
}

private fn _rmsnorm(let s: Qwen3State, out: bytes, x: bytes, wOff: long, n: int, eps: float) -> int {
    if s.wDtype == 1 {
        return tua_llm_rmsnorm_f32_bf16w(out, 0L, x, 0L, s.wArena, wOff, n, eps)
    }
    if s.wDtype == 2 {
        return tua_llm_rmsnorm_f32_f16w(out, 0L, x, 0L, s.wArena, wOff, n, eps)
    }
    return tua_llm_rmsnorm_f32(out, 0L, x, 0L, s.wArena, wOff, n, eps)
}

private fn _addInplace(dst: bytes, src: bytes, n: long) -> int {
    return tua_llm_add_inplace_f32(dst, 0L, src, 0L, n)
}

private fn _f32(n: int) -> long { return (long)n * 4L }

private fn _clearKv(let s: Qwen3State) {
    s.pos = 0
}

private fn _forwardToken(let s: Qwen3State, id: long) -> int {
    let cfg: Qwen3Config = s.cfg
    if id < 0L { return 1 }
    if id >= (long)cfg.vocab { return 1 }
    let pos = s.pos
    let maxSeq: int = s.kvMaxSeq
    if pos >= maxSeq { return 2 }

    let prof: Qwen3Profile = s.prof

    let tEmbed: long = 0L
    if prof.enabled != 0 { tEmbed = time.Time.monoNs() }
    if s.wDtype == 3 {
        if tua_llm_q4_0_get_row_f32(s.x, 0L, s.wArena, s.wOffEmbed, id, cfg.hidden) != 0 { return 1 }
    } else if s.wDtype == 4 {
        if tua_llm_q4_k_get_row_f32(s.x, 0L, s.wArena, s.wOffEmbed, id, cfg.hidden) != 0 { return 1 }
    } else if s.wDtype == 5 {
        if tua_llm_q6_k_get_row_f32(s.x, 0L, s.wArena, s.wOffEmbed, id, cfg.hidden) != 0 { return 1 }
    } else if s.wDtype == 1 || s.wDtype == 2 {
        let rowBytes: long = id * (long)cfg.hidden * 2L
        let eoff = s.wOffEmbed + rowBytes
        if s.wDtype == 1 {
            if tua_bytes_bf16_to_f32(s.wArena, eoff, s.x, 0L, (long)cfg.hidden) != 0 { return 1 }
        } else {
            if tua_bytes_f16_to_f32(s.wArena, eoff, s.x, 0L, (long)cfg.hidden) != 0 { return 1 }
        }
    } else {
        let eoff = s.wOffEmbed + _embedRowBytes(cfg, id)
        bstd.Bytes.copy(s.x, 0L, s.wArena, eoff, _f32(cfg.hidden))
    }
    if prof.enabled != 0 { prof.nsEmbed = prof.nsEmbed + (time.Time.monoNs() - tEmbed) }

    let hidden: long = (long)cfg.hidden
    let qdim: int = cfg.heads * cfg.headDim
    let kvdim: int = cfg.kvHeads * cfg.headDim
    let scale: float = 1.0 / sqrtf((float)(double)cfg.headDim)

    let layer: int = 0
    while layer < cfg.layers {
        let inNormOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.inNorm)
        let tInNorm: long = 0L
        if prof.enabled != 0 { tInNorm = time.Time.monoNs() }
        if _rmsnorm(s, s.x1, s.x, inNormOff, cfg.hidden, cfg.rmsEps) != 0 { return 1 }
        if prof.enabled != 0 { prof.nsInNorm = prof.nsInNorm + (time.Time.monoNs() - tInNorm) }

        let qkvOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.qkvProj)
        let tQkv: long = 0L
        if prof.enabled != 0 { tQkv = time.Time.monoNs() }
        if s.wDtype == 5 {
            let extra: long[] = s.wLayerExtraOffs
            if extra == null || extra.len() < (long)(layer * 3 + 2) { return 1 }
            let ek: long = extra[layer * 3 + 0]
            let evPacked: long = extra[layer * 3 + 1]
            let vKind: int = _unpackKind(evPacked)
            let evOff: long = _unpackOff(evPacked)
            if tua_llm_gemv_q4_k_f32(s.qkv, 0L, s.wArena, qkvOff, s.x1, 0L, qdim, cfg.hidden) != 0 { return 1 }
            if tua_llm_gemv_q4_k_f32(s.qkv, (long)qdim * 4L, s.wArena, ek, s.x1, 0L, kvdim, cfg.hidden) != 0 { return 1 }
            if vKind == 0 {
                if tua_llm_gemv_q4_k_f32(s.qkv, ((long)qdim + (long)kvdim) * 4L, s.wArena, evOff, s.x1, 0L, kvdim, cfg.hidden) != 0 { return 1 }
            } else {
                if tua_llm_gemv_q6_k_f32(s.qkv, ((long)qdim + (long)kvdim) * 4L, s.wArena, evOff, s.x1, 0L, kvdim, cfg.hidden) != 0 { return 1 }
            }
        } else {
            let qkvdim: int = qdim + 2 * kvdim
            if _gemv(s, qkvdim, cfg.hidden, qkvOff, s.x1, 0L, s.qkv, 0L) != 0 { return 1 }
        }
        if prof.enabled != 0 { prof.nsQkv = prof.nsQkv + (time.Time.monoNs() - tQkv); prof.cQkv = prof.cQkv + 1 }

        let qOffF32: long = 0L
        let kOffF32: long = (long)qdim * 4L
        let vOffF32: long = ((long)qdim + (long)kvdim) * 4L

        let qnOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.qNorm)
        let knOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.kNorm)
        let tQkNorm: long = 0L
        if prof.enabled != 0 { tQkNorm = time.Time.monoNs() }
        if s.wDtype == 1 {
            if tua_llm_qk_rmsnorm_inplace_f32_bf16w(s.qkv, qOffF32, cfg.heads, cfg.headDim, s.wArena, qnOff, cfg.rmsEps) != 0 { return 1 }
            if tua_llm_qk_rmsnorm_inplace_f32_bf16w(s.qkv, kOffF32, cfg.kvHeads, cfg.headDim, s.wArena, knOff, cfg.rmsEps) != 0 { return 1 }
        } else if s.wDtype == 2 {
            if tua_llm_qk_rmsnorm_inplace_f32_f16w(s.qkv, qOffF32, cfg.heads, cfg.headDim, s.wArena, qnOff, cfg.rmsEps) != 0 { return 1 }
            if tua_llm_qk_rmsnorm_inplace_f32_f16w(s.qkv, kOffF32, cfg.kvHeads, cfg.headDim, s.wArena, knOff, cfg.rmsEps) != 0 { return 1 }
        } else {
            if tua_llm_qk_rmsnorm_inplace_f32(s.qkv, qOffF32, cfg.heads, cfg.headDim, s.wArena, qnOff, cfg.rmsEps) != 0 { return 1 }
            if tua_llm_qk_rmsnorm_inplace_f32(s.qkv, kOffF32, cfg.kvHeads, cfg.headDim, s.wArena, knOff, cfg.rmsEps) != 0 { return 1 }
        }
        if prof.enabled != 0 { prof.nsQkNorm = prof.nsQkNorm + (time.Time.monoNs() - tQkNorm) }

        let tRope: long = 0L
        if prof.enabled != 0 { tRope = time.Time.monoNs() }
        if tua_llm_rope_inplace_f32(s.qkv, qOffF32, cfg.heads, cfg.headDim, pos, cfg.ropeTheta) != 0 { return 1 }
        if tua_llm_rope_inplace_f32(s.qkv, kOffF32, cfg.kvHeads, cfg.headDim, pos, cfg.ropeTheta) != 0 { return 1 }
        if prof.enabled != 0 { prof.nsRope = prof.nsRope + (time.Time.monoNs() - tRope) }

        let tokBytes: long = s.kvTokenBytes
        let layerBytes: long = s.kvLayerBytes
        let kdst: long = s.kvKBase + (long)layer * layerBytes + (long)pos * tokBytes
        let vdst: long = s.kvVBase + (long)layer * layerBytes + (long)pos * tokBytes
        let tKvStore: long = 0L
        if prof.enabled != 0 { tKvStore = time.Time.monoNs() }
        if s.kvDtype == 1 {
            if tua_bytes_f32_to_bf16(s.qkv, kOffF32, s.kvBuf, kdst, (long)kvdim) != 0 { return 1 }
            if tua_bytes_f32_to_bf16(s.qkv, vOffF32, s.kvBuf, vdst, (long)kvdim) != 0 { return 1 }
        } else if s.kvDtype == 2 {
            if tua_bytes_f32_to_f16(s.qkv, kOffF32, s.kvBuf, kdst, (long)kvdim) != 0 { return 1 }
            if tua_bytes_f32_to_f16(s.qkv, vOffF32, s.kvBuf, vdst, (long)kvdim) != 0 { return 1 }
        } else {
            bstd.Bytes.copy(s.kvBuf, kdst, s.qkv, kOffF32, tokBytes)
            bstd.Bytes.copy(s.kvBuf, vdst, s.qkv, vOffF32, tokBytes)
        }
        if prof.enabled != 0 { prof.nsKvStore = prof.nsKvStore + (time.Time.monoNs() - tKvStore) }

        let ae: int = 0
        let tAttn: long = 0L
        if prof.enabled != 0 { tAttn = time.Time.monoNs() }
        if s.kvDtype == 1 {
            ae = tua_llm_attn_decode_kv_bf16_f32(s.attn, 0L, s.qkv, qOffF32, s.kvBuf, s.kvKBase, s.kvVBase, s.kvLayerBytes, s.kvTokenBytes, layer, pos, cfg.heads, cfg.kvHeads, cfg.headDim, scale, s.scores, 0L, (long)maxSeq)
        } else if s.kvDtype == 2 {
            ae = tua_llm_attn_decode_kv_f16_f32(s.attn, 0L, s.qkv, qOffF32, s.kvBuf, s.kvKBase, s.kvVBase, s.kvLayerBytes, s.kvTokenBytes, layer, pos, cfg.heads, cfg.kvHeads, cfg.headDim, scale, s.scores, 0L, (long)maxSeq)
        } else {
            ae = tua_llm_attn_decode_f32(s.attn, 0L, s.qkv, qOffF32, s.kvBuf, s.kvKBase, s.kvVBase, s.kvLayerBytes, s.kvTokenBytes, layer, pos, cfg.heads, cfg.kvHeads, cfg.headDim, scale, s.scores, 0L, (long)maxSeq)
        }
        if prof.enabled != 0 { prof.nsAttn = prof.nsAttn + (time.Time.monoNs() - tAttn) }
        if ae != 0 { return 1 }

        let oOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.oProj)
        let tO: long = 0L
        if prof.enabled != 0 { tO = time.Time.monoNs() }
        if s.wDtype == 5 {
            if tua_llm_gemv_q4_k_f32(s.x2, 0L, s.wArena, oOff, s.attn, 0L, cfg.hidden, qdim) != 0 { return 1 }
        } else {
            if _gemv(s, cfg.hidden, qdim, oOff, s.attn, 0L, s.x2, 0L) != 0 { return 1 }
        }
        if prof.enabled != 0 { prof.nsO = prof.nsO + (time.Time.monoNs() - tO); prof.cO = prof.cO + 1 }
        if _addInplace(s.x, s.x2, hidden) != 0 { return 1 }

        let postNormOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.postNorm)
        let tPostNorm: long = 0L
        if prof.enabled != 0 { tPostNorm = time.Time.monoNs() }
        if _rmsnorm(s, s.x1, s.x, postNormOff, cfg.hidden, cfg.rmsEps) != 0 { return 1 }
        if prof.enabled != 0 { prof.nsPostNorm = prof.nsPostNorm + (time.Time.monoNs() - tPostNorm) }

        let downOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.downProj)
        let gateUpOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.gateUpProj)
        let tGateUp: long = 0L
        if prof.enabled != 0 { tGateUp = time.Time.monoNs() }
        let gateUpDim: int = 2 * cfg.intermediate
        let upOffF32: long = (long)cfg.intermediate * 4L
        if s.wDtype == 5 {
            let extra: long[] = s.wLayerExtraOffs
            if extra == null || extra.len() < (long)(layer * 3 + 3) { return 1 }
            let upW: long = extra[layer * 3 + 2]
            if tua_llm_gemv_q4_k_f32(s.gateUp, 0L, s.wArena, gateUpOff, s.x1, 0L, cfg.intermediate, cfg.hidden) != 0 { return 1 }
            if tua_llm_gemv_q4_k_f32(s.gateUp, upOffF32, s.wArena, upW, s.x1, 0L, cfg.intermediate, cfg.hidden) != 0 { return 1 }
        } else {
            if _gemv(s, gateUpDim, cfg.hidden, gateUpOff, s.x1, 0L, s.gateUp, 0L) != 0 { return 1 }
        }
        if prof.enabled != 0 { prof.nsGateUp = prof.nsGateUp + (time.Time.monoNs() - tGateUp); prof.cGateUp = prof.cGateUp + 1 }
        let tSilu: long = 0L
        if prof.enabled != 0 { tSilu = time.Time.monoNs() }
        if tua_llm_silu_mul2_f32(s.inter, 0L, s.gateUp, 0L, upOffF32, (long)cfg.intermediate) != 0 { return 1 }
        if prof.enabled != 0 { prof.nsSiluMul = prof.nsSiluMul + (time.Time.monoNs() - tSilu) }

        let tDown: long = 0L
        if prof.enabled != 0 { tDown = time.Time.monoNs() }
        if s.wDtype == 5 {
            let downKind: int = _unpackKind(downOff)
            let downOff2: long = _unpackOff(downOff)
            if downKind == 0 {
                if tua_llm_gemv_q4_k_f32(s.x2, 0L, s.wArena, downOff2, s.inter, 0L, cfg.hidden, cfg.intermediate) != 0 { return 1 }
            } else {
                if tua_llm_gemv_q6_k_f32(s.x2, 0L, s.wArena, downOff2, s.inter, 0L, cfg.hidden, cfg.intermediate) != 0 { return 1 }
            }
        } else {
            if _gemv(s, cfg.hidden, cfg.intermediate, downOff, s.inter, 0L, s.x2, 0L) != 0 { return 1 }
        }
        if prof.enabled != 0 { prof.nsDown = prof.nsDown + (time.Time.monoNs() - tDown); prof.cDown = prof.cDown + 1 }
        if _addInplace(s.x, s.x2, hidden) != 0 { return 1 }

        layer = layer + 1
    }

    s.pos = pos + 1
    s.prof = prof
    return 0
}

private fn _prefillAndGetCtx(let s: Qwen3State, promptIds: long[]) -> int, long[] {
    if promptIds == null { return 1, null }
    if promptIds.len() == 0 { return 1, null }
    if s.kvMaxSeq <= 0 { return 1, null }

    let start: int = 0
    if promptIds.len() > s.kvMaxSeq {
        start = promptIds.len() - s.kvMaxSeq
    }

    _clearKv(s)
    let ctx: long[] = {}
    let prof: Qwen3Profile = s.prof
    let tPrefill: long = 0L
    if prof.enabled != 0 { tPrefill = time.Time.monoNs() }
    let i: int = start
    while i < promptIds.len() {
        let id: long = promptIds[i]
        let e = _forwardToken(s, id)
        if e != 0 { return 2, null }
        ctx.push(id)
        i = i + 1
    }
    if prof.enabled != 0 {
        prof.prefillTokens = prof.prefillTokens + ctx.len()
        prof.nsPrefillForward = prof.nsPrefillForward + (time.Time.monoNs() - tPrefill)
        s.prof = prof
    }
    return 0, ctx
}

private fn _logits(let s: Qwen3State) -> int {
    let cfg: Qwen3Config = s.cfg
    let prof: Qwen3Profile = s.prof
    let tAll: long = 0L
    if prof.enabled != 0 { tAll = time.Time.monoNs() }
    let tNorm: long = 0L
    if prof.enabled != 0 { tNorm = time.Time.monoNs() }
    if _rmsnorm(s, s.x1, s.x, s.wOffNorm, cfg.hidden, cfg.rmsEps) != 0 { return 1 }
    if prof.enabled != 0 { prof.nsFinalNorm = prof.nsFinalNorm + (time.Time.monoNs() - tNorm) }

    let tLm: long = 0L
    if prof.enabled != 0 { tLm = time.Time.monoNs() }
    if s.wDtype == 5 {
        if tua_llm_gemv_q6_k_f32(s.logits, 0L, s.wArena, s.wOffLmHead, s.x1, 0L, cfg.vocab, cfg.hidden) != 0 { return 1 }
    } else {
        if _gemv(s, cfg.vocab, cfg.hidden, s.wOffLmHead, s.x1, 0L, s.logits, 0L) != 0 { return 1 }
    }
    if prof.enabled != 0 { prof.nsLmHead = prof.nsLmHead + (time.Time.monoNs() - tLm); prof.cLmHead = prof.cLmHead + 1 }

    if prof.enabled != 0 { prof.nsLogits = prof.nsLogits + (time.Time.monoNs() - tAll); s.prof = prof }
    return 0
}

private fn _argmaxLogits(let s: Qwen3State) -> int, long {
    let out: long = 0L
    let cfg: Qwen3Config = s.cfg
    let prof: Qwen3Profile = s.prof
    let t0: long = 0L
    if prof.enabled != 0 { t0 = time.Time.monoNs() }
    let e = tua_llm_argmax_f32(s.logits, 0L, cfg.vocab, &out)
    if prof.enabled != 0 { prof.nsArgmax = prof.nsArgmax + (time.Time.monoNs() - t0); s.prof = prof }
    if e != 0 { return 1, 0L }
    return 0, out
}

// Streaming generator state for stop-based generation.
struct Qwen3GenStops {
    ctx: long[]
    out: long[]
    stopIds: long[]
    banIds: long[]
    minTokensBeforeStop: int
    maxNewTokens: int
    t: int
    rng: long
    done: int
}

object Qwen3Infer {
    // Initialize a streaming stop-based generator.
    // - Stops on EOS or any `stopIds` (excluded from output).
    // - If `minTokensBeforeStop>0`, bans EOS and stop ids early to avoid empty outputs.
    // - `banIds` are always banned (useful for keeping chat outputs clean).
    fn genStopsInit(let s: Qwen3State, promptIds: long[], opts: LlmOptions, stopIds: long[], banIds: long[], minTokensBeforeStop: int) -> int, Qwen3GenStops {
        let z = Qwen3GenStops{ ctx: null, out: null, stopIds: null, banIds: null, minTokensBeforeStop: 0, maxNewTokens: 0, t: 0, rng: 0L, done: 0 }
        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, z }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, z }

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        let minStop: int = minTokensBeforeStop
        if minStop < 0 { minStop = 0 }

        let outArr: long[] = {}
        let stopArr: long[] = stopIds
        if stopArr == null { stopArr = {} }
        let banArr: long[] = banIds
        if banArr == null { banArr = {} }

        let out = Qwen3GenStops{
            ctx: ctx0,
            out: outArr,
            stopIds: stopArr,
            banIds: banArr,
            minTokensBeforeStop: minStop,
            maxNewTokens: maxNew,
            t: 0,
            rng: rng,
            done: 0,
        }
        return 0, out
    }

    // Generate the next token for a `Qwen3GenStops` stream.
    // Returns (err, tokenId, done). When `done!=0`, `tokenId` is unspecified and no token was appended.
    fn genStopsNext(let s: Qwen3State, let g: Qwen3GenStops, opts: LlmOptions) -> int, long, int {
        if g.done != 0 { return 0, 0L, 1 }
        if g.t >= g.maxNewTokens { g.done = 1; return 0, 0L, 1 }

        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits
        // Cache fields into locals (tuac limitation: indexing/address-of only works on variables).
        let ctx: long[] = g.ctx
        let out: long[] = g.out
        let stopIds: long[] = g.stopIds
        let banIds: long[] = g.banIds

        if _logits(s) != 0 { return 3, 0L, 0 }
        let p0: Qwen3Profile = s.prof
        let profOn: int = p0.enabled
        let tPenalty: long = 0L
        if profOn != 0 { tPenalty = time.Time.monoNs() }
        if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
            let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
        }
        if opts.noRepeatNgram > 1 {
            let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
        }

        if banIds != null {
            let bi: int = 0
            while bi < banIds.len() {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, banIds[bi])
                bi = bi + 1
            }
        }

        let hasStops: bool = stopIds.len() > 0
        if g.t < g.minTokensBeforeStop {
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
            if hasStops {
                let si0: int = 0
                while si0 < stopIds.len() {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, stopIds[si0])
                    si0 = si0 + 1
                }
            }
        }
        if profOn != 0 {
            let p1: Qwen3Profile = s.prof
            p1.nsPenalty = p1.nsPenalty + (time.Time.monoNs() - tPenalty)
            s.prof = p1
        }

        let nextId: long = 0L
        let tries: int = 0
        let rng: long = g.rng
        let tSample: long = 0L
        if profOn != 0 { tSample = time.Time.monoNs() }
        while tries < 8 {
            if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                let ae, id = _argmaxLogits(s)
                if ae != 0 { return 3, 0L, 0 }
                nextId = id
            } else {
                let outIdx: long = 0L
                let tTop: long = 0L
                if profOn != 0 { tTop = time.Time.monoNs() }
                let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                if profOn != 0 {
                    let pTop: Qwen3Profile = s.prof
                    pTop.nsSampleTop = pTop.nsSampleTop + (time.Time.monoNs() - tTop)
                    s.prof = pTop
                }
                if se != 0 { return 3, 0L, 0 }
                nextId = outIdx
            }

            if g.t < g.minTokensBeforeStop {
                if nextId == eos {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                    tries = tries + 1
                    continue
                }
                if hasStops {
                    let si1: int = 0
                    let isStop: int = 0
                    while si1 < stopIds.len() {
                        if nextId == stopIds[si1] { isStop = 1; break }
                        si1 = si1 + 1
                    }
                    if isStop != 0 {
                        let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                        tries = tries + 1
                        continue
                    }
                }
            }
            break
        }
        g.rng = rng
        if profOn != 0 {
            let p2: Qwen3Profile = s.prof
            p2.nsSample = p2.nsSample + (time.Time.monoNs() - tSample)
            s.prof = p2
        }

        if nextId == eos { g.done = 1; return 0, 0L, 1 }
        if hasStops {
            let si: int = 0
            while si < stopIds.len() {
                if nextId == stopIds[si] { g.done = 1; return 0, 0L, 1 }
                si = si + 1
            }
        }

        out.push(nextId)
        ctx.push(nextId)
        g.out = out
        g.ctx = ctx

        let e2: int = 0
        let tFwd: long = 0L
        if profOn != 0 { tFwd = time.Time.monoNs() }
        e2 = _forwardToken(s, nextId)
        if e2 == 2 {
            let maxSeq: int = s.kvMaxSeq
            if maxSeq <= 1 { return 4, 0L, 0 }
            let replay: int = maxSeq - 1
            let start: int = ctx.len() - replay
            if start < 0 { start = 0 }
            _clearKv(s)
            let j: int = start
            while j < ctx.len() - 1 {
                let tReplay: long = 0L
                if profOn != 0 { tReplay = time.Time.monoNs() }
                let re = _forwardToken(s, ctx[j])
                if re != 0 { return 4, 0L, 0 }
                if profOn != 0 {
                    let pr: Qwen3Profile = s.prof
                    pr.replayTokens = pr.replayTokens + 1
                    pr.nsReplayForward = pr.nsReplayForward + (time.Time.monoNs() - tReplay)
                    s.prof = pr
                }
                j = j + 1
            }
            let tFwd2: long = 0L
            if profOn != 0 { tFwd2 = time.Time.monoNs() }
            let re2 = _forwardToken(s, nextId)
            if re2 != 0 { return 4, 0L, 0 }
            if profOn != 0 {
                let pd: Qwen3Profile = s.prof
                pd.decodeTokens = pd.decodeTokens + 1
                pd.nsDecodeForward = pd.nsDecodeForward + (time.Time.monoNs() - tFwd2)
                s.prof = pd
            }
        } else if e2 != 0 {
            return 4, 0L, 0
        } else if profOn != 0 {
            let pd2: Qwen3Profile = s.prof
            pd2.decodeTokens = pd2.decodeTokens + 1
            pd2.nsDecodeForward = pd2.nsDecodeForward + (time.Time.monoNs() - tFwd)
            s.prof = pd2
        }

        g.t = g.t + 1
        return 0, nextId, 0
    }

    fn prefill(let s: Qwen3State, promptIds: long[]) -> int {
        let e, _ = _prefillAndGetCtx(s, promptIds)
        if e != 0 { return e }
        return 0
    }

    // Compute next-token logits and return argmax id (does not advance KV).
    fn nextTokenArgmax(let s: Qwen3State) -> int, long {
        if _logits(s) != 0 { return 1, 0L }
        return _argmaxLogits(s)
    }

    // Generate one assistant turn for Qwen-style chat prompts.
    // - Expects `promptIds` to already include `<|im_start|>assistant\n` (and optional empty think block).
    // - Stops on `<|im_end|>` (cfg.eos) after at least one non-control token.
    // - Bans control tokens like `<|im_start|>` to keep output clean.
    fn generateChatTurn(let s: Qwen3State, promptIds: long[], opts: LlmOptions) -> int, long[] {
        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        // Qwen3 tokenizer added token ids (from tokenizer_config.json).
        let eot: long = 151643L // <|endoftext|>
        let imStart: long = 151644L // <|im_start|>
        let think: long = 151667L // <think>
        let endThink: long = 151668L // </think>

        // We do not support tools or multimodal tokens yet; ban them to keep generation clean.
        let objRefStart: long = 151646L
        let objRefEnd: long = 151647L
        let boxStart: long = 151648L
        let boxEnd: long = 151649L
        let quadStart: long = 151650L
        let quadEnd: long = 151651L
        let visionStart: long = 151652L
        let visionEnd: long = 151653L
        let visionPad: long = 151654L
        let imagePad: long = 151655L
        let videoPad: long = 151656L
        let toolCall: long = 151657L
        let toolCallEnd: long = 151658L
        let fimPrefix: long = 151659L
        let fimMiddle: long = 151660L
        let fimSuffix: long = 151661L
        let fimPad: long = 151662L
        let repoName: long = 151663L
        let fileSep: long = 151664L
        let toolResp: long = 151665L
        let toolRespEnd: long = 151666L

        let out: long[] = {}
        let t: int = 0
        let seenContent: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }

            // Ban control tokens from being generated as content.
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, imStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eot)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, objRefStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, objRefEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, boxStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, boxEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, quadStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, quadEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, visionStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, visionEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, visionPad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, imagePad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, videoPad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCall)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCallEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolResp)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolRespEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimPrefix)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimMiddle)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimSuffix)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimPad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, repoName)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fileSep)
            if opts.enableThinking == 0 {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, think)
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, endThink)
            }

            // Avoid immediately ending the turn before any content.
            if t < 4 && seenContent == 0 {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
            }

            let nextId: long = 0L
            let tries: int = 0
            while tries < 4 {
                if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                    let ae, id = _argmaxLogits(s)
                    if ae != 0 { return 3, null }
                    nextId = id
                } else {
                    let outIdx: long = 0L
                    let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                    if se != 0 { return 3, null }
                    nextId = outIdx
                }

                if nextId == eos && seenContent == 0 {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
                    tries = tries + 1
                    continue
                }
                break
            }

            if nextId == eos { break }

            out.push(nextId)
            ctx.push(nextId)
            if nextId != imStart && nextId != eot && nextId != think && nextId != endThink {
                seenContent = 1
            }

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }

            t = t + 1
        }
        return 0, out
    }

    // Deterministic generation: argmax for up to `maxNewTokens`, stopping on EOS.
    fn generateArgmax(let s: Qwen3State, promptIds: long[], maxNewTokens: int) -> int, long[] {
        if maxNewTokens < 0 { return 1, null }
        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let logits: bytes = s.logits

        let out: long[] = {}
        let t: int = 0
        while t < maxNewTokens {
            if _logits(s) != 0 { return 3, null }
            // Default repetition penalty to reduce loopy greedy outputs.
            let _ = tua_llm_repetition_penalty_f32(logits, 0L, cfg.vocab, ctx, 64, 1.1)
            let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, cfg.vocab, ctx, 3)
            let ae, nextId = _argmaxLogits(s)
            if ae != 0 { return 3, null }
            out.push(nextId)
            ctx.push(nextId)
            if nextId == eos { break }

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }

    // Sampling-based generation.
    fn generate(let s: Qwen3State, promptIds: long[], opts: LlmOptions) -> int, long[] {
        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        let out: long[] = {}
        let t: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }
            let nextId: long = 0L
            if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                let ae, id = _argmaxLogits(s)
                if ae != 0 { return 3, null }
                nextId = id
            } else {
                let outIdx: long = 0L
                let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                if se != 0 { return 3, null }
                nextId = outIdx
            }

            out.push(nextId)
            ctx.push(nextId)
            if nextId == eos { break }

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }

    fn generateWithStops(let s: Qwen3State, promptIds: long[], opts: LlmOptions, stopIds: long[]) -> int, long[] {
        if stopIds == null || stopIds.len() == 0 {
            return Qwen3Infer.generate(s, promptIds, opts)
        }

        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        let out: long[] = {}
        let t: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }
            let nextId: long = 0L
            if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                let ae, id = _argmaxLogits(s)
                if ae != 0 { return 3, null }
                nextId = id
            } else {
                let outIdx: long = 0L
                let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                if se != 0 { return 3, null }
                nextId = outIdx
            }

            if nextId == eos { break }
            let si: int = 0
            while si < stopIds.len() {
                if nextId == stopIds[si] { return 0, out }
                si = si + 1
            }

            out.push(nextId)
            ctx.push(nextId)

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }

    // Like `generateWithStops`, but prevents "empty/too-short" answers by banning EOS and stop ids
    // for the first `minTokensBeforeStop` generated tokens.
    fn generateWithStopsNoEarlyStop(let s: Qwen3State, promptIds: long[], opts: LlmOptions, stopIds: long[], minTokensBeforeStop: int) -> int, long[] {
        if stopIds == null || stopIds.len() == 0 {
            return Qwen3Infer.generate(s, promptIds, opts)
        }
        let minStop: int = minTokensBeforeStop
        if minStop < 0 { minStop = 0 }

        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        // Ban Qwen control/tool tokens to keep raw mode cleaner.
        let eot: long = 151643L // <|endoftext|>
        let imStart: long = 151644L // <|im_start|>
        let toolCall: long = 151657L
        let toolCallEnd: long = 151658L
        let toolResp: long = 151665L
        let toolRespEnd: long = 151666L

        let out: long[] = {}
        let t: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }

            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, imStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCall)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCallEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolResp)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolRespEnd)

            if t < minStop {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eot)
                let si0: int = 0
                while si0 < stopIds.len() {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, stopIds[si0])
                    si0 = si0 + 1
                }
            }

            let nextId: long = 0L
            let tries: int = 0
            while tries < 8 {
                if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                    let ae, id = _argmaxLogits(s)
                    if ae != 0 { return 3, null }
                    nextId = id
                } else {
                    let outIdx: long = 0L
                    let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                    if se != 0 { return 3, null }
                    nextId = outIdx
                }

                if t < minStop {
                    if nextId == eos || nextId == eot {
                        let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                        tries = tries + 1
                        continue
                    }
                    let si1: int = 0
                    let isStop: int = 0
                    while si1 < stopIds.len() {
                        if nextId == stopIds[si1] { isStop = 1; break }
                        si1 = si1 + 1
                    }
                    if isStop != 0 {
                        let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                        tries = tries + 1
                        continue
                    }
                }
                break
            }

            if nextId == eos { break }
            let si: int = 0
            while si < stopIds.len() {
                if nextId == stopIds[si] { return 0, out }
                si = si + 1
            }

            out.push(nextId)
            ctx.push(nextId)

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }
}

object Qwen3Bench {
    // Prefill prompt ids, then run 1 decode step (and return the generated token id).
    fn prefillAndDecode1(let s: Qwen3State, promptIds: long[]) -> int, long {
        if promptIds == null { return 1, 0L }
        if promptIds.len() == 0 { return 1, 0L }
        let t0 = time.Time.monoNs()

        let i: int = 0
        while i < promptIds.len() {
            let e = _forwardToken(s, promptIds[i])
            if e != 0 { return 1, 0L }
            i = i + 1
        }

        if _logits(s) != 0 { return 1, 0L }
        let ae, nextId = _argmaxLogits(s)
        if ae != 0 { return 1, 0L }

        // One decode step to exercise KV usage; ignore its next logits.
        let e2 = _forwardToken(s, nextId)
        if e2 != 0 { return 1, 0L }

        let t1 = time.Time.monoNs()
        let dtMs: long = (t1 - t0) / 1000000L
        println("prefill+decode1: promptLen={} dtMs={} nextId={}", promptIds.len(), dtMs, nextId)
        return 0, nextId
    }
}
