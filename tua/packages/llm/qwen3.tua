            let e2c, _ = Qwen3._copyTensorBF16(st, base, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, z }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = Qwen3._copyTensorBF16(st, base, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, z }
            idx = idx + 1

            let dstQkv = layerOffs[idx]
            let eq, nq = Qwen3._copyTensorBF16(st, base, pre + "self_attn.q_proj.weight", arena, dstQkv)
            if eq != 0 { return 2000 + idx * 4 + eq, z }
            let kDst: long = dstQkv + nq * 2L
            let ek, nk = Qwen3._copyTensorBF16(st, base, pre + "self_attn.k_proj.weight", arena, kDst)
            if ek != 0 { return 2000 + idx * 4 + ek, z }
            let vDst: long = kDst + nk * 2L
            let ev, _ = Qwen3._copyTensorBF16(st, base, pre + "self_attn.v_proj.weight", arena, vDst)
            if ev != 0 { return 2000 + idx * 4 + ev, z }
            idx = idx + 1

            let dstO = layerOffs[idx]
            let eo, _ = Qwen3._copyTensorBF16(st, base, pre + "self_attn.o_proj.weight", arena, dstO)
            if eo != 0 { return 2000 + idx * 4 + eo, z }
            idx = idx + 1

            let dstGateUp = layerOffs[idx]
            let eg, ng = Qwen3._copyTensorBF16(st, base, pre + "mlp.gate_proj.weight", arena, dstGateUp)
            if eg != 0 { return 2000 + idx * 4 + eg, z }
            let upDst: long = dstGateUp + ng * 2L
            let eu, _ = Qwen3._copyTensorBF16(st, base, pre + "mlp.up_proj.weight", arena, upDst)
            if eu != 0 { return 2000 + idx * 4 + eu, z }
            idx = idx + 1

            let dstDown = layerOffs[idx]
            let ed, _ = Qwen3._copyTensorBF16(st, base, pre + "mlp.down_proj.weight", arena, dstDown)
            if ed != 0 { return 2000 + idx * 4 + ed, z }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 1, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

