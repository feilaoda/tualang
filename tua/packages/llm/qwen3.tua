import "std/json" as j
import "std/strconv" as conv
import "std/time" as time

import SafeTensors, SafeDtype, SafeTensorsFile from "./safetensors"
import OpsBackend, OpTranspose from "./ops"
import AccelerateOps from "./ops_accelerate"
import LlmOptions from "./options"

extern fn sqrtf(x: float) float
extern fn tua_bytes_bf16_to_f32(src: bytes, srcOff: long, dst: bytes, dstOff: long, n: long) int
extern fn tua_llm_add_inplace_f32(dst: bytes, dstOff: long, src: bytes, srcOff: long, n: long) int
extern fn tua_llm_rmsnorm_f32(out: bytes, outOff: long, x: bytes, xOff: long, w: bytes, wOff: long, n: int, eps: float) int
extern fn tua_llm_qk_rmsnorm_inplace_f32(x: bytes, xOff: long, nHeads: int, headDim: int, w: bytes, wOff: long, eps: float) int
extern fn tua_llm_silu_mul_f32(out: bytes, outOff: long, gate: bytes, gateOff: long, up: bytes, upOff: long, n: long) int
extern fn tua_llm_rope_inplace_f32(x: bytes, xOff: long, nHeads: int, headDim: int, pos: int, theta: float) int
extern fn tua_llm_attn_decode_f32(out: bytes, outOff: long, q: bytes, qOff: long, kv: bytes, kBase: long, vBase: long, layerBytes: long, tokenBytes: long, layer: int, pos: int, nHeads: int, nKvHeads: int, headDim: int, scale: float, scratch: bytes, scratchOff: long, scratchFloats: long) int
extern fn tua_llm_gemv_f32(y: bytes, yOff: long, a: bytes, aOff: long, x: bytes, xOff: long, m: int, n: int) int
extern fn tua_llm_repetition_penalty_f32(logits: bytes, logitsOff: long, n: int, ids: long[], lastN: int, penalty: float) int
extern fn tua_llm_no_repeat_ngram_f32(logits: bytes, logitsOff: long, n: int, ids: long[], ngram: int) int
extern fn tua_llm_logit_ban_id_f32(logits: bytes, logitsOff: long, n: int, id: long) int
extern fn tua_llm_argmax_f32(x: bytes, xOff: long, n: int, outIndex: &long) int
extern fn tua_llm_sample_topk_topp_f32(logits: bytes, logitsOff: long, n: int, topK: int, topP: float, temperature: float, rngState: &long, outIndex: &long) int

struct Qwen3Config {
    hidden: int
    intermediate: int
    layers: int
    heads: int
    kvHeads: int
    headDim: int
    vocab: int
    maxPos: int
    ropeTheta: float
    rmsEps: float
    bos: long
    eos: long
}

private fn _scanLong(b: bytes, path: string) -> int, long {
    let e, v = j.Json.scanKeyPathLong(b, path)
    return e, v
}

private fn _scanBool(b: bytes, path: string) -> int, int {
    let e, v = j.Json.scanKeyPathBool(b, path)
    if v { return e, 1 }
    return e, 0
}

// object Qwen3 is declared below, after weight/scratch structs and helpers.

// Weights are stored as a single float32 arena; each tensor is a byte offset into the arena.
// Per-layer offsets are packed as layerOffs[layer*11 + kind].
private enum LayerW {
    inNorm = 0,
    postNorm = 1,
    qNorm = 2,
    kNorm = 3,
    qProj = 4,
    kProj = 5,
    vProj = 6,
    oProj = 7,
    gateProj = 8,
    upProj = 9,
    downProj = 10,
    _count = 11,
}

struct Qwen3Weights {
    arena: bytes
    offEmbed: long
    offLmHead: long
    offNorm: long
    layerOffs: long[]
}

private fn _align(off: long, a: long) -> long {
    if a <= 1L { return off }
    let r = off - (off / a) * a
    if r == 0L { return off }
    return off + (a - r)
}

private fn _layerOff(offs: long[], layer: int, kind: int) -> long {
    let idx: int = layer * (int)LayerW._count + kind
    return offs[idx]
}

private fn _tensorNumelBF16(st: SafeTensorsFile, name: string) -> int, long, long {
    let ie, recAny = SafeTensors.tensorInfo(st, name)
    if ie != 0 { return 1, 0L, 0L }
    if recAny == null { return 1, 0L, 0L }
    let rec: map = recAny
    let dtAny: any = rec["dtype"].unwrap()
    let dt: int = (int)dtAny
    // BF16 = 2 (SafeDtype.bfloat16); use literal to avoid enum typing edge cases.
    if dt != 2 { return 2, 0L, 0L }
    let offAny: any = rec["dataOff"].unwrap()
    let lenAny: any = rec["dataLen"].unwrap()
    let dataOff: long = (long)offAny
    let dataLen: long = (long)lenAny
    let r = dataLen - (dataLen / 2L) * 2L
    if dataLen < 0L { return 3, 0L, 0L }
    if r != 0L { return 3, 0L, 0L }
    return 0, dataOff, dataLen / 2L
}

private fn _convertTensorBF16ToF32(st: SafeTensorsFile, base: long, name: string, arena: bytes, dstOff: long) -> int, long {
    let te, dataOff, numel = _tensorNumelBF16(st, name)
    if te != 0 { return te, 0L }
    let e = tua_bytes_bf16_to_f32(st.data, base + dataOff, arena, dstOff, numel)
    if e != 0 { return 4, 0L }
    return 0, numel
}

private fn _layerPrefix(i: int) -> string {
    return "model.layers." + conv.Int.toString(i) + "."
}

struct Qwen3Scratch {
    x: bytes
    x1: bytes
    x2: bytes
    q: bytes
    k: bytes
    v: bytes
    attn: bytes
    gate: bytes
    up: bytes
    inter: bytes
    logits: bytes
    scores: bytes
}

private fn _f32Bytes(n: long) -> bytes { return bstd.Bytes.newLong(n * 4L) }

struct Qwen3State {
    cfg: Qwen3Config
    be: OpsBackend
    pos: int

    // Weights (float32 arena + offsets).
    wArena: bytes
    wOffEmbed: long
    wOffLmHead: long
    wOffNorm: long
    wLayerOffs: long[]

    // KV cache (float32).
    kvBuf: bytes
    kvKBase: long
    kvVBase: long
    kvLayerBytes: long
    kvTokenBytes: long
    kvMaxSeq: int

    // Scratch buffers (float32).
    x: bytes
    x1: bytes
    x2: bytes
    q: bytes
    k: bytes
    v: bytes
    attn: bytes
    gate: bytes
    up: bytes
    inter: bytes
    logits: bytes
    scores: bytes
}

private fn _minInt(a: int, b: int) -> int { if a < b { return a } return b }

private fn _kvMaxSeqForBytesF32(cfg: Qwen3Config, bytes: long) -> int {
    if bytes <= 0L { return 0 }
    let denom: long = 2L * (long)cfg.layers * (long)cfg.kvHeads * (long)cfg.headDim * 4L
    if denom <= 0L { return 0 }
    let m: long = bytes / denom
    if m <= 0L { return 0 }
    if m > 2147483647L { return 2147483647 }
    return (int)m
}

private fn _maxSeq(cfg: Qwen3Config, opts: LlmOptions) -> int {
    let maxSeq = cfg.maxPos
    if opts.kvMaxSeq <= 0 && opts.kvMaxBytes <= 0L {
        // Default to a safe KV window for usability; model configs often allow very large max_position_embeddings.
        maxSeq = _minInt(maxSeq, 2048)
    }
    if opts.kvMaxSeq > 0 {
        if opts.kvMaxSeq < maxSeq { maxSeq = opts.kvMaxSeq }
    }
    if opts.kvMaxBytes > 0L {
        let m2 = _kvMaxSeqForBytesF32(cfg, opts.kvMaxBytes)
        if m2 <= 0 { return 0 }
        if m2 < maxSeq { maxSeq = m2 }
    }
    if maxSeq < 1 { return 0 }
    return maxSeq
}

object Qwen3 {
    fn loadConfig(path: string) -> int, Qwen3Config {
        let z = Qwen3Config{ hidden: 0, intermediate: 0, layers: 0, heads: 0, kvHeads: 0, headDim: 0, vocab: 0, maxPos: 0, ropeTheta: 1000000.0, rmsEps: 0.000001, bos: 0L, eos: 0L }

        let e0, b = bstd.Bytes.mmapFile(path)
        if e0 != 0 { return 1, z }

        let e1, hs = _scanLong(b, "hidden_size")
        if e1 != 0 { return 1, z }
        let e2, inter = _scanLong(b, "intermediate_size")
        if e2 != 0 { return 1, z }
        let e3, nl = _scanLong(b, "num_hidden_layers")
        if e3 != 0 { return 1, z }
        let e4, nh = _scanLong(b, "num_attention_heads")
        if e4 != 0 { return 1, z }
        let e5, nkv = _scanLong(b, "num_key_value_heads")
        if e5 != 0 { return 1, z }
        let e6, hd = _scanLong(b, "head_dim")
        if e6 != 0 { return 1, z }
        let e7, vs = _scanLong(b, "vocab_size")
        if e7 != 0 { return 1, z }
        let e8, mp = _scanLong(b, "max_position_embeddings")
        if e8 != 0 { return 1, z }
        let e9, bos = _scanLong(b, "bos_token_id")
        if e9 != 0 { return 1, z }
        let e10, eos = _scanLong(b, "eos_token_id")
        if e10 != 0 { return 1, z }
        let e11, rope = _scanLong(b, "rope_theta")
        if e11 == 0 { z.ropeTheta = (float)(double)rope }

        // Small config: use DOM for rms_norm_eps (float).
        let pe, rootAny = j.Json.parseBytes(b)
        if pe == 0 {
            if rootAny != null {
            let root: map = rootAny
            let oeps = root["rms_norm_eps"]
            if oeps.isSome() {
                let v:any = oeps.unwrap()
                z.rmsEps = (float)(double)v
            }
            }
        }

        z.hidden = (int)hs
        z.intermediate = (int)inter
        z.layers = (int)nl
        z.heads = (int)nh
        z.kvHeads = (int)nkv
        z.headDim = (int)hd
        z.vocab = (int)vs
        z.maxPos = (int)mp
        z.bos = bos
        z.eos = eos
        return 0, z
    }

    fn loadWeightsF32(modelPath: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        let z = Qwen3Weights{ arena: null, offEmbed: 0L, offLmHead: 0L, offNorm: 0L, layerOffs: null }

        let e0, st = SafeTensors.parseMmap(modelPath)
        if e0 != 0 { return 10 + e0, z }
        if st.data == null { return 11, z }
        let base: long = 8L + st.headerLen

        // Pass 1: size.
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, tmpOff1, nEmbed = _tensorNumelBF16(st, "model.embed_tokens.weight")
        let _ = tmpOff1
        if e1 != 0 { return 100 + e1, z }
        cur = cur + nEmbed * 4L

        // Some checkpoints tie `lm_head.weight` with `model.embed_tokens.weight` and omit `lm_head.weight`.
        let e2, tmpOff2, nLm = _tensorNumelBF16(st, "lm_head.weight")
        let _ = tmpOff2
        if e2 == 1 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 200 + e2, z }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + nLm * 4L
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, tmpOff3, nNorm = _tensorNumelBF16(st, "model.norm.weight")
        let _ = tmpOff3
        if e3 != 0 { return 300 + e3, z }
        cur = cur + nNorm * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, tmpOff0, n0 = _tensorNumelBF16(st, pre + "input_layernorm.weight")
            let _ = tmpOff0
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, z }
            cur = cur + n0 * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, tmpOff1b, n1b = _tensorNumelBF16(st, pre + "post_attention_layernorm.weight")
            let _ = tmpOff1b
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, z }
            cur = cur + n1b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, tmpOff2b, n2b = _tensorNumelBF16(st, pre + "self_attn.q_norm.weight")
            let _ = tmpOff2b
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, z }
            cur = cur + n2b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, tmpOff3b, n3b = _tensorNumelBF16(st, pre + "self_attn.k_norm.weight")
            let _ = tmpOff3b
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, z }
            cur = cur + n3b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e4b, tmpOff4b, n4b = _tensorNumelBF16(st, pre + "self_attn.q_proj.weight")
            let _ = tmpOff4b
            if e4b != 0 { return 1000 + li * 64 + 4 * 4 + e4b, z }
            cur = cur + n4b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e5b, tmpOff5b, n5b = _tensorNumelBF16(st, pre + "self_attn.k_proj.weight")
            let _ = tmpOff5b
            if e5b != 0 { return 1000 + li * 64 + 5 * 4 + e5b, z }
            cur = cur + n5b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e6b, tmpOff6b, n6b = _tensorNumelBF16(st, pre + "self_attn.v_proj.weight")
            let _ = tmpOff6b
            if e6b != 0 { return 1000 + li * 64 + 6 * 4 + e6b, z }
            cur = cur + n6b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, tmpOff7b, n7b = _tensorNumelBF16(st, pre + "self_attn.o_proj.weight")
            let _ = tmpOff7b
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, z }
            cur = cur + n7b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e8b, tmpOff8b, n8b = _tensorNumelBF16(st, pre + "mlp.gate_proj.weight")
            let _ = tmpOff8b
            if e8b != 0 { return 1000 + li * 64 + 8 * 4 + e8b, z }
            cur = cur + n8b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e9b, tmpOff9b, n9b = _tensorNumelBF16(st, pre + "mlp.up_proj.weight")
            let _ = tmpOff9b
            if e9b != 0 { return 1000 + li * 64 + 9 * 4 + e9b, z }
            cur = cur + n9b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10b, tmpOff10b, n10b = _tensorNumelBF16(st, pre + "mlp.down_proj.weight")
            let _ = tmpOff10b
            if e10b != 0 { return 1000 + li * 64 + 10 * 4 + e10b, z }
            cur = cur + n10b * 4L
            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, z }

        let ce, tmpNum = _convertTensorBF16ToF32(st, base, "model.embed_tokens.weight", arena, offEmbed)
        let _ = tmpNum
        if ce != 0 { return 500 + ce, z }
        if lmIsTied == 0 {
            let ce2, tmpNum2 = _convertTensorBF16ToF32(st, base, "lm_head.weight", arena, offLm)
            let _ = tmpNum2
            if ce2 != 0 { return 600 + ce2, z }
        }
        let ce3, tmpNum3 = _convertTensorBF16ToF32(st, base, "model.norm.weight", arena, offNorm)
        let _ = tmpNum3
        if ce3 != 0 { return 700 + ce3, z }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            let dstOff0 = layerOffs[idx]
            let e0c, tmpNum0 = _convertTensorBF16ToF32(st, base, pre + "input_layernorm.weight", arena, dstOff0)
            let _ = tmpNum0
            if e0c != 0 { return 2000 + idx * 4 + e0c, z }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, tmpNum1 = _convertTensorBF16ToF32(st, base, pre + "post_attention_layernorm.weight", arena, dstOff1)
            let _ = tmpNum1
            if e1c != 0 { return 2000 + idx * 4 + e1c, z }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, tmpNum2 = _convertTensorBF16ToF32(st, base, pre + "self_attn.q_norm.weight", arena, dstOff2)
            let _ = tmpNum2
            if e2c != 0 { return 2000 + idx * 4 + e2c, z }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, tmpNum3 = _convertTensorBF16ToF32(st, base, pre + "self_attn.k_norm.weight", arena, dstOff3)
            let _ = tmpNum3
            if e3c != 0 { return 2000 + idx * 4 + e3c, z }
            idx = idx + 1

            let dstOff4 = layerOffs[idx]
            let e4c, tmpNum4 = _convertTensorBF16ToF32(st, base, pre + "self_attn.q_proj.weight", arena, dstOff4)
            let _ = tmpNum4
            if e4c != 0 { return 2000 + idx * 4 + e4c, z }
            idx = idx + 1

            let dstOff5 = layerOffs[idx]
            let e5c, tmpNum5 = _convertTensorBF16ToF32(st, base, pre + "self_attn.k_proj.weight", arena, dstOff5)
            let _ = tmpNum5
            if e5c != 0 { return 2000 + idx * 4 + e5c, z }
            idx = idx + 1

            let dstOff6 = layerOffs[idx]
            let e6c, tmpNum6 = _convertTensorBF16ToF32(st, base, pre + "self_attn.v_proj.weight", arena, dstOff6)
            let _ = tmpNum6
            if e6c != 0 { return 2000 + idx * 4 + e6c, z }
            idx = idx + 1

            let dstOff7 = layerOffs[idx]
            let e7c, tmpNum7 = _convertTensorBF16ToF32(st, base, pre + "self_attn.o_proj.weight", arena, dstOff7)
            let _ = tmpNum7
            if e7c != 0 { return 2000 + idx * 4 + e7c, z }
            idx = idx + 1

            let dstOff8 = layerOffs[idx]
            let e8c, tmpNum8 = _convertTensorBF16ToF32(st, base, pre + "mlp.gate_proj.weight", arena, dstOff8)
            let _ = tmpNum8
            if e8c != 0 { return 2000 + idx * 4 + e8c, z }
            idx = idx + 1

            let dstOff9 = layerOffs[idx]
            let e9c, tmpNum9 = _convertTensorBF16ToF32(st, base, pre + "mlp.up_proj.weight", arena, dstOff9)
            let _ = tmpNum9
            if e9c != 0 { return 2000 + idx * 4 + e9c, z }
            idx = idx + 1

            let dstOff10 = layerOffs[idx]
            let e10c, tmpNum10 = _convertTensorBF16ToF32(st, base, pre + "mlp.down_proj.weight", arena, dstOff10)
            let _ = tmpNum10
            if e10c != 0 { return 2000 + idx * 4 + e10c, z }
            idx = idx + 1
            li = li + 1
        }

        let out = Qwen3Weights{ arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs }
        return 0, out
    }

    private fn _loadWeightMap(modelDir: string) -> int, map {
        if modelDir == null { return 1, null }
        let e0, b = bstd.Bytes.mmapFile(modelDir + "/model.safetensors.index.json")
        if e0 != 0 { return 2, null }
        let pe, rootAny = j.Json.parseBytes(b)
        if pe != 0 || rootAny == null { return 3, null }
        let root: map = rootAny
        let opt = root["weight_map"]
        if opt.isNone() { return 4, null }
        let wmAny: any = opt.unwrap()
        if wmAny == null { return 4, null }
        let wm: map = wmAny
        return 0, wm
    }

    private fn _weightFileFor(weightMap: map, tensor: string) -> int, string {
        if weightMap == null || tensor == null { return 1, null }
        let wm: map = weightMap
        let opt = wm[tensor]
        if opt.isNone() { return 2, null }
        let vAny: any = opt.unwrap()
        if vAny == null { return 2, null }
        let v: string = vAny
        return 0, v
    }

    private fn _tensorNumelBF16Sharded(modelDir: string, weightMap: map, name: string) -> int, long {
        // Returns (err, numel)
        if modelDir == null || name == null { return 1, 0L }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2, 0L }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0, 0L }
        let te, dataOff, numel = _tensorNumelBF16(st, name)
        let _ = dataOff
        if te != 0 { return 20 + te, 0L }
        return 0, numel
    }

    private fn _convertBF16ToF32FromSharded(modelDir: string, weightMap: map, name: string, arena: bytes, dstOff: long) -> int {
        if modelDir == null || name == null { return 1 }
        let fe, rel = Qwen3._weightFileFor(weightMap, name)
        if fe != 0 { return 2 }
        let e0, st = SafeTensors.parseMmap(modelDir + "/" + rel)
        if e0 != 0 { return 10 + e0 }
        let base: long = 8L + st.headerLen
        let ce, tmpNum = _convertTensorBF16ToF32(st, base, name, arena, dstOff)
        let _ = tmpNum
        if ce != 0 { return 20 + ce }
        return 0
    }

    fn loadWeightsF32Auto(modelDir: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        if modelDir == null { return 1, Qwen3Weights{} }
        let eSingle, wSingle = loadWeightsF32(modelDir + "/model.safetensors", cfg)
        if eSingle == 0 { return 0, move wSingle }

        // Sharded safetensors: use the index + per-shard files.
        let we, weightMap = Qwen3._loadWeightMap(modelDir)
        if we != 0 { return eSingle, Qwen3Weights{} }

        // Pass 1: size.
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, nEmbed = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.embed_tokens.weight")
        if e1 != 0 { return 200 + e1, Qwen3Weights{} }
        cur = cur + nEmbed * 4L

        let e2, nLm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "lm_head.weight")
        if e2 != 0 {
            // Missing lm_head in sharded checkpoint: assume tied embeddings.
            lmIsTied = 1
            offLm = offEmbed
        } else {
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + nLm * 4L
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, nNorm = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, "model.norm.weight")
        if e3 != 0 { return 300 + e3, Qwen3Weights{} }
        cur = cur + nNorm * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)
            let names: string[] = {
                pre + "input_layernorm.weight",
                pre + "post_attention_layernorm.weight",
                pre + "self_attn.q_norm.weight",
                pre + "self_attn.k_norm.weight",
                pre + "self_attn.q_proj.weight",
                pre + "self_attn.k_proj.weight",
                pre + "self_attn.v_proj.weight",
                pre + "self_attn.o_proj.weight",
                pre + "mlp.gate_proj.weight",
                pre + "mlp.up_proj.weight",
                pre + "mlp.down_proj.weight",
            }
            let ni: int = 0
            while ni < names.len() {
                cur = _align(cur, 64L)
                layerOffs.push(cur)
                let ee, nn = Qwen3._tensorNumelBF16Sharded(modelDir, weightMap, names[ni])
                if ee != 0 { return 1000 + li * 64 + ni * 4 + ee, Qwen3Weights{} }
                cur = cur + nn * 4L
                ni = ni + 1
            }
            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, Qwen3Weights{} }

        // Pass 2: convert.
        let ce = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "model.embed_tokens.weight", arena, offEmbed)
        if ce != 0 { return 500 + ce, Qwen3Weights{} }
        if lmIsTied == 0 {
            let ce2 = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "lm_head.weight", arena, offLm)
            if ce2 != 0 { return 600 + ce2, Qwen3Weights{} }
        }
        let ce3 = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, "model.norm.weight", arena, offNorm)
        if ce3 != 0 { return 700 + ce3, Qwen3Weights{} }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)
            let names: string[] = {
                pre + "input_layernorm.weight",
                pre + "post_attention_layernorm.weight",
                pre + "self_attn.q_norm.weight",
                pre + "self_attn.k_norm.weight",
                pre + "self_attn.q_proj.weight",
                pre + "self_attn.k_proj.weight",
                pre + "self_attn.v_proj.weight",
                pre + "self_attn.o_proj.weight",
                pre + "mlp.gate_proj.weight",
                pre + "mlp.up_proj.weight",
                pre + "mlp.down_proj.weight",
            }
            let ni: int = 0
            while ni < names.len() {
                let dstOff = layerOffs[idx]
                let ee = Qwen3._convertBF16ToF32FromSharded(modelDir, weightMap, names[ni], arena, dstOff)
                if ee != 0 { return 2000 + idx * 4 + ee, Qwen3Weights{} }
                idx = idx + 1
                ni = ni + 1
            }
            li = li + 1
        }

        let out = Qwen3Weights{ arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs }
        return 0, out
    }

    fn newScratch(cfg: Qwen3Config, maxSeq: int) -> Qwen3Scratch {
        let hidden: long = (long)cfg.hidden
        let qdim: long = (long)cfg.heads * (long)cfg.headDim
        let kvdim: long = (long)cfg.kvHeads * (long)cfg.headDim
        let inter: long = (long)cfg.intermediate
        let vocab: long = (long)cfg.vocab
        return Qwen3Scratch{ x: _f32Bytes(hidden), x1: _f32Bytes(hidden), x2: _f32Bytes(hidden), q: _f32Bytes(qdim), k: _f32Bytes(kvdim), v: _f32Bytes(kvdim), attn: _f32Bytes(qdim), gate: _f32Bytes(inter), up: _f32Bytes(inter), inter: _f32Bytes(inter), logits: _f32Bytes(vocab), scores: _f32Bytes((long)maxSeq) }
    }

    fn loadState(modelDir: string, opts: LlmOptions) -> int, Qwen3State {
        let z = Qwen3State{
            cfg: Qwen3Config{},
            be: AccelerateOps{},
            pos: 0,
            wArena: null,
            wOffEmbed: 0L,
            wOffLmHead: 0L,
            wOffNorm: 0L,
            wLayerOffs: null,
            kvBuf: null,
            kvKBase: 0L,
            kvVBase: 0L,
            kvLayerBytes: 0L,
            kvTokenBytes: 0L,
            kvMaxSeq: 0,
            x: null,
            x1: null,
            x2: null,
            q: null,
            k: null,
            v: null,
            attn: null,
            gate: null,
            up: null,
            inter: null,
            logits: null,
            scores: null,
        }

        let ce, cfg = Qwen3.loadConfig(modelDir + "/config.json")
        if ce != 0 { return 1, z }

        let we, w = Qwen3.loadWeightsF32Auto(modelDir, cfg)
        if we != 0 { return 1, z }

        let maxSeq = _maxSeq(cfg, opts)
        if maxSeq <= 0 { return 2, z }
        let kvMaxSeq: int = maxSeq

        let kvVec: long = (long)cfg.kvHeads * (long)cfg.headDim
        let kvTokenBytes: long = kvVec * 4L
        let kvLayerBytes: long = (long)kvMaxSeq * kvTokenBytes
        let kvNeed: long = 2L * (long)cfg.layers * kvLayerBytes
        if opts.kvMaxBytes > 0L {
            if kvNeed > opts.kvMaxBytes { return 2, z }
        }
        let kvBuf = bstd.Bytes.newLongUninit(kvNeed)
        if kvBuf == null { return 3, z }
        let kvKBase: long = 0L
        let kvVBase: long = (long)cfg.layers * kvLayerBytes

        let scratch: Qwen3Scratch = Qwen3.newScratch(cfg, kvMaxSeq)

        let beImpl: AccelerateOps = AccelerateOps()
        beImpl.setThreads(opts.threads)
        let be: OpsBackend = beImpl

        let out = Qwen3State{
            cfg: cfg,
            be: be,
            pos: 0,
            wArena: w.arena,
            wOffEmbed: w.offEmbed,
            wOffLmHead: w.offLmHead,
            wOffNorm: w.offNorm,
            wLayerOffs: w.layerOffs,
            kvBuf: kvBuf,
            kvKBase: kvKBase,
            kvVBase: kvVBase,
            kvLayerBytes: kvLayerBytes,
            kvTokenBytes: kvTokenBytes,
            kvMaxSeq: kvMaxSeq,
            x: scratch.x,
            x1: scratch.x1,
            x2: scratch.x2,
            q: scratch.q,
            k: scratch.k,
            v: scratch.v,
            attn: scratch.attn,
            gate: scratch.gate,
            up: scratch.up,
            inter: scratch.inter,
            logits: scratch.logits,
            scores: scratch.scores,
        }
        return 0, out
    }
}

private fn _embedRowBytes(cfg: Qwen3Config, id: long) -> long {
    return id * (long)cfg.hidden * 4L
}

private fn _gemv(m: int, n: int, a: bytes, aOff: long, x: bytes, xOff: long, y: bytes, yOff: long) -> int {
    return tua_llm_gemv_f32(y, yOff, a, aOff, x, xOff, m, n)
}

private fn _rmsnorm(out: bytes, x: bytes, w: bytes, wOff: long, n: int, eps: float) -> int {
    return tua_llm_rmsnorm_f32(out, 0L, x, 0L, w, wOff, n, eps)
}

private fn _addInplace(dst: bytes, src: bytes, n: long) -> int {
    return tua_llm_add_inplace_f32(dst, 0L, src, 0L, n)
}

private fn _f32(n: int) -> long { return (long)n * 4L }

private fn _clearKv(let s: Qwen3State) {
    s.pos = 0
}

private fn _forwardToken(let s: Qwen3State, id: long) -> int {
    let cfg: Qwen3Config = s.cfg
    if id < 0L { return 1 }
    if id >= (long)cfg.vocab { return 1 }
    let pos = s.pos
    let maxSeq: int = s.kvMaxSeq
    if pos >= maxSeq { return 2 }

    let eoff = s.wOffEmbed + _embedRowBytes(cfg, id)
    bstd.Bytes.copy(s.x, 0L, s.wArena, eoff, _f32(cfg.hidden))

    let hidden: long = (long)cfg.hidden
    let qdim: int = cfg.heads * cfg.headDim
    let kvdim: int = cfg.kvHeads * cfg.headDim
    let scale: float = 1.0 / sqrtf((float)(double)cfg.headDim)

    let layer: int = 0
    while layer < cfg.layers {
        let inNormOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.inNorm)
        if _rmsnorm(s.x1, s.x, s.wArena, inNormOff, cfg.hidden, cfg.rmsEps) != 0 { return 1 }

        let qOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.qProj)
        let kOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.kProj)
        let vOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.vProj)
        if _gemv(qdim, cfg.hidden, s.wArena, qOff, s.x1, 0L, s.q, 0L) != 0 { return 1 }
        if _gemv(kvdim, cfg.hidden, s.wArena, kOff, s.x1, 0L, s.k, 0L) != 0 { return 1 }
        if _gemv(kvdim, cfg.hidden, s.wArena, vOff, s.x1, 0L, s.v, 0L) != 0 { return 1 }

        let qnOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.qNorm)
        let knOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.kNorm)
        if tua_llm_qk_rmsnorm_inplace_f32(s.q, 0L, cfg.heads, cfg.headDim, s.wArena, qnOff, cfg.rmsEps) != 0 { return 1 }
        if tua_llm_qk_rmsnorm_inplace_f32(s.k, 0L, cfg.kvHeads, cfg.headDim, s.wArena, knOff, cfg.rmsEps) != 0 { return 1 }

        if tua_llm_rope_inplace_f32(s.q, 0L, cfg.heads, cfg.headDim, pos, cfg.ropeTheta) != 0 { return 1 }
        if tua_llm_rope_inplace_f32(s.k, 0L, cfg.kvHeads, cfg.headDim, pos, cfg.ropeTheta) != 0 { return 1 }

        let tokBytes: long = s.kvTokenBytes
        let layerBytes: long = s.kvLayerBytes
        let kdst: long = s.kvKBase + (long)layer * layerBytes + (long)pos * tokBytes
        let vdst: long = s.kvVBase + (long)layer * layerBytes + (long)pos * tokBytes
        bstd.Bytes.copy(s.kvBuf, kdst, s.k, 0L, tokBytes)
        bstd.Bytes.copy(s.kvBuf, vdst, s.v, 0L, tokBytes)

        let ae = tua_llm_attn_decode_f32(s.attn, 0L, s.q, 0L, s.kvBuf, s.kvKBase, s.kvVBase, s.kvLayerBytes, s.kvTokenBytes, layer, pos, cfg.heads, cfg.kvHeads, cfg.headDim, scale, s.scores, 0L, (long)maxSeq)
        if ae != 0 { return 1 }

        let oOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.oProj)
        if _gemv(cfg.hidden, qdim, s.wArena, oOff, s.attn, 0L, s.x2, 0L) != 0 { return 1 }
        if _addInplace(s.x, s.x2, hidden) != 0 { return 1 }

        let postNormOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.postNorm)
        if _rmsnorm(s.x1, s.x, s.wArena, postNormOff, cfg.hidden, cfg.rmsEps) != 0 { return 1 }

        let gateOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.gateProj)
        let upOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.upProj)
        let downOff = _layerOff(s.wLayerOffs, layer, (int)LayerW.downProj)
        if _gemv(cfg.intermediate, cfg.hidden, s.wArena, gateOff, s.x1, 0L, s.gate, 0L) != 0 { return 1 }
        if _gemv(cfg.intermediate, cfg.hidden, s.wArena, upOff, s.x1, 0L, s.up, 0L) != 0 { return 1 }
        if tua_llm_silu_mul_f32(s.inter, 0L, s.gate, 0L, s.up, 0L, (long)cfg.intermediate) != 0 { return 1 }
        if _gemv(cfg.hidden, cfg.intermediate, s.wArena, downOff, s.inter, 0L, s.x2, 0L) != 0 { return 1 }
        if _addInplace(s.x, s.x2, hidden) != 0 { return 1 }

        layer = layer + 1
    }

    s.pos = pos + 1
    return 0
}

private fn _prefillAndGetCtx(let s: Qwen3State, promptIds: long[]) -> int, long[] {
    if promptIds == null { return 1, null }
    if promptIds.len() == 0 { return 1, null }
    if s.kvMaxSeq <= 0 { return 1, null }

    let start: int = 0
    if promptIds.len() > s.kvMaxSeq {
        start = promptIds.len() - s.kvMaxSeq
    }

    _clearKv(s)
    let ctx: long[] = {}
    let i: int = start
    while i < promptIds.len() {
        let id: long = promptIds[i]
        let e = _forwardToken(s, id)
        if e != 0 { return 2, null }
        ctx.push(id)
        i = i + 1
    }
    return 0, ctx
}

private fn _logits(let s: Qwen3State) -> int {
    let cfg: Qwen3Config = s.cfg
    if _rmsnorm(s.x1, s.x, s.wArena, s.wOffNorm, cfg.hidden, cfg.rmsEps) != 0 { return 1 }
    if _gemv(cfg.vocab, cfg.hidden, s.wArena, s.wOffLmHead, s.x1, 0L, s.logits, 0L) != 0 { return 1 }
    return 0
}

private fn _argmaxLogits(let s: Qwen3State) -> int, long {
    let out: long = 0L
    let cfg: Qwen3Config = s.cfg
    let e = tua_llm_argmax_f32(s.logits, 0L, cfg.vocab, &out)
    if e != 0 { return 1, 0L }
    return 0, out
}

// Streaming generator state for stop-based generation.
struct Qwen3GenStops {
    ctx: long[]
    out: long[]
    stopIds: long[]
    banIds: long[]
    minTokensBeforeStop: int
    maxNewTokens: int
    t: int
    rng: long
    done: int
}

object Qwen3Infer {
    // Initialize a streaming stop-based generator.
    // - Stops on EOS or any `stopIds` (excluded from output).
    // - If `minTokensBeforeStop>0`, bans EOS and stop ids early to avoid empty outputs.
    // - `banIds` are always banned (useful for keeping chat outputs clean).
    fn genStopsInit(let s: Qwen3State, promptIds: long[], opts: LlmOptions, stopIds: long[], banIds: long[], minTokensBeforeStop: int) -> int, Qwen3GenStops {
        let z = Qwen3GenStops{ ctx: null, out: null, stopIds: null, banIds: null, minTokensBeforeStop: 0, maxNewTokens: 0, t: 0, rng: 0L, done: 0 }
        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, z }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, z }

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        let minStop: int = minTokensBeforeStop
        if minStop < 0 { minStop = 0 }

        let outArr: long[] = {}
        let stopArr: long[] = stopIds
        if stopArr == null { stopArr = {} }
        let banArr: long[] = banIds
        if banArr == null { banArr = {} }

        let out = Qwen3GenStops{
            ctx: ctx0,
            out: outArr,
            stopIds: stopArr,
            banIds: banArr,
            minTokensBeforeStop: minStop,
            maxNewTokens: maxNew,
            t: 0,
            rng: rng,
            done: 0,
        }
        return 0, out
    }

    // Generate the next token for a `Qwen3GenStops` stream.
    // Returns (err, tokenId, done). When `done!=0`, `tokenId` is unspecified and no token was appended.
    fn genStopsNext(let s: Qwen3State, let g: Qwen3GenStops, opts: LlmOptions) -> int, long, int {
        if g.done != 0 { return 0, 0L, 1 }
        if g.t >= g.maxNewTokens { g.done = 1; return 0, 0L, 1 }

        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits
        // Cache fields into locals (tuac limitation: indexing/address-of only works on variables).
        let ctx: long[] = g.ctx
        let out: long[] = g.out
        let stopIds: long[] = g.stopIds
        let banIds: long[] = g.banIds

        if _logits(s) != 0 { return 3, 0L, 0 }
        if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
            let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
        }
        if opts.noRepeatNgram > 1 {
            let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
        }

        if banIds != null {
            let bi: int = 0
            while bi < banIds.len() {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, banIds[bi])
                bi = bi + 1
            }
        }

        let hasStops: bool = stopIds.len() > 0
        if g.t < g.minTokensBeforeStop {
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
            if hasStops {
                let si0: int = 0
                while si0 < stopIds.len() {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, stopIds[si0])
                    si0 = si0 + 1
                }
            }
        }

        let nextId: long = 0L
        let tries: int = 0
        let rng: long = g.rng
        while tries < 8 {
            if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                let ae, id = _argmaxLogits(s)
                if ae != 0 { return 3, 0L, 0 }
                nextId = id
            } else {
                let outIdx: long = 0L
                let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                if se != 0 { return 3, 0L, 0 }
                nextId = outIdx
            }

            if g.t < g.minTokensBeforeStop {
                if nextId == eos {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                    tries = tries + 1
                    continue
                }
                if hasStops {
                    let si1: int = 0
                    let isStop: int = 0
                    while si1 < stopIds.len() {
                        if nextId == stopIds[si1] { isStop = 1; break }
                        si1 = si1 + 1
                    }
                    if isStop != 0 {
                        let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                        tries = tries + 1
                        continue
                    }
                }
            }
            break
        }
        g.rng = rng

        if nextId == eos { g.done = 1; return 0, 0L, 1 }
        if hasStops {
            let si: int = 0
            while si < stopIds.len() {
                if nextId == stopIds[si] { g.done = 1; return 0, 0L, 1 }
                si = si + 1
            }
        }

        out.push(nextId)
        ctx.push(nextId)
        g.out = out
        g.ctx = ctx

        let e2 = _forwardToken(s, nextId)
        if e2 == 2 {
            let maxSeq: int = s.kvMaxSeq
            if maxSeq <= 1 { return 4, 0L, 0 }
            let replay: int = maxSeq - 1
            let start: int = ctx.len() - replay
            if start < 0 { start = 0 }
            _clearKv(s)
            let j: int = start
            while j < ctx.len() - 1 {
                let re = _forwardToken(s, ctx[j])
                if re != 0 { return 4, 0L, 0 }
                j = j + 1
            }
            let re2 = _forwardToken(s, nextId)
            if re2 != 0 { return 4, 0L, 0 }
        } else if e2 != 0 {
            return 4, 0L, 0
        }

        g.t = g.t + 1
        return 0, nextId, 0
    }

    fn prefill(let s: Qwen3State, promptIds: long[]) -> int {
        let e, _ = _prefillAndGetCtx(s, promptIds)
        if e != 0 { return e }
        return 0
    }

    // Compute next-token logits and return argmax id (does not advance KV).
    fn nextTokenArgmax(let s: Qwen3State) -> int, long {
        if _logits(s) != 0 { return 1, 0L }
        return _argmaxLogits(s)
    }

    // Generate one assistant turn for Qwen-style chat prompts.
    // - Expects `promptIds` to already include `<|im_start|>assistant\n` (and optional empty think block).
    // - Stops on `<|im_end|>` (cfg.eos) after at least one non-control token.
    // - Bans control tokens like `<|im_start|>` to keep output clean.
    fn generateChatTurn(let s: Qwen3State, promptIds: long[], opts: LlmOptions) -> int, long[] {
        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        // Qwen3 tokenizer added token ids (from tokenizer_config.json).
        let eot: long = 151643L // <|endoftext|>
        let imStart: long = 151644L // <|im_start|>
        let think: long = 151667L // <think>
        let endThink: long = 151668L // </think>

        // We do not support tools or multimodal tokens yet; ban them to keep generation clean.
        let objRefStart: long = 151646L
        let objRefEnd: long = 151647L
        let boxStart: long = 151648L
        let boxEnd: long = 151649L
        let quadStart: long = 151650L
        let quadEnd: long = 151651L
        let visionStart: long = 151652L
        let visionEnd: long = 151653L
        let visionPad: long = 151654L
        let imagePad: long = 151655L
        let videoPad: long = 151656L
        let toolCall: long = 151657L
        let toolCallEnd: long = 151658L
        let fimPrefix: long = 151659L
        let fimMiddle: long = 151660L
        let fimSuffix: long = 151661L
        let fimPad: long = 151662L
        let repoName: long = 151663L
        let fileSep: long = 151664L
        let toolResp: long = 151665L
        let toolRespEnd: long = 151666L

        let out: long[] = {}
        let t: int = 0
        let seenContent: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }

            // Ban control tokens from being generated as content.
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, imStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eot)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, objRefStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, objRefEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, boxStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, boxEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, quadStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, quadEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, visionStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, visionEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, visionPad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, imagePad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, videoPad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCall)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCallEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolResp)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolRespEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimPrefix)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimMiddle)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimSuffix)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fimPad)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, repoName)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, fileSep)
            if opts.enableThinking == 0 {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, think)
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, endThink)
            }

            // Avoid immediately ending the turn before any content.
            if t < 4 && seenContent == 0 {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
            }

            let nextId: long = 0L
            let tries: int = 0
            while tries < 4 {
                if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                    let ae, id = _argmaxLogits(s)
                    if ae != 0 { return 3, null }
                    nextId = id
                } else {
                    let outIdx: long = 0L
                    let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                    if se != 0 { return 3, null }
                    nextId = outIdx
                }

                if nextId == eos && seenContent == 0 {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
                    tries = tries + 1
                    continue
                }
                break
            }

            if nextId == eos { break }

            out.push(nextId)
            ctx.push(nextId)
            if nextId != imStart && nextId != eot && nextId != think && nextId != endThink {
                seenContent = 1
            }

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }

            t = t + 1
        }
        return 0, out
    }

    // Deterministic generation: argmax for up to `maxNewTokens`, stopping on EOS.
    fn generateArgmax(let s: Qwen3State, promptIds: long[], maxNewTokens: int) -> int, long[] {
        if maxNewTokens < 0 { return 1, null }
        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let logits: bytes = s.logits

        let out: long[] = {}
        let t: int = 0
        while t < maxNewTokens {
            if _logits(s) != 0 { return 3, null }
            // Default repetition penalty to reduce loopy greedy outputs.
            let _ = tua_llm_repetition_penalty_f32(logits, 0L, cfg.vocab, ctx, 64, 1.1)
            let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, cfg.vocab, ctx, 3)
            let ae, nextId = _argmaxLogits(s)
            if ae != 0 { return 3, null }
            out.push(nextId)
            ctx.push(nextId)
            if nextId == eos { break }

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }

    // Sampling-based generation.
    fn generate(let s: Qwen3State, promptIds: long[], opts: LlmOptions) -> int, long[] {
        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        let out: long[] = {}
        let t: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }
            let nextId: long = 0L
            if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                let ae, id = _argmaxLogits(s)
                if ae != 0 { return 3, null }
                nextId = id
            } else {
                let outIdx: long = 0L
                let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                if se != 0 { return 3, null }
                nextId = outIdx
            }

            out.push(nextId)
            ctx.push(nextId)
            if nextId == eos { break }

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }

    fn generateWithStops(let s: Qwen3State, promptIds: long[], opts: LlmOptions, stopIds: long[]) -> int, long[] {
        if stopIds == null || stopIds.len() == 0 {
            return Qwen3Infer.generate(s, promptIds, opts)
        }

        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        let out: long[] = {}
        let t: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }
            let nextId: long = 0L
            if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                let ae, id = _argmaxLogits(s)
                if ae != 0 { return 3, null }
                nextId = id
            } else {
                let outIdx: long = 0L
                let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                if se != 0 { return 3, null }
                nextId = outIdx
            }

            if nextId == eos { break }
            let si: int = 0
            while si < stopIds.len() {
                if nextId == stopIds[si] { return 0, out }
                si = si + 1
            }

            out.push(nextId)
            ctx.push(nextId)

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }

    // Like `generateWithStops`, but prevents "empty/too-short" answers by banning EOS and stop ids
    // for the first `minTokensBeforeStop` generated tokens.
    fn generateWithStopsNoEarlyStop(let s: Qwen3State, promptIds: long[], opts: LlmOptions, stopIds: long[], minTokensBeforeStop: int) -> int, long[] {
        if stopIds == null || stopIds.len() == 0 {
            return Qwen3Infer.generate(s, promptIds, opts)
        }
        let minStop: int = minTokensBeforeStop
        if minStop < 0 { minStop = 0 }

        let maxNew: int = opts.maxNewTokens
        if maxNew < 0 { return 1, null }

        let pe, ctx0 = _prefillAndGetCtx(s, promptIds)
        if pe != 0 { return 2, null }
        let ctx: long[] = ctx0
        let cfg: Qwen3Config = s.cfg
        let eos: long = cfg.eos
        let vocab: int = cfg.vocab
        let logits: bytes = s.logits

        let rng: long = opts.seed
        if rng == 0L {
            rng = time.Time.realNs()
            if rng == 0L { rng = -7046029254386353131L }
        }

        // Ban Qwen control/tool tokens to keep raw mode cleaner.
        let eot: long = 151643L // <|endoftext|>
        let imStart: long = 151644L // <|im_start|>
        let toolCall: long = 151657L
        let toolCallEnd: long = 151658L
        let toolResp: long = 151665L
        let toolRespEnd: long = 151666L

        let out: long[] = {}
        let t: int = 0
        while t < maxNew {
            if _logits(s) != 0 { return 3, null }
            if opts.repeatPenalty > 1.0 && opts.repeatLastN > 0 {
                let _ = tua_llm_repetition_penalty_f32(logits, 0L, vocab, ctx, opts.repeatLastN, opts.repeatPenalty)
            }
            if opts.noRepeatNgram > 1 {
                let _ = tua_llm_no_repeat_ngram_f32(logits, 0L, vocab, ctx, opts.noRepeatNgram)
            }

            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, imStart)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCall)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolCallEnd)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolResp)
            let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, toolRespEnd)

            if t < minStop {
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eos)
                let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, eot)
                let si0: int = 0
                while si0 < stopIds.len() {
                    let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, stopIds[si0])
                    si0 = si0 + 1
                }
            }

            let nextId: long = 0L
            let tries: int = 0
            while tries < 8 {
                if opts.temperature <= 0.0 || opts.topK == 1 || (opts.topK <= 0 && opts.topP <= 0.0) {
                    let ae, id = _argmaxLogits(s)
                    if ae != 0 { return 3, null }
                    nextId = id
                } else {
                    let outIdx: long = 0L
                    let se = tua_llm_sample_topk_topp_f32(logits, 0L, vocab, opts.topK, opts.topP, opts.temperature, &rng, &outIdx)
                    if se != 0 { return 3, null }
                    nextId = outIdx
                }

                if t < minStop {
                    if nextId == eos || nextId == eot {
                        let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                        tries = tries + 1
                        continue
                    }
                    let si1: int = 0
                    let isStop: int = 0
                    while si1 < stopIds.len() {
                        if nextId == stopIds[si1] { isStop = 1; break }
                        si1 = si1 + 1
                    }
                    if isStop != 0 {
                        let _ = tua_llm_logit_ban_id_f32(logits, 0L, vocab, nextId)
                        tries = tries + 1
                        continue
                    }
                }
                break
            }

            if nextId == eos { break }
            let si: int = 0
            while si < stopIds.len() {
                if nextId == stopIds[si] { return 0, out }
                si = si + 1
            }

            out.push(nextId)
            ctx.push(nextId)

            let e2 = _forwardToken(s, nextId)
            if e2 == 2 {
                let maxSeq: int = s.kvMaxSeq
                if maxSeq <= 1 { return 4, null }
                let replay: int = maxSeq - 1
                let start: int = ctx.len() - replay
                if start < 0 { start = 0 }
                _clearKv(s)
                let j: int = start
                while j < ctx.len() - 1 {
                    let re = _forwardToken(s, ctx[j])
                    if re != 0 { return 4, null }
                    j = j + 1
                }
                let re2 = _forwardToken(s, nextId)
                if re2 != 0 { return 4, null }
            } else if e2 != 0 {
                return 4, null
            }
            t = t + 1
        }
        return 0, out
    }
}

object Qwen3Bench {
    // Prefill prompt ids, then run 1 decode step (and return the generated token id).
    fn prefillAndDecode1(let s: Qwen3State, promptIds: long[]) -> int, long {
        if promptIds == null { return 1, 0L }
        if promptIds.len() == 0 { return 1, 0L }
        let t0 = time.Time.monoNs()

        let i: int = 0
        while i < promptIds.len() {
            let e = _forwardToken(s, promptIds[i])
            if e != 0 { return 1, 0L }
            i = i + 1
        }

        if _logits(s) != 0 { return 1, 0L }
        let ae, nextId = _argmaxLogits(s)
        if ae != 0 { return 1, 0L }

        // One decode step to exercise KV usage; ignore its next logits.
        let e2 = _forwardToken(s, nextId)
        if e2 != 0 { return 1, 0L }

        let t1 = time.Time.monoNs()
        let dtMs: long = (t1 - t0) / 1000000L
        println("prefill+decode1: promptLen={} dtMs={} nextId={}", promptIds.len(), dtMs, nextId)
        return 0, nextId
    }
}
