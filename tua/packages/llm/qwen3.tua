struct Qwen3Config {
    hidden: int
    intermediate: int
    layers: int
    heads: int
    kvHeads: int
    headDim: int
    vocab: int
    maxPos: int
    ropeTheta: float
    rmsEps: float
    bos: long
    eos: long
}

private fn _scanLong(b: bytes, path: string) -> int, long {
    let e, v = j.Json.scanKeyPathLong(b, path)
    return e, v
}

private fn _scanBool(b: bytes, path: string) -> int, int {
    let e, v = j.Json.scanKeyPathBool(b, path)
    if v { return e, 1 }
    return e, 0
}

// object Qwen3 is declared below, after weight/scratch structs and helpers.

// Weights are stored as a single arena (dtype depends on load mode); each tensor is a byte offset into the arena.
// Per-layer offsets are packed as layerOffs[layer*LayerW._count + kind].
private enum LayerW {
    inNorm = 0,
    postNorm = 1,
    qNorm = 2,
    kNorm = 3,
    // Fused projections:
    // - qkvProj: [qdim + 2*kvdim, hidden]
    // - gateUpProj: [2*intermediate, hidden]
    qkvProj = 4,
    oProj = 5,
    gateUpProj = 6,
    downProj = 7,
    _count = 8,
}

struct Qwen3Weights {
    // 0 = f32 weights, 1 = bf16 weights, 2 = fp16 weights,
    // 3 = q4_0 weights, 4 = q4_k weights (packed from BF16),
    // 5 = gguf q4_k/q6_k weights (pre-quantized, mixed types).
    dtype: int
    arena: bytes
    offEmbed: long
    offLmHead: long
    offNorm: long
    layerOffs: long[]
    extraOffs: long[]
}

private fn _align(off: long, a: long) -> long {
    if a <= 1L { return off }
    let r = off - (off / a) * a
    if r == 0L { return off }
    return off + (a - r)
}

private fn _ggufBlkTensorName(layer: int, suffix: string) -> string {
    if suffix == null { return null }
    let idx: string = conv.Int.toString(layer)
    if idx == null { return null }
    let p0: bytes = bstd.Bytes.fromString("blk.")
    let p1: bytes = bstd.Bytes.fromString(idx)
    let p2: bytes = bstd.Bytes.fromString(".")
    let p3: bytes = bstd.Bytes.fromString(suffix)
    if p0 == null || p1 == null || p2 == null || p3 == null { return null }
    let n0: long = bstd.Bytes.len(p0)
    let n1: long = bstd.Bytes.len(p1)
    let n2: long = bstd.Bytes.len(p2)
    let n3: long = bstd.Bytes.len(p3)
    let total: long = n0 + n1 + n2 + n3
    if total <= 0L { return null }
    let buf: bytes = bstd.Bytes.newLongUninit(total)
    if buf == null { return null }
    let o: long = 0L
    if bstd.Bytes.copy(buf, o, p0, 0L, n0) != 0 { return null }
    o = o + n0
    if bstd.Bytes.copy(buf, o, p1, 0L, n1) != 0 { return null }
    o = o + n1
    if bstd.Bytes.copy(buf, o, p2, 0L, n2) != 0 { return null }
    o = o + n2
    if bstd.Bytes.copy(buf, o, p3, 0L, n3) != 0 { return null }
    let out: string = tua_str_from_bytes_copy(buf, 0L, total)
    return out
}

// For GGUF mixed-type weights, encode (offset, kind) into a single long to avoid extra side arrays.
// kind: 0 = Q4_K, 1 = Q6_K.
private fn _packOffKind(off: long, kind: int) -> long {
    return off * 4L + (long)kind
}

private fn _unpackOff(packed: long) -> long {
    return packed / 4L
}

private fn _unpackKind(packed: long) -> int {
    let q: long = packed / 4L
    return (int)(packed - q * 4L)
}

private fn _q4RowBytes(n: int) -> long {
    // Q4_0: 32 values per block, 18 bytes per block.
    if n <= 0 { return 0L }
    let r = n - (n / 32) * 32
    if r != 0 { return 0L }
    return (long)(n / 32) * 18L
}

private fn _q4MatBytes(m: int, n: int) -> long {
    if m <= 0 || n <= 0 { return 0L }
    let rb = _q4RowBytes(n)
    if rb <= 0L { return 0L }
    return rb * (long)m
}

private fn _q4kRowBytes(n: int) -> long {
    // Q4_K: 256 values per block, 144 bytes per block.
    if n <= 0 { return 0L }
    let r = n - (n / 256) * 256
    if r != 0 { return 0L }
    return (long)(n / 256) * 144L
}

private fn _q4kMatBytes(m: int, n: int) -> long {
    if m <= 0 || n <= 0 { return 0L }
    let rb = _q4kRowBytes(n)
    if rb <= 0L { return 0L }
    return rb * (long)m
}

private fn _q6kRowBytes(n: int) -> long {
    // Q6_K: 256 values per block, 210 bytes per block.
    if n <= 0 { return 0L }
    let r = n - (n / 256) * 256
    if r != 0 { return 0L }
    return (long)(n / 256) * 210L
}

private fn _q6kMatBytes(m: int, n: int) -> long {
    if m <= 0 || n <= 0 { return 0L }
    let rb = _q6kRowBytes(n)
    if rb <= 0L { return 0L }
    return rb * (long)m
}

private fn _layerOff(offs: long[], layer: int, kind: int) -> long {
    let idx: int = layer * (int)LayerW._count + kind
    return offs[idx]
}

private fn _tensorNumelBF16(st: SafeTensorsFile, name: string) -> int, long, long {
    let ie, recAny = SafeTensors.tensorInfo(st, name)
    if ie != 0 { return 1, 0L, 0L }
    if recAny == null { return 1, 0L, 0L }
    let rec: map = recAny
    let dtAny: any = rec["dtype"].unwrap()
    let dt: int = (int)dtAny
    // BF16 = 2 (SafeDtype.bfloat16); use literal to avoid enum typing edge cases.
    if dt != 2 { return 2, 0L, 0L }
    let offAny: any = rec["dataOff"].unwrap()
    let lenAny: any = rec["dataLen"].unwrap()
    let dataOff: long = (long)offAny
    let dataLen: long = (long)lenAny
    let r = dataLen - (dataLen / 2L) * 2L
    if dataLen < 0L { return 3, 0L, 0L }
    if r != 0L { return 3, 0L, 0L }
    return 0, dataOff, dataLen / 2L
}

private fn _tensorNumelF16(st: SafeTensorsFile, name: string) -> int, long, long {
    let ie, recAny = SafeTensors.tensorInfo(st, name)
    if ie != 0 { return 1, 0L, 0L }
    if recAny == null { return 1, 0L, 0L }
    let rec: map = recAny
    let dtAny: any = rec["dtype"].unwrap()
    let dt: int = (int)dtAny
    // F16 = 1 (SafeDtype.float16); use literal to avoid enum typing edge cases.
    if dt != 1 { return 2, 0L, 0L }
    let offAny: any = rec["dataOff"].unwrap()
    let lenAny: any = rec["dataLen"].unwrap()
    let dataOff: long = (long)offAny
    let dataLen: long = (long)lenAny
    let r = dataLen - (dataLen / 2L) * 2L
    if dataLen < 0L { return 3, 0L, 0L }
    if r != 0L { return 3, 0L, 0L }
    return 0, dataOff, dataLen / 2L
}

private fn _convertTensorBF16ToF32(st: SafeTensorsFile, base: long, name: string, arena: bytes, dstOff: long) -> int, long {
    let te, dataOff, numel = _tensorNumelBF16(st, name)
    if te != 0 { return te, 0L }
    let e = tua_bytes_bf16_to_f32(st.data, base + dataOff, arena, dstOff, numel)
    if e != 0 { return 4, 0L }
    return 0, numel
}

private fn _convertTensorF16ToF32(st: SafeTensorsFile, base: long, name: string, arena: bytes, dstOff: long) -> int, long {
    let te, dataOff, numel = _tensorNumelF16(st, name)
    if te != 0 { return te, 0L }
    let e = tua_bytes_f16_to_f32(st.data, base + dataOff, arena, dstOff, numel)
    if e != 0 { return 4, 0L }
    return 0, numel
}

private fn _layerPrefix(i: int) -> string {
    return "model.layers." + conv.Int.toString(i) + "."
}

struct Qwen3Scratch {
    x: bytes
    x1: bytes
    x2: bytes
    qkv: bytes
    attn: bytes
    gateUp: bytes
    inter: bytes
    logits: bytes
    scores: bytes
}

private fn _f32Bytes(n: long) -> bytes { return bstd.Bytes.newLong(n * 4L) }

struct Qwen3Profile {
    enabled: int

    // Token counts (note: decodeTokens counts newly generated tokens only).
    prefillTokens: int
    decodeTokens: int
    replayTokens: int

    // High-level timing buckets (nanoseconds).
    nsPrefillForward: long
    nsDecodeForward: long
    nsReplayForward: long
    nsLogits: long
    nsPenalty: long
    nsSample: long

    // Sub-buckets (nanoseconds).
    nsEmbed: long
    nsInNorm: long
    nsQkv: long
    nsQkNorm: long
    nsRope: long
    nsKvStore: long
    nsAttn: long
    nsO: long
    nsPostNorm: long
    nsGateUp: long
    nsSiluMul: long
    nsDown: long
    nsFinalNorm: long
    nsLmHead: long
    nsArgmax: long
    nsSampleTop: long

    // Call counts.
    cQkv: int
    cO: int
    cGateUp: int
    cDown: int
    cLmHead: int
}

object Qwen3Profile {
    fn dump(p: Qwen3Profile) {
        if p.enabled != 0 {
            let prefillMs: double = (double)p.nsPrefillForward / 1000000.0
            let decodeMs: double = (double)p.nsDecodeForward / 1000000.0
            let replayMs: double = (double)p.nsReplayForward / 1000000.0
            let logitsMs: double = (double)p.nsLogits / 1000000.0
            let penaltyMs: double = (double)p.nsPenalty / 1000000.0
            let sampleMs: double = (double)p.nsSample / 1000000.0
            let qkvMs: double = (double)p.nsQkv / 1000000.0
            let oMs: double = (double)p.nsO / 1000000.0
            let gateUpMs: double = (double)p.nsGateUp / 1000000.0
            let downMs: double = (double)p.nsDown / 1000000.0
            let lmHeadMs: double = (double)p.nsLmHead / 1000000.0
            let attnMs: double = (double)p.nsAttn / 1000000.0
            let kvStoreMs: double = (double)p.nsKvStore / 1000000.0
            let embedMs: double = (double)p.nsEmbed / 1000000.0
            let argmaxMs: double = (double)p.nsArgmax / 1000000.0
            let sampleTopMs: double = (double)p.nsSampleTop / 1000000.0

            println("profile: prefillTok={} decodeTok={} replayTok={}", p.prefillTokens, p.decodeTokens, p.replayTokens)
            println("profile: prefill_forward_ms={} decode_forward_ms={} replay_forward_ms={}", prefillMs, decodeMs, replayMs)
            println("profile: logits_ms={} penalty_ms={} sample_ms={}", logitsMs, penaltyMs, sampleMs)
            println("profile: gemv_ms qkv={} o={} gateUp={} down={} lm_head={}", qkvMs, oMs, gateUpMs, downMs, lmHeadMs)
            println("profile: attn_ms={} kv_store_ms={} embed_ms={}", attnMs, kvStoreMs, embedMs)
            println("profile: argmax_ms={} sample_top_ms={}", argmaxMs, sampleTopMs)
        }
    }
}

struct Qwen3State {
    cfg: Qwen3Config
    be: OpsBackend
    pos: int

    // Weights (float32 arena + offsets).
    wDtype: int
    wArena: bytes
    wOffEmbed: long
    wOffLmHead: long
    wOffNorm: long
    wLayerOffs: long[]
    wLayerExtraOffs: long[]

    // KV cache (float32).
    kvDtype: int
    kvBuf: bytes
    kvKBase: long
    kvVBase: long
    kvLayerBytes: long
    kvTokenBytes: long
    kvMaxSeq: int

    // Scratch buffers (float32).
    x: bytes
    x1: bytes
    x2: bytes
    qkv: bytes
    attn: bytes
    gateUp: bytes
    inter: bytes
    logits: bytes
    scores: bytes

    prof: Qwen3Profile
}

private fn _minInt(a: int, b: int) -> int { if a < b { return a } return b }

private fn _kvMaxSeqForBytes(cfg: Qwen3Config, bytes: long, kvDtype: int) -> int {
    if bytes <= 0L { return 0 }
    let elemBytes: long = 4L
    if kvDtype == 1 || kvDtype == 2 { elemBytes = 2L }
    let denom: long = 2L * (long)cfg.layers * (long)cfg.kvHeads * (long)cfg.headDim * elemBytes
    if denom <= 0L { return 0 }
    let m: long = bytes / denom
    if m <= 0L { return 0 }
    if m > 2147483647L { return 2147483647 }
    return (int)m
}

private fn _maxSeq(cfg: Qwen3Config, opts: LlmOptions) -> int {
    let maxSeq = cfg.maxPos
    if opts.kvMaxSeq <= 0 && opts.kvMaxBytes <= 0L {
        // Default to a safe KV window for usability; model configs often allow very large max_position_embeddings.
        maxSeq = _minInt(maxSeq, 2048)
    }
    if opts.kvMaxSeq > 0 {
        if opts.kvMaxSeq < maxSeq { maxSeq = opts.kvMaxSeq }
    }
    if opts.kvMaxBytes > 0L {
        let m2 = _kvMaxSeqForBytes(cfg, opts.kvMaxBytes, opts.kvDtype)
        if m2 <= 0 { return 0 }
        if m2 < maxSeq { maxSeq = m2 }
    }
    if maxSeq < 1 { return 0 }
    return maxSeq
}

object Qwen3 {
    fn loadConfig(path: string) -> int, Qwen3Config {
        let z = Qwen3Config{ hidden: 0, intermediate: 0, layers: 0, heads: 0, kvHeads: 0, headDim: 0, vocab: 0, maxPos: 0, ropeTheta: 1000000.0, rmsEps: 0.000001, bos: 0L, eos: 0L }

        let e0, b = bstd.Bytes.mmapFile(path)
        if e0 != 0 { return 1, z }

        let e1, hs = _scanLong(b, "hidden_size")
        if e1 != 0 { return 1, z }
        let e2, inter = _scanLong(b, "intermediate_size")
        if e2 != 0 { return 1, z }
        let e3, nl = _scanLong(b, "num_hidden_layers")
        if e3 != 0 { return 1, z }
        let e4, nh = _scanLong(b, "num_attention_heads")
        if e4 != 0 { return 1, z }
        let e5, nkv = _scanLong(b, "num_key_value_heads")
        if e5 != 0 { return 1, z }
        let e6, hd = _scanLong(b, "head_dim")
        if e6 != 0 { return 1, z }
        let e7, vs = _scanLong(b, "vocab_size")
        if e7 != 0 { return 1, z }
        let e8, mp = _scanLong(b, "max_position_embeddings")
        if e8 != 0 { return 1, z }
        let e9, bos = _scanLong(b, "bos_token_id")
        if e9 != 0 { return 1, z }
        let e10, eos = _scanLong(b, "eos_token_id")
        if e10 != 0 { return 1, z }
        let e11, rope = _scanLong(b, "rope_theta")
        if e11 == 0 { z.ropeTheta = (float)(double)rope }

        // Small config: use DOM for rms_norm_eps (float).
        let pe, rootAny = j.Json.parseBytes(b)
        if pe == 0 {
            if rootAny != null {
            let root: map = rootAny
            let oeps = root["rms_norm_eps"]
            if oeps.isSome() {
                let v:any = oeps.unwrap()
                z.rmsEps = (float)(double)v
            }
            }
        }

        z.hidden = (int)hs
        z.intermediate = (int)inter
        z.layers = (int)nl
        z.heads = (int)nh
        z.kvHeads = (int)nkv
        z.headDim = (int)hd
        z.vocab = (int)vs
        z.maxPos = (int)mp
        z.bos = bos
        z.eos = eos
        return 0, z
    }

    fn loadWeightsF32(modelPath: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        let z = Qwen3Weights{ dtype: 0, arena: null, offEmbed: 0L, offLmHead: 0L, offNorm: 0L, layerOffs: null, extraOffs: null }

        let e0, st = SafeTensors.parseMmap(modelPath)
        if e0 != 0 { return 10 + e0, z }
        if st.data == null { return 11, z }
        let base: long = 8L + st.headerLen

        // Pass 1: size.
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, tmpOff1, nEmbed = _tensorNumelBF16(st, "model.embed_tokens.weight")
        let _ = tmpOff1
        if e1 != 0 { return 100 + e1, z }
        cur = cur + nEmbed * 4L

        // Some checkpoints tie `lm_head.weight` with `model.embed_tokens.weight` and omit `lm_head.weight`.
        let e2, tmpOff2, nLm = _tensorNumelBF16(st, "lm_head.weight")
        let _ = tmpOff2
        if e2 == 1 {
            lmIsTied = 1
            offLm = offEmbed
        } else {
            if e2 != 0 { return 200 + e2, z }
            cur = _align(cur, 64L)
            offLm = cur
            cur = cur + nLm * 4L
        }

        cur = _align(cur, 64L)
        offNorm = cur
        let e3, tmpOff3, nNorm = _tensorNumelBF16(st, "model.norm.weight")
        let _ = tmpOff3
        if e3 != 0 { return 300 + e3, z }
        cur = cur + nNorm * 4L

        let li: int = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e0, tmpOff0, n0 = _tensorNumelBF16(st, pre + "input_layernorm.weight")
            let _ = tmpOff0
            if e0 != 0 { return 1000 + li * 64 + 0 * 4 + e0, z }
            cur = cur + n0 * 4L

            // postNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e1b, tmpOff1b, n1b = _tensorNumelBF16(st, pre + "post_attention_layernorm.weight")
            let _ = tmpOff1b
            if e1b != 0 { return 1000 + li * 64 + 1 * 4 + e1b, z }
            cur = cur + n1b * 4L

            // qNorm/kNorm
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e2b, tmpOff2b, n2b = _tensorNumelBF16(st, pre + "self_attn.q_norm.weight")
            let _ = tmpOff2b
            if e2b != 0 { return 1000 + li * 64 + 2 * 4 + e2b, z }
            cur = cur + n2b * 4L

            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e3b, tmpOff3b, n3b = _tensorNumelBF16(st, pre + "self_attn.k_norm.weight")
            let _ = tmpOff3b
            if e3b != 0 { return 1000 + li * 64 + 3 * 4 + e3b, z }
            cur = cur + n3b * 4L

            // Fused QKV projection.
            let eq, _, nq = _tensorNumelBF16(st, pre + "self_attn.q_proj.weight")
            if eq != 0 { return 1000 + li * 64 + 4 * 4 + eq, z }
            let ek, _, nk = _tensorNumelBF16(st, pre + "self_attn.k_proj.weight")
            if ek != 0 { return 1000 + li * 64 + 5 * 4 + ek, z }
            let ev, _, nv = _tensorNumelBF16(st, pre + "self_attn.v_proj.weight")
            if ev != 0 { return 1000 + li * 64 + 6 * 4 + ev, z }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (nq + nk + nv) * 4L

            // oProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e7b, _, n7b = _tensorNumelBF16(st, pre + "self_attn.o_proj.weight")
            if e7b != 0 { return 1000 + li * 64 + 7 * 4 + e7b, z }
            cur = cur + n7b * 4L

            // Fused gate+up projection.
            let eg, _, ng = _tensorNumelBF16(st, pre + "mlp.gate_proj.weight")
            if eg != 0 { return 1000 + li * 64 + 8 * 4 + eg, z }
            let eu, _, nu = _tensorNumelBF16(st, pre + "mlp.up_proj.weight")
            if eu != 0 { return 1000 + li * 64 + 9 * 4 + eu, z }
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            cur = cur + (ng + nu) * 4L

            // downProj
            cur = _align(cur, 64L)
            layerOffs.push(cur)
            let e10b, _, n10b = _tensorNumelBF16(st, pre + "mlp.down_proj.weight")
            if e10b != 0 { return 1000 + li * 64 + 10 * 4 + e10b, z }
            cur = cur + n10b * 4L

            li = li + 1
        }

        let arena = bstd.Bytes.newLongUninit(cur)
        if arena == null { return 5, z }

        let ce, tmpNum = _convertTensorBF16ToF32(st, base, "model.embed_tokens.weight", arena, offEmbed)
        let _ = tmpNum
        if ce != 0 { return 500 + ce, z }
        if lmIsTied == 0 {
            let ce2, tmpNum2 = _convertTensorBF16ToF32(st, base, "lm_head.weight", arena, offLm)
            let _ = tmpNum2
            if ce2 != 0 { return 600 + ce2, z }
        }
        let ce3, tmpNum3 = _convertTensorBF16ToF32(st, base, "model.norm.weight", arena, offNorm)
        let _ = tmpNum3
        if ce3 != 0 { return 700 + ce3, z }

        let idx: int = 0
        li = 0
        while li < cfg.layers {
            let pre = _layerPrefix(li)

            // inNorm/postNorm/qNorm/kNorm
            let dstOff0 = layerOffs[idx]
            let e0c, _ = _convertTensorBF16ToF32(st, base, pre + "input_layernorm.weight", arena, dstOff0)
            if e0c != 0 { return 2000 + idx * 4 + e0c, z }
            idx = idx + 1

            let dstOff1 = layerOffs[idx]
            let e1c, _ = _convertTensorBF16ToF32(st, base, pre + "post_attention_layernorm.weight", arena, dstOff1)
            if e1c != 0 { return 2000 + idx * 4 + e1c, z }
            idx = idx + 1

            let dstOff2 = layerOffs[idx]
            let e2c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.q_norm.weight", arena, dstOff2)
            if e2c != 0 { return 2000 + idx * 4 + e2c, z }
            idx = idx + 1

            let dstOff3 = layerOffs[idx]
            let e3c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.k_norm.weight", arena, dstOff3)
            if e3c != 0 { return 2000 + idx * 4 + e3c, z }
            idx = idx + 1

            // qkvProj (fused)
            let dstQkv = layerOffs[idx]
            let e4c, nQ = _convertTensorBF16ToF32(st, base, pre + "self_attn.q_proj.weight", arena, dstQkv)
            if e4c != 0 { return 2000 + idx * 4 + e4c, z }
            let kDst: long = dstQkv + nQ * 4L
            let e5c, nK = _convertTensorBF16ToF32(st, base, pre + "self_attn.k_proj.weight", arena, kDst)
            if e5c != 0 { return 2000 + idx * 4 + e5c, z }
            let vDst: long = kDst + nK * 4L
            let e6c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.v_proj.weight", arena, vDst)
            if e6c != 0 { return 2000 + idx * 4 + e6c, z }
            idx = idx + 1

            // oProj
            let dstO = layerOffs[idx]
            let e7c, _ = _convertTensorBF16ToF32(st, base, pre + "self_attn.o_proj.weight", arena, dstO)
            if e7c != 0 { return 2000 + idx * 4 + e7c, z }
            idx = idx + 1

            // gateUpProj (fused)
            let dstGateUp = layerOffs[idx]
            let e8c, nGate = _convertTensorBF16ToF32(st, base, pre + "mlp.gate_proj.weight", arena, dstGateUp)
            if e8c != 0 { return 2000 + idx * 4 + e8c, z }
            let upDst: long = dstGateUp + nGate * 4L
            let e9c, _ = _convertTensorBF16ToF32(st, base, pre + "mlp.up_proj.weight", arena, upDst)
            if e9c != 0 { return 2000 + idx * 4 + e9c, z }
            idx = idx + 1

            // downProj
            let dstDown = layerOffs[idx]
            let e10c, _ = _convertTensorBF16ToF32(st, base, pre + "mlp.down_proj.weight", arena, dstDown)
            if e10c != 0 { return 2000 + idx * 4 + e10c, z }
            idx = idx + 1

            li = li + 1
        }

        let out = Qwen3Weights{ dtype: 0, arena: arena, offEmbed: offEmbed, offLmHead: offLm, offNorm: offNorm, layerOffs: layerOffs, extraOffs: null }
        return 0, out
    }

    private fn _copyTensorBF16(st: SafeTensorsFile, base: long, name: string, arena: bytes, dstOff: long) -> int, long {
        let te, dataOff, numel = _tensorNumelBF16(st, name)
        if te != 0 { return te, 0L }
        let nbytes: long = numel * 2L
        let ce = bstd.Bytes.copy(arena, dstOff, st.data, base + dataOff, nbytes)
        if ce != 0 { return 4, 0L }
        return 0, numel
    }

    private fn _copyTensorF16(st: SafeTensorsFile, base: long, name: string, arena: bytes, dstOff: long) -> int, long {
        let te, dataOff, numel = _tensorNumelF16(st, name)
        if te != 0 { return te, 0L }
        let nbytes: long = numel * 2L
        let ce = bstd.Bytes.copy(arena, dstOff, st.data, base + dataOff, nbytes)
        if ce != 0 { return 4, 0L }
        return 0, numel
    }

    fn loadWeightsBF16(modelPath: string, cfg: Qwen3Config) -> int, Qwen3Weights {
        let z = Qwen3Weights{ dtype: 1, arena: null, offEmbed: 0L, offLmHead: 0L, offNorm: 0L, layerOffs: null, extraOffs: null }

        let e0, st = SafeTensors.parseMmap(modelPath)
        if e0 != 0 { return 10 + e0, z }
        if st.data == null { return 11, z }
        let base: long = 8L + st.headerLen

        // Pass 1: size (bf16 bytes).
        let cur: long = 0L
        let offEmbed: long = 0L
        let offLm: long = 0L
        let offNorm: long = 0L
        let lmIsTied: int = 0
        let layerOffs: long[] = {}

        cur = _align(cur, 64L)
        offEmbed = cur
        let e1, _, nEmbed = _tensorNumelBF16(st, "model.embed_tokens.weight")
