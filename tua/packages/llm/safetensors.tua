import "std/bytes" as bstd

extern fn tua_map_new() -> map
extern fn tua_bytes_data_at(b: bytes, off: long) -> ptr
extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string

enum SafeDtype {
    float32 = 0,
    float16 = 1,
    bfloat16 = 2,
    int64 = 3,
    uint8 = 4,
}

struct TensorInfo {
    // Deprecated: prefer using the per-tensor record `map` returned by `tensorInfo`.
    // Kept as a placeholder for future typed APIs.
    _dummy: int = 0
}

struct SafeTensorsFile {
    data: bytes
    headerLen: long
    tensors: map // string -> map (scalar fields only)
    metadata: map
}

private fn _dtypeFromString(s: string) -> int, int {
    if s == "F32" { return 0, SafeDtype.float32 }
    if s == "F16" { return 0, SafeDtype.float16 }
    if s == "BF16" { return 0, SafeDtype.bfloat16 }
    if s == "I64" { return 0, SafeDtype.int64 }
    if s == "U8" { return 0, SafeDtype.uint8 }
    return 1, 0
}

private fn _isWs(c: int) -> bool {
    return c == 32 || c == 10 || c == 13 || c == 9
}

private fn _readU64LE(b: bytes, off: long) -> int, long {
    let e, v = bstd.Bytes.readU64LE(b, off)
    if e != 0 { return e, 0L }
    return 0, (long)v
}

private fn _skipWs(b: bytes, pos: long, n: long) -> int, long {
    let i = pos
    while true {
        if i >= n { break }
        let e, c = bstd.Bytes.getU8(b, i)
        if e != 0 { return 1, pos }
        if !_isWs(c) { break }
        i = i + 1L
    }
    return 0, i
}

private fn _expectByte(b: bytes, pos: long, n: long, want: int) -> int, long {
    if pos >= n { return 1, pos }
    let e, c = bstd.Bytes.getU8(b, pos)
    if e != 0 { return 1, pos }
    if c != want { return 1, pos }
    return 0, pos + 1L
}

private fn _scanStringEnd(b: bytes, pos: long, n: long) -> int, long, bool {
    // pos points at '"'
    if pos >= n { return 1, pos, false }
    let e0, q = bstd.Bytes.getU8(b, pos)
    if e0 != 0 { return 1, pos, false }
    if q != 34 { return 1, pos, false }

    let i = pos + 1L
    let hasEsc = false
    while true {
        if i >= n { break }
        let ei, c = bstd.Bytes.getU8(b, i)
        if ei != 0 { return 1, pos, false }
        if c == 92 { // '\\'
            hasEsc = true
            if i + 1L >= n { return 1, pos, false }
            i = i + 2L
            continue
        }
        if c == 34 { // '"'
            return 0, i, hasEsc
        }
        i = i + 1L
    }
    return 1, pos, false
}

private fn _parseString(b: bytes, pos: long, n: long) -> int, string, long {
    let e, end, hasEsc = _scanStringEnd(b, pos, n)
    if e != 0 { return 1, null, pos }

    let rawOff = pos + 1L
    let rawLen = end - rawOff
    if !hasEsc {
        let s = tua_str_from_bytes_copy(b, rawOff, rawLen)
        return 0, s, end + 1L
    }

    // Unescape a small subset sufficient for safetensors headers.
    let tmp = bstd.Bytes.new((int)rawLen)
    let outLen: long = 0L
    let i = rawOff
    while true {
        if i >= end { break }
        let ei, c = bstd.Bytes.getU8(b, i)
        if ei != 0 { return 1, null, pos }
        if c != 92 {
            bstd.Bytes.setU8(tmp, outLen, c)
            outLen = outLen + 1L
            i = i + 1L
            continue
        }
        if i + 1L >= end { return 1, null, pos }
        let ee, esc = bstd.Bytes.getU8(b, i + 1L)
        if ee != 0 { return 1, null, pos }
        if esc == 34 { bstd.Bytes.setU8(tmp, outLen, 34); outLen = outLen + 1L; i = i + 2L; continue } // \"
        if esc == 92 { bstd.Bytes.setU8(tmp, outLen, 92); outLen = outLen + 1L; i = i + 2L; continue } // \\
        if esc == 47 { bstd.Bytes.setU8(tmp, outLen, 47); outLen = outLen + 1L; i = i + 2L; continue } // \/
        if esc == 98 { bstd.Bytes.setU8(tmp, outLen, 8); outLen = outLen + 1L; i = i + 2L; continue }  // \b
        if esc == 102 { bstd.Bytes.setU8(tmp, outLen, 12); outLen = outLen + 1L; i = i + 2L; continue } // \f
        if esc == 110 { bstd.Bytes.setU8(tmp, outLen, 10); outLen = outLen + 1L; i = i + 2L; continue } // \n
        if esc == 114 { bstd.Bytes.setU8(tmp, outLen, 13); outLen = outLen + 1L; i = i + 2L; continue } // \r
        if esc == 116 { bstd.Bytes.setU8(tmp, outLen, 9); outLen = outLen + 1L; i = i + 2L; continue }  // \t
        // \uXXXX not expected in tensor names/dtype; reject for now.
        return 1, null, pos
    }
    let s = tua_str_from_bytes_copy(tmp, 0L, outLen)
    return 0, s, end + 1L
}

private fn _skipString(b: bytes, pos: long, n: long) -> int, long {
    let e, end, _ = _scanStringEnd(b, pos, n)
    if e != 0 { return 1, pos }
    return 0, end + 1L
}

private fn _isDigit(c: int) -> bool { return c >= 48 && c <= 57 }

private fn _parseInt(b: bytes, pos: long, n: long) -> int, long, long {
    let i = pos
    if i >= n { return 1, 0L, pos }
    let e0, c0 = bstd.Bytes.getU8(b, i)
    if e0 != 0 { return 1, 0L, pos }
    let sign: long = 1L
    if c0 == 45 { sign = -1L; i = i + 1L }
    if i >= n { return 1, 0L, pos }
    let e1, c1 = bstd.Bytes.getU8(b, i)
    if e1 != 0 { return 1, 0L, pos }
    if !_isDigit(c1) { return 1, 0L, pos }

    let v: long = 0L
    while true {
        if i >= n { break }
        let ei, c = bstd.Bytes.getU8(b, i)
        if ei != 0 { return 1, 0L, pos }
        if !_isDigit(c) { break }
        v = (v * 10L) + (long)(c - 48)
        i = i + 1L
    }
    return 0, v * sign, i
}

private fn _skipLiteral(b: bytes, pos: long, n: long, lit: int[]) -> int, long {
    let i: long = 0L
    while true {
        if i >= (long)lit.len() { break }
        let p = pos + i
        if p >= n { return 1, pos }
        let e, c = bstd.Bytes.getU8(b, p)
        if e != 0 { return 1, pos }
        if c != lit[(int)i] { return 1, pos }
        i = i + 1L
    }
    return 0, pos + (long)lit.len()
}

private fn _skipValue(b: bytes, pos: long, n: long) -> int, long {
    let e0, i0 = _skipWs(b, pos, n)
    if e0 != 0 { return 1, pos }
    if i0 >= n { return 1, pos }
    let ec, c = bstd.Bytes.getU8(b, i0)
    if ec != 0 { return 1, pos }

    if c == 34 {
        let es, p = _skipString(b, i0, n)
        return es, p
    } // '"'
    if c == 45 || _isDigit(c) {
        let en, _, j = _parseInt(b, i0, n)
        if en != 0 { return 1, pos }
        return 0, j
    }
    if c == 116 { // 't'
        let lit:int[] = {116,114,117,101} // true
        let el, p = _skipLiteral(b, i0, n, lit)
        return el, p
    }
    if c == 102 { // 'f'
        let lit:int[] = {102,97,108,115,101} // false
        let el, p = _skipLiteral(b, i0, n, lit)
        return el, p
    }
    if c == 110 { // 'n'
        let lit:int[] = {110,117,108,108} // null
        let el, p = _skipLiteral(b, i0, n, lit)
        return el, p
    }
    if c == 123 { // '{'
        let e1, i = _expectByte(b, i0, n, 123)
        if e1 != 0 { return 1, pos }
        while true {
            let ew, p = _skipWs(b, i, n)
            if ew != 0 { return 1, pos }
            if p >= n { return 1, pos }
            let ek, kch = bstd.Bytes.getU8(b, p)
            if ek != 0 { return 1, pos }
            if kch == 125 { return 0, p + 1L } // '}'
            // key
            let es, _, p2 = _parseString(b, p, n)
            if es != 0 { return 1, pos }
            let ew2, p3 = _skipWs(b, p2, n)
            if ew2 != 0 { return 1, pos }
            let ec2, p4 = _expectByte(b, p3, n, 58) // ':'
            if ec2 != 0 { return 1, pos }
            // value
            let ev, p5 = _skipValue(b, p4, n)
            if ev != 0 { return 1, pos }
            let ew3, p6 = _skipWs(b, p5, n)
            if ew3 != 0 { return 1, pos }
            if p6 >= n { return 1, pos }
            let ed, d = bstd.Bytes.getU8(b, p6)
            if ed != 0 { return 1, pos }
            if d == 44 { i = p6 + 1L; continue } // ','
            if d == 125 { return 0, p6 + 1L } // '}'
            return 1, pos
        }
    }
    if c == 91 { // '['
        let e1, i = _expectByte(b, i0, n, 91)
        if e1 != 0 { return 1, pos }
        while true {
            let ew, p = _skipWs(b, i, n)
            if ew != 0 { return 1, pos }
            if p >= n { return 1, pos }
            let ek, ch = bstd.Bytes.getU8(b, p)
            if ek != 0 { return 1, pos }
            if ch == 93 { return 0, p + 1L } // ']'
            let ev, p2 = _skipValue(b, p, n)
            if ev != 0 { return 1, pos }
            let ew2, p3 = _skipWs(b, p2, n)
            if ew2 != 0 { return 1, pos }
            if p3 >= n { return 1, pos }
            let ed, d = bstd.Bytes.getU8(b, p3)
            if ed != 0 { return 1, pos }
            if d == 44 { i = p3 + 1L; continue } // ','
            if d == 93 { return 0, p3 + 1L } // ']'
            return 1, pos
        }
    }

    return 1, pos
}

private fn _parseShapeArray(b: bytes, pos: long, n: long) -> int, int, long, long, long, long, long {
    // returns: err, ndim, d0..d3, nextPos
    let e0, i0 = _skipWs(b, pos, n)
    if e0 != 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }
    let e1, i1 = _expectByte(b, i0, n, 91) // '['
    if e1 != 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }

    let ndim: int = 0
    let d0: long = 0L
    let d1: long = 0L
    let d2: long = 0L
    let d3: long = 0L
    let i = i1
    while true {
        let ew, p = _skipWs(b, i, n)
        if ew != 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }
        if p >= n { return 1, 0, 0L, 0L, 0L, 0L, pos }
        let ec, ch = bstd.Bytes.getU8(b, p)
        if ec != 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }
        if ch == 93 { // ']'
            if ndim == 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }
            return 0, ndim, d0, d1, d2, d3, p + 1L
        }
        let en, v, p2 = _parseInt(b, p, n)
        if en != 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }
        if ndim == 0 { d0 = v }
        if ndim == 1 { d1 = v }
        if ndim == 2 { d2 = v }
        if ndim == 3 { d3 = v }
        ndim = ndim + 1
        if ndim > 4 { return 1, 0, 0L, 0L, 0L, 0L, pos }

        let ew2, p3 = _skipWs(b, p2, n)
        if ew2 != 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }
        if p3 >= n { return 1, 0, 0L, 0L, 0L, 0L, pos }
        let ed, d = bstd.Bytes.getU8(b, p3)
        if ed != 0 { return 1, 0, 0L, 0L, 0L, 0L, pos }
        if d == 44 { i = p3 + 1L; continue } // ','
        if d == 93 { return 0, ndim, d0, d1, d2, d3, p3 + 1L } // ']'
        return 1, 0, 0L, 0L, 0L, 0L, pos
    }
    return 1, 0, 0L, 0L, 0L, 0L, pos
}

private fn _parseOffsetsArray(b: bytes, pos: long, n: long) -> int, long, long, long {
    // returns: err, off0, off1, nextPos
    let e0, i0 = _skipWs(b, pos, n)
    if e0 != 0 { return 1, 0L, 0L, pos }
    let e1, i1 = _expectByte(b, i0, n, 91) // '['
    if e1 != 0 { return 1, 0L, 0L, pos }
    let e2, p0 = _skipWs(b, i1, n)
    if e2 != 0 { return 1, 0L, 0L, pos }
    let en0, off0, p1 = _parseInt(b, p0, n)
    if en0 != 0 { return 1, 0L, 0L, pos }
    let e3, p2 = _skipWs(b, p1, n)
    if e3 != 0 { return 1, 0L, 0L, pos }
    let e4, p3 = _expectByte(b, p2, n, 44) // ','
    if e4 != 0 { return 1, 0L, 0L, pos }
    let e5, p4 = _skipWs(b, p3, n)
    if e5 != 0 { return 1, 0L, 0L, pos }
    let en1, off1, p5 = _parseInt(b, p4, n)
    if en1 != 0 { return 1, 0L, 0L, pos }
    let e6, p6 = _skipWs(b, p5, n)
    if e6 != 0 { return 1, 0L, 0L, pos }
    let e7, p7 = _expectByte(b, p6, n, 93) // ']'
    if e7 != 0 { return 1, 0L, 0L, pos }
    return 0, off0, off1, p7
}

object SafeTensors {
    fn parseBytes(move b: bytes) -> int, SafeTensorsFile {
        let out = SafeTensorsFile{ data: null, headerLen: 0L, tensors: null, metadata: null }
        if b == null { return 1, out }
        let n = bstd.Bytes.len(b)
        if !(n >= 8L) { return 1, out }

        let he, headerLen = _readU64LE(b, 0L)
        if he != 0 { return 1, out }
        if !(headerLen >= 2L) { return 1, out }
        if headerLen > (n - 8) { return 1, out }

        let hdr = bstd.Bytes.new((int)headerLen)
        let ce = bstd.Bytes.copy(hdr, 0L, b, 8L, headerLen)
        if ce != 0 { return 1, out }

        let tensors: map = tua_map_new()
        // Parse header JSON directly (avoid building nested any/map/array trees).
        let hn = bstd.Bytes.len(hdr)
        let e0, p0 = _skipWs(hdr, 0L, hn)
        if e0 != 0 { return 1, out }
        let e1, p1 = _expectByte(hdr, p0, hn, 123) // '{'
        if e1 != 0 { return 1, out }

        let p = p1
        while true {
            let ew, p2 = _skipWs(hdr, p, hn)
            if ew != 0 { return 1, out }
            if p2 >= hn { return 1, out }
            let ec, ch = bstd.Bytes.getU8(hdr, p2)
            if ec != 0 { return 1, out }
            if ch == 125 { break } // '}'

            let ek, key, p3 = _parseString(hdr, p2, hn)
            if ek != 0 { return 1, out }
            let ew2, p4 = _skipWs(hdr, p3, hn)
            if ew2 != 0 { return 1, out }
            let ec2, p5 = _expectByte(hdr, p4, hn, 58) // ':'
            if ec2 != 0 { return 1, out }

            if key == "__metadata__" {
                let es, p6 = _skipValue(hdr, p5, hn)
                if es != 0 { return 1, out }
                p = p6
            } else {
                // Parse tensor entry object with keys: dtype, shape, data_offsets.
                let ew3, p6 = _skipWs(hdr, p5, hn)
                if ew3 != 0 { return 1, out }
                let eo, p7 = _expectByte(hdr, p6, hn, 123) // '{'
                if eo != 0 { return 1, out }

                let dt: int = -1
                let ndim: int = 0
                let d0: long = 0L
                let d1: long = 0L
                let d2: long = 0L
                let d3: long = 0L
                let off0: long = -1L
                let off1: long = -1L

                let q = p7
                while true {
                    let ewk, q2 = _skipWs(hdr, q, hn)
                    if ewk != 0 { return 1, out }
                    if q2 >= hn { return 1, out }
                    let ecc, c2 = bstd.Bytes.getU8(hdr, q2)
                    if ecc != 0 { return 1, out }
                    if c2 == 125 { q = q2 + 1L; break } // '}'

                    let efk, fk, q3 = _parseString(hdr, q2, hn)
                    if efk != 0 { return 1, out }
                    let ewk2, q4 = _skipWs(hdr, q3, hn)
                    if ewk2 != 0 { return 1, out }
                    let ecln, q5 = _expectByte(hdr, q4, hn, 58) // ':'
                    if ecln != 0 { return 1, out }

                    if fk == "dtype" {
                        let eds, dtStr, q6 = _parseString(hdr, q5, hn)
                        if eds != 0 { return 1, out }
                        let de, dti = _dtypeFromString(dtStr)
                        if de != 0 { return 1, out }
                        dt = dti
                        q = q6
                    } else if fk == "shape" {
                        let esh, nd, s0, s1, s2, s3, q6 = _parseShapeArray(hdr, q5, hn)
                        if esh != 0 { return 1, out }
                        ndim = nd
                        d0 = s0
                        d1 = s1
                        d2 = s2
                        d3 = s3
                        q = q6
                    } else if fk == "data_offsets" {
                        let eoff, a0, a1, q6 = _parseOffsetsArray(hdr, q5, hn)
                        if eoff != 0 { return 1, out }
                        off0 = a0
                        off1 = a1
                        q = q6
                    } else {
                        let es, q6 = _skipValue(hdr, q5, hn)
                        if es != 0 { return 1, out }
                        q = q6
                    }

                    let ewk3, q7 = _skipWs(hdr, q, hn)
                    if ewk3 != 0 { return 1, out }
                    if q7 >= hn { return 1, out }
                    let edelim, delim = bstd.Bytes.getU8(hdr, q7)
                    if edelim != 0 { return 1, out }
                    if delim == 44 { q = q7 + 1L; continue } // ','
                    if delim == 125 { q = q7 + 1L; break } // '}'
                    return 1, out
                }

                if dt < 0 { return 1, out }
                if off0 < 0L { return 1, out }
                if off1 < off0 { return 1, out }
                if ndim <= 0 { return 1, out }

                let rec: map = tua_map_new()
                rec["dtype"] = dt
                rec["dataOff"] = off0
                rec["dataLen"] = off1 - off0
                rec["ndim"] = ndim
                rec["d0"] = d0
                rec["d1"] = d1
                rec["d2"] = d2
                rec["d3"] = d3
                tensors[key] = rec
                p = q
            }

            let ew4, p7 = _skipWs(hdr, p, hn)
            if ew4 != 0 { return 1, out }
            if p7 >= hn { return 1, out }
            let edelim, delim = bstd.Bytes.getU8(hdr, p7)
            if edelim != 0 { return 1, out }
            if delim == 44 { p = p7 + 1L; continue } // ','
            if delim == 125 { p = p7; continue } // outer while will break
            return 1, out
        }

        out.data = b
        out.headerLen = headerLen
        out.tensors = tensors
        out.metadata = null
        return 0, out
    }

    fn parseMmap(path: string) -> int, SafeTensorsFile {
        let out = SafeTensorsFile{ data: null, headerLen: 0L, tensors: null, metadata: null }
        let e, b = bstd.Bytes.mmapFile(path)
        if e != 0 { return e, out }
        return SafeTensors.parseBytes(move b)
    }

    fn tensorInfo(f: SafeTensorsFile, name: string) -> int, map {
        let z: map = null
        if f.tensors == null { return 1, z }
        let tensors: map = f.tensors
        let opt = tensors[name]
        if opt.isNone() { return 1, z }
        let vAny: any = opt.unwrap()
        if vAny == null { return 1, z }
        let rec: map = vAny
        return 0, rec
    }

    fn tensorDataPtr(f: SafeTensorsFile, dataOff: long) -> ptr {
        if f.data == null { return null }
        let base: long = 8L + f.headerLen
        return tua_bytes_data_at(f.data, base + dataOff)
    }
}
