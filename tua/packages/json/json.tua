import "std/bytes" as bstd
import "std/utf8" as utf8

extern fn tua_map_new() -> map
extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string

private fn _isWs(c: int) -> bool {

  return c == 32 || c == 10 || c == 13 || c == 9
}

private fn _isDigit(c: int) -> bool { return c >= 48 && c <= 57 }
private fn _isHex(c: int) -> bool {

  if c >= 48 && c <= 57 { return true }

  if c >= 65 && c <= 70 { return true }

  if c >= 97 && c <= 102 { return true }

  return false
}
private fn _hexVal(c: int) -> int {

  if c >= 48 && c <= 57 { return c - 48 }

  if c >= 65 && c <= 70 { return 10 + (c - 65) }

  return 10 + (c - 97)
}

private fn _skipWs(b: bytes, pos: long, n: long) -> long, int{

  let i = pos

  while true {

    if i >= n { break }

    let c, e = bstd.Bytes.getU8(b, i)

    if e != 0 { return pos, 1}

    if !_isWs(c) { break }
    i = i + 1L

  }

  return i, 0
}

private fn _hasBackslash(b: bytes, start: long, end: long) -> bool {

  let i = start

  while true {

    if i >= end { break }

    let c, e = bstd.Bytes.getU8(b, i)

    if e != 0 { return false }

    if c == 92 { return true }
    i = i + 1L

  }

  return false
}

private fn _parseStringImpl(b: bytes, pos: long, n: long) -> string, long, long, int{

  if pos >= n { return null, pos, 0L, 1}

  let q, e0 = bstd.Bytes.getU8(b, pos)

  if e0 != 0 { return null, pos, 0L, 1}

  if q != 34 { return null, pos, 0L, 1}

  let rawOff = pos + 1L

  let i = rawOff

  while true {

    if i >= n { break }

    let c, ei = bstd.Bytes.getU8(b, i)

    if ei != 0 { return null, pos, 0L, 1}

    if c == 34 { // '"'

      let rawLen = i - rawOff

      let out = tua_str_from_bytes_copy(b, rawOff, rawLen)

      return out, i + 1L, rawLen, 0

    }

    if c == 92 { // '\\' => slow path (escaped)

      if i + 1L >= n { return null, pos, 0L, 1}

      let endPos = i + 2L

      while true {

        if endPos >= n { return null, pos, 0L, 1}

        let cc, ee = bstd.Bytes.getU8(b, endPos)

        if ee != 0 { return null, pos, 0L, 1}

        if cc == 92 {

          if endPos + 1L >= n { return null, pos, 0L, 1}
          endPos = endPos + 2L

          continue

        }

        if cc == 34 { break }

        if cc <= 31 { return null, pos, 0L, 1}
        endPos = endPos + 1L

      }

      let rawLen = endPos - rawOff

      let tmp = bstd.Bytes.new((int)rawLen)

      let outLen: long = 0L

      let j = rawOff

      while true {

        if j >= endPos { break }

        let ch, ej = bstd.Bytes.getU8(b, j)

        if ej != 0 { return null, pos, 0L, 1}

        if ch != 92 { // '\\'
          bstd.Bytes.setU8(tmp, outLen, ch)
          outLen = outLen + 1L
          j = j + 1L

          continue

        }

        if j + 1L >= endPos { return null, pos, 0L, 1}

        let esc, ee2 = bstd.Bytes.getU8(b, j + 1L)

        if ee2 != 0 { return null, pos, 0L, 1}

        if esc == 34 { bstd.Bytes.setU8(tmp, outLen, 34); outLen = outLen + 1L; j = j + 2L; continue } // \"

        if esc == 92 { bstd.Bytes.setU8(tmp, outLen, 92); outLen = outLen + 1L; j = j + 2L; continue } // \\

        if esc == 47 { bstd.Bytes.setU8(tmp, outLen, 47); outLen = outLen + 1L; j = j + 2L; continue } // \/

        if esc == 98 { bstd.Bytes.setU8(tmp, outLen, 8); outLen = outLen + 1L; j = j + 2L; continue }  // \b

        if esc == 102 { bstd.Bytes.setU8(tmp, outLen, 12); outLen = outLen + 1L; j = j + 2L; continue } // \f

        if esc == 110 { bstd.Bytes.setU8(tmp, outLen, 10); outLen = outLen + 1L; j = j + 2L; continue } // \n

        if esc == 114 { bstd.Bytes.setU8(tmp, outLen, 13); outLen = outLen + 1L; j = j + 2L; continue } // \r

        if esc == 116 { bstd.Bytes.setU8(tmp, outLen, 9); outLen = outLen + 1L; j = j + 2L; continue }  // \t

        if esc == 117 { // \uXXXX

          if j + 6L > endPos { return null, pos, 0L, 1}

          let h0, eh0 = bstd.Bytes.getU8(b, j + 2L)

          let h1, eh1 = bstd.Bytes.getU8(b, j + 3L)

          let h2, eh2 = bstd.Bytes.getU8(b, j + 4L)

          let h3, eh3 = bstd.Bytes.getU8(b, j + 5L)

          if eh0 != 0 || eh1 != 0 || eh2 != 0 || eh3 != 0 { return null, pos, 0L, 1}

          if !_isHex(h0) || !_isHex(h1) || !_isHex(h2) || !_isHex(h3) { return null, pos, 0L, 1}

          let cpL: long = ((long)_hexVal(h0)) * 4096L + ((long)_hexVal(h1)) * 256L + ((long)_hexVal(h2)) * 16L + (long)_hexVal(h3)

          let cp: int = (int)cpL
          j = j + 6L

          if cp >= 55296 && cp <= 56319 {

            if j + 6L > endPos { return null, pos, 0L, 1}

            let bk, ebk = bstd.Bytes.getU8(b, j)

            let uu, euu = bstd.Bytes.getU8(b, j + 1L)

            if ebk != 0 || euu != 0 { return null, pos, 0L, 1}

            if bk != 92 || uu != 117 { return null, pos, 0L, 1}

            let l0, el0 = bstd.Bytes.getU8(b, j + 2L)

            let l1, el1 = bstd.Bytes.getU8(b, j + 3L)

            let l2, el2 = bstd.Bytes.getU8(b, j + 4L)

            let l3, el3 = bstd.Bytes.getU8(b, j + 5L)

            if el0 != 0 || el1 != 0 || el2 != 0 || el3 != 0 { return null, pos, 0L, 1}

            if !_isHex(l0) || !_isHex(l1) || !_isHex(l2) || !_isHex(l3) { return null, pos, 0L, 1}

            let low: int = _hexVal(l0) * 4096 + _hexVal(l1) * 256 + _hexVal(l2) * 16 + _hexVal(l3)

            if low < 56320 || low > 57343 { return null, pos, 0L, 1}
            cp = 65536 + ((cp - 55296) * 1024) + (low - 56320)
            j = j + 6L

          } else {

            if cp >= 56320 && cp <= 57343 { return null, pos, 0L, 1}

          }

          let wrote, ee3 = utf8.Utf8.encode1(cp, tmp, outLen)

          if ee3 != 0 { return null, pos, 0L, 1}
          outLen = outLen + wrote

          continue

        }

        return null, pos, 0L, 1

      }

      let out = tua_str_from_bytes_copy(tmp, 0L, outLen)

      return out, endPos + 1L, outLen, 0

    }

    if c <= 31 { return null, pos, 0L, 1}
    i = i + 1L

  }

  return null, pos, 0L, 1
}

private fn _parseString(b: bytes, pos: long, n: long) -> string, long, int{

  let s, j, _, e = _parseStringImpl(b, pos, n)

  return s, j, e
}

private fn _pow10i(exp: int) -> double {
  // exp >= 0

  let e: u32 = (u32)exp

  let base: double = 10.0

  let out: double = 1.0

  while e > (u32)0 {

    let bit = e & (u32)1

    if bit != (u32)0 { out = out * base }
    base = base * base
    e = e >> (u32)1

  }

  return out
}

private fn _parseNumber(b: bytes, pos: long, n: long) -> any, long, int{

  let i = pos

  if i >= n { return null, pos, 1}

  let neg: int = 0

  let c0, e0 = bstd.Bytes.getU8(b, i)

  if e0 != 0 { return null, pos, 1}

  if c0 == 45 {
    neg = 1
    i = i + 1L

    if i >= n { return null, pos, 1}

  }

  let intPart: long = 0L

  let c1, e1 = bstd.Bytes.getU8(b, i)

  if e1 != 0 { return null, pos, 1}

  if c1 == 48 {
    i = i + 1L

  } else if c1 >= 49 && c1 <= 57 {

    while true {

      if i >= n { break }

      let cd, ed = bstd.Bytes.getU8(b, i)

      if ed != 0 { return null, pos, 1}

      if !_isDigit(cd) { break }
      intPart = intPart * 10L + (long)(cd - 48)
      i = i + 1L

    }

  } else {

    return null, pos, 1

  }

  let isFloat: int = 0

  let frac: double = 0.0

  let fracDiv: double = 1.0

  if i < n {

    let dot, edot = bstd.Bytes.getU8(b, i)

    if edot != 0 { return null, pos, 1}

    if dot == 46 {
      isFloat = 1
      i = i + 1L

      if i >= n { return null, pos, 1}

      let dg, edg = bstd.Bytes.getU8(b, i)

      if edg != 0 { return null, pos, 1}

      if !_isDigit(dg) { return null, pos, 1}

      while true {

        if i >= n { break }

        let cd2, ed2 = bstd.Bytes.getU8(b, i)

        if ed2 != 0 { return null, pos, 1}

        if !_isDigit(cd2) { break }
        frac = frac * 10.0 + (double)(cd2 - 48)
        fracDiv = fracDiv * 10.0
        i = i + 1L

      }

    }

  }

  let exp: int = 0

  if i < n {

    let ec, ee = bstd.Bytes.getU8(b, i)

    if ee != 0 { return null, pos, 1}

    if ec == 101 || ec == 69 {
      isFloat = 1
      i = i + 1L

      if i >= n { return null, pos, 1}

      let eneg: int = 0

      let sg, esg = bstd.Bytes.getU8(b, i)

      if esg != 0 { return null, pos, 1}

      if sg == 43 { i = i + 1L }

      else if sg == 45 { eneg = 1; i = i + 1L }

      if i >= n { return null, pos, 1}

      let d0, ed0 = bstd.Bytes.getU8(b, i)

      if ed0 != 0 { return null, pos, 1}

      if !_isDigit(d0) { return null, pos, 1}

      while true {

        if i >= n { break }

        let d1, ed1 = bstd.Bytes.getU8(b, i)

        if ed1 != 0 { return null, pos, 1}

        if !_isDigit(d1) { break }
        exp = exp * 10 + (d1 - 48)
        i = i + 1L

      }

      if eneg != 0 { exp = -exp }

    }

  }

  if isFloat != 0 {

    let v: double = (double)intPart

    if fracDiv != 1.0 { v = v + (frac / fracDiv) }

    if exp != 0 {

      let a: int = exp

      if a < 0 { a = -a }

      let s = _pow10i(a)

      if exp > 0 { v = v * s }

      else { v = v / s }

    }

    if neg != 0 { v = -v }

    let av:any = v

    return av, i, 0

  }

  let out: long = intPart

  if neg != 0 { out = -out }

  let av:any = out

  return av, i, 0
}

private fn _incNode(nodes: long, maxNodes: long) -> long, int{

  let next = nodes + 1L

  if maxNodes > 0L && next > maxNodes { return nodes, 3}

  return next, 0
}

private fn _incStrBytes(total: long, add: long, maxBytes: long) -> long, int{

  let next = total + add

  if maxBytes > 0L && next > maxBytes { return total, 3}

  return next, 0
}

private fn _parseValueLimited(b: bytes, pos: long, n: long, depth: int, maxDepth: int, maxNodes: long, maxStringBytes: long, nodes: long, stringBytes: long) -> any, long, long, long, int{

  let i, se = _skipWs(b, pos, n)

  if se != 0 { return null, pos, nodes, stringBytes, 1}

  if i >= n { return null, pos, nodes, stringBytes, 1}

  let c, ec = bstd.Bytes.getU8(b, i)

  if ec != 0 { return null, pos, nodes, stringBytes, 1}

  if c == 34 {

    let s, j, sLen, pe = _parseStringImpl(b, i, n)

    if pe != 0 { return null, pos, nodes, stringBytes, 1}

    let nodes2, ne = _incNode(nodes, maxNodes)

    if ne != 0 { return null, pos, nodes, stringBytes, 3}

    let bytes2, be = _incStrBytes(stringBytes, sLen, maxStringBytes)

    if be != 0 { return null, pos, nodes, stringBytes, 3}

    return s, j, nodes2, bytes2, 0

  }

  if c == 123 { // '{'

    let nextDepth = depth + 1

    if maxDepth > 0 && nextDepth > maxDepth { return null, pos, nodes, stringBytes, 3}

    let nodes0, ne0 = _incNode(nodes, maxNodes)

    if ne0 != 0 { return null, pos, nodes, stringBytes, 3}

    let obj: map = tua_map_new()

    let j, se2 = _skipWs(b, i + 1L, n)

    if se2 != 0 { return null, pos, nodes, stringBytes, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return null, pos, nodes, stringBytes, 1}

      if cc == 125 { return obj, j + 1L, nodes0, stringBytes, 0}

    }

    let at = j

    let nodes1 = nodes0

    let bytes1 = stringBytes

    while true {

      let kpos, se3 = _skipWs(b, at, n)

      if se3 != 0 { return null, pos, nodes, stringBytes, 1}

      let key, afterKey, keyLen, ke = _parseStringImpl(b, kpos, n)

      if ke != 0 { return null, pos, nodes, stringBytes, 1}

      let nodes2, kne = _incNode(nodes1, maxNodes)

      if kne != 0 { return null, pos, nodes, stringBytes, 3}

      let bytes2, kbe = _incStrBytes(bytes1, keyLen, maxStringBytes)

      if kbe != 0 { return null, pos, nodes, stringBytes, 3}

      let afterWs, se4 = _skipWs(b, afterKey, n)

      if se4 != 0 { return null, pos, nodes, stringBytes, 1}

      if afterWs >= n { return null, pos, nodes, stringBytes, 1}

      let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 || colon != 58 { return null, pos, nodes, stringBytes, 1}

      let val, afterVal, nodes3, bytes3, ve = _parseValueLimited(b, afterWs + 1L, n, nextDepth, maxDepth, maxNodes, maxStringBytes, nodes2, bytes2)

      if ve != 0 { return null, pos, nodes, stringBytes, ve}
      obj[key] = val

      let afterWs2, se5 = _skipWs(b, afterVal, n)

      if se5 != 0 { return null, pos, nodes, stringBytes, 1}

      if afterWs2 >= n { return null, pos, nodes, stringBytes, 1}

      let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

      if ec3 != 0 { return null, pos, nodes, stringBytes, 1}
      nodes1 = nodes3
      bytes1 = bytes3

      if sep == 44 { at = afterWs2 + 1L; continue }

      if sep == 125 { return obj, afterWs2 + 1L, nodes1, bytes1, 0}

      return null, pos, nodes, stringBytes, 1

    }

  }

  if c == 91 { // '['

    let nextDepth = depth + 1

    if maxDepth > 0 && nextDepth > maxDepth { return null, pos, nodes, stringBytes, 3}

    let nodes0, ne0 = _incNode(nodes, maxNodes)

    if ne0 != 0 { return null, pos, nodes, stringBytes, 3}

    let arr: any[] = {}

    let j, se2 = _skipWs(b, i + 1L, n)

    if se2 != 0 { return null, pos, nodes, stringBytes, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return null, pos, nodes, stringBytes, 1}

      if cc == 93 { return arr, j + 1L, nodes0, stringBytes, 0}

    }

    let at = j

    let nodes1 = nodes0

    let bytes1 = stringBytes

    while true {

      let v, afterV, nodes2, bytes2, ve = _parseValueLimited(b, at, n, nextDepth, maxDepth, maxNodes, maxStringBytes, nodes1, bytes1)

      if ve != 0 { return null, pos, nodes, stringBytes, ve}
      arr.push(v)

      let afterWs, se3 = _skipWs(b, afterV, n)

      if se3 != 0 { return null, pos, nodes, stringBytes, 1}

      if afterWs >= n { return null, pos, nodes, stringBytes, 1}

      let sep, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 { return null, pos, nodes, stringBytes, 1}
      nodes1 = nodes2
      bytes1 = bytes2

      if sep == 44 { at = afterWs + 1L; continue }

      if sep == 93 { return arr, afterWs + 1L, nodes1, bytes1, 0}

      return null, pos, nodes, stringBytes, 1

    }

  }

  // true

  if c == 116 {

    if i + 4L > n { return null, pos, nodes, stringBytes, 1}

    let c1, e1 = bstd.Bytes.getU8(b, i + 1L)

    let c2, e2 = bstd.Bytes.getU8(b, i + 2L)

    let c3, e3 = bstd.Bytes.getU8(b, i + 3L)

    if e1 != 0 || e2 != 0 || e3 != 0 { return null, pos, nodes, stringBytes, 1}

    if c1 != 114 || c2 != 117 || c3 != 101 { return null, pos, nodes, stringBytes, 1}

    let nodes2, ne = _incNode(nodes, maxNodes)

    if ne != 0 { return null, pos, nodes, stringBytes, 3}

    return true, i + 4L, nodes2, stringBytes, 0

  }

  // false

  if c == 102 {

    if i + 5L > n { return null, pos, nodes, stringBytes, 1}

    let c1, e1 = bstd.Bytes.getU8(b, i + 1L)

    let c2, e2 = bstd.Bytes.getU8(b, i + 2L)

    let c3, e3 = bstd.Bytes.getU8(b, i + 3L)

    let c4, e4 = bstd.Bytes.getU8(b, i + 4L)

    if e1 != 0 || e2 != 0 || e3 != 0 || e4 != 0 { return null, pos, nodes, stringBytes, 1}

    if c1 != 97 || c2 != 108 || c3 != 115 || c4 != 101 { return null, pos, nodes, stringBytes, 1}

    let nodes2, ne = _incNode(nodes, maxNodes)

    if ne != 0 { return null, pos, nodes, stringBytes, 3}

    return false, i + 5L, nodes2, stringBytes, 0

  }

  // null

  if c == 110 {

    if i + 4L > n { return null, pos, nodes, stringBytes, 1}

    let c1, e1 = bstd.Bytes.getU8(b, i + 1L)

    let c2, e2 = bstd.Bytes.getU8(b, i + 2L)

    let c3, e3 = bstd.Bytes.getU8(b, i + 3L)

    if e1 != 0 || e2 != 0 || e3 != 0 { return null, pos, nodes, stringBytes, 1}

    if c1 != 117 || c2 != 108 || c3 != 108 { return null, pos, nodes, stringBytes, 1}

    let nodes2, ne = _incNode(nodes, maxNodes)

    if ne != 0 { return null, pos, nodes, stringBytes, 3}

    return null, i + 4L, nodes2, stringBytes, 0

  }

  if c == 45 || _isDigit(c) {

    let v, j, pe = _parseNumber(b, i, n)

    if pe != 0 { return null, pos, nodes, stringBytes, 1}

    let nodes2, ne = _incNode(nodes, maxNodes)

    if ne != 0 { return null, pos, nodes, stringBytes, 3}

    return v, j, nodes2, stringBytes, 0

  }

  return null, pos, nodes, stringBytes, 1
}

private fn _parseValue(b: bytes, pos: long, n: long) -> any, long, int{

  let i, se = _skipWs(b, pos, n)

  if se != 0 { return null, pos, 1}

  if i >= n { return null, pos, 1}

  let c, ec = bstd.Bytes.getU8(b, i)

  if ec != 0 { return null, pos, 1}

  if c == 34 {

    let s, j, e = _parseString(b, i, n)

    if e != 0 { return null, pos, 1}

    return s, j, 0

  }

  if c == 123 {

    let obj: map = tua_map_new()

    let j, se2 = _skipWs(b, i + 1L, n)

    if se2 != 0 { return null, pos, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return null, pos, 1}

      if cc == 125 { return obj, j + 1L, 0}

    }

    let at = j

    while true {

      let kpos, se3 = _skipWs(b, at, n)

      if se3 != 0 { return null, pos, 1}

      let key, afterKey, ke = _parseString(b, kpos, n)

      if ke != 0 { return null, pos, 1}

      let afterWs, se4 = _skipWs(b, afterKey, n)

      if se4 != 0 { return null, pos, 1}

      if afterWs >= n { return null, pos, 1}

      let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 || colon != 58 { return null, pos, 1}

      let val, afterVal, ve = _parseValue(b, afterWs + 1L, n)

      if ve != 0 { return null, pos, 1}
      obj[key] = val

      let afterWs2, se5 = _skipWs(b, afterVal, n)

      if se5 != 0 { return null, pos, 1}

      if afterWs2 >= n { return null, pos, 1}

      let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

      if ec3 != 0 { return null, pos, 1}

      if sep == 44 { at = afterWs2 + 1L; continue }

      if sep == 125 {

        return obj, afterWs2 + 1L, 0

      }

      return null, pos, 1

    }

  }

  if c == 91 {

    let arr: any[] = {}

    let j, se2 = _skipWs(b, i + 1L, n)

    if se2 != 0 { return null, pos, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return null, pos, 1}

      if cc == 93 { return arr, j + 1L, 0}

    }

    let at = j

    while true {

      let v, afterV, ve = _parseValue(b, at, n)

      if ve != 0 { return null, pos, 1}
      arr.push(v)

      let afterWs, se3 = _skipWs(b, afterV, n)

      if se3 != 0 { return null, pos, 1}

      if afterWs >= n { return null, pos, 1}

      let sep, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 { return null, pos, 1}

      if sep == 44 { at = afterWs + 1L; continue }

      if sep == 93 { return arr, afterWs + 1L, 0}

      return null, pos, 1

    }

  }

  // true

  if c == 116 {

    if i + 4L > n { return null, pos, 1}

    let c1, e1 = bstd.Bytes.getU8(b, i + 1L)

    let c2, e2 = bstd.Bytes.getU8(b, i + 2L)

    let c3, e3 = bstd.Bytes.getU8(b, i + 3L)

    if e1 != 0 || e2 != 0 || e3 != 0 { return null, pos, 1}

    if c1 != 114 || c2 != 117 || c3 != 101 { return null, pos, 1}

    return true, i + 4L, 0

  }

  // false

  if c == 102 {

    if i + 5L > n { return null, pos, 1}

    let c1, e1 = bstd.Bytes.getU8(b, i + 1L)

    let c2, e2 = bstd.Bytes.getU8(b, i + 2L)

    let c3, e3 = bstd.Bytes.getU8(b, i + 3L)

    let c4, e4 = bstd.Bytes.getU8(b, i + 4L)

    if e1 != 0 || e2 != 0 || e3 != 0 || e4 != 0 { return null, pos, 1}

    if c1 != 97 || c2 != 108 || c3 != 115 || c4 != 101 { return null, pos, 1}

    return false, i + 5L, 0

  }

  // null

  if c == 110 {

    if i + 4L > n { return null, pos, 1}

    let c1, e1 = bstd.Bytes.getU8(b, i + 1L)

    let c2, e2 = bstd.Bytes.getU8(b, i + 2L)

    let c3, e3 = bstd.Bytes.getU8(b, i + 3L)

    if e1 != 0 || e2 != 0 || e3 != 0 { return null, pos, 1}

    if c1 != 117 || c2 != 108 || c3 != 108 { return null, pos, 1}

    return null, i + 4L, 0

  }

  if c == 45 || _isDigit(c) {

    let v, j, e = _parseNumber(b, i, n)

    return v, j, e

  }

  return null, pos, 1
}

private fn _skipLiteral(b: bytes, pos: long, n: long, lit: int[]) -> long, int{

  let i: long = 0L

  while true {

    if i >= (long)lit.len() { break }

    let p = pos + i

    if p >= n { return pos, 1}

    let c, e = bstd.Bytes.getU8(b, p)

    if e != 0 { return pos, 1}

    if c != lit[(int)i] { return pos, 1}
    i = i + 1L

  }

  return pos + (long)lit.len(), 0
}

private fn _skipString(b: bytes, pos: long, n: long) -> long, int{

  if pos >= n { return pos, 1}

  let q, e0 = bstd.Bytes.getU8(b, pos)

  if e0 != 0 { return pos, 1}

  if q != 34 { return pos, 1}

  let i = pos + 1L

  while true {

    if i >= n { break }

    let c, ei = bstd.Bytes.getU8(b, i)

    if ei != 0 { return pos, 1}

    if c == 92 {

      if i + 1L >= n { return pos, 1}
      i = i + 2L

      continue

    }

    if c == 34 { return i + 1L, 0}

    if c <= 31 { return pos, 1}
    i = i + 1L

  }

  return pos, 1
}

private fn _skipNumber(b: bytes, pos: long, n: long) -> long, int{

  let i = pos

  if i >= n { return pos, 1}

  let c0, e0 = bstd.Bytes.getU8(b, i)

  if e0 != 0 { return pos, 1}

  if c0 == 45 {
    i = i + 1L

    if i >= n { return pos, 1}

  }

  let c1, e1 = bstd.Bytes.getU8(b, i)

  if e1 != 0 { return pos, 1}

  if c1 == 48 {
    i = i + 1L

  } else if c1 >= 49 && c1 <= 57 {

    while true {

      if i >= n { break }

      let cd, ed = bstd.Bytes.getU8(b, i)

      if ed != 0 { return pos, 1}

      if !_isDigit(cd) { break }
      i = i + 1L

    }

  } else {

    return pos, 1

  }

  if i < n {

    let dot, edot = bstd.Bytes.getU8(b, i)

    if edot != 0 { return pos, 1}

    if dot == 46 {
      i = i + 1L

      if i >= n { return pos, 1}

      let dg, edg = bstd.Bytes.getU8(b, i)

      if edg != 0 { return pos, 1}

      if !_isDigit(dg) { return pos, 1}

      while true {

        if i >= n { break }

        let cd2, ed2 = bstd.Bytes.getU8(b, i)

        if ed2 != 0 { return pos, 1}

        if !_isDigit(cd2) { break }
        i = i + 1L

      }

    }

  }

  if i < n {

    let ec, ee = bstd.Bytes.getU8(b, i)

    if ee != 0 { return pos, 1}

    if ec == 101 || ec == 69 {
      i = i + 1L

      if i >= n { return pos, 1}

      let sg, esg = bstd.Bytes.getU8(b, i)

      if esg != 0 { return pos, 1}

      if sg == 43 || sg == 45 { i = i + 1L }

      if i >= n { return pos, 1}

      let d0, ed0 = bstd.Bytes.getU8(b, i)

      if ed0 != 0 { return pos, 1}

      if !_isDigit(d0) { return pos, 1}

      while true {

        if i >= n { break }

        let d1, ed1 = bstd.Bytes.getU8(b, i)

        if ed1 != 0 { return pos, 1}

        if !_isDigit(d1) { break }
        i = i + 1L

      }

    }

  }

  return i, 0
}

private fn _skipValue(b: bytes, pos: long, n: long) -> long, int{

  let i, se = _skipWs(b, pos, n)

  if se != 0 { return pos, 1}

  if i >= n { return pos, 1}

  let c, ec = bstd.Bytes.getU8(b, i)

  if ec != 0 { return pos, 1}

  if c == 34 {

    let p, es = _skipString(b, i, n)

    return p, es

  }

  if c == 45 || _isDigit(c) {

    let p, en = _skipNumber(b, i, n)

    return p, en

  }

  if c == 116 { // true

    let lit:int[] = {116,114,117,101}

    let p, el = _skipLiteral(b, i, n, lit)

    return p, el

  }

  if c == 102 { // false

    let lit:int[] = {102,97,108,115,101}

    let p, el = _skipLiteral(b, i, n, lit)

    return p, el

  }

  if c == 110 { // null

    let lit:int[] = {110,117,108,108}

    let p, el = _skipLiteral(b, i, n, lit)

    return p, el

  }

  if c == 91 { // '['

    let at = i + 1L

    let j, se2 = _skipWs(b, at, n)

    if se2 != 0 { return pos, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return pos, 1}

      if cc == 93 { return j + 1L, 0}

    }
    at = j

    while true {

      let afterV, ve = _skipValue(b, at, n)

      if ve != 0 { return pos, 1}

      let afterWs, se3 = _skipWs(b, afterV, n)

      if se3 != 0 { return pos, 1}

      if afterWs >= n { return pos, 1}

      let sep, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 { return pos, 1}

      if sep == 44 { at = afterWs + 1L; continue }

      if sep == 93 { return afterWs + 1L, 0}

      return pos, 1

    }

  }

  if c == 123 { // '{'

    let at = i + 1L

    let j, se2 = _skipWs(b, at, n)

    if se2 != 0 { return pos, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return pos, 1}

      if cc == 125 { return j + 1L, 0}

    }
    at = j

    while true {

      let kpos, se3 = _skipWs(b, at, n)

      if se3 != 0 { return pos, 1}

      let afterKey, ke = _skipString(b, kpos, n)

      if ke != 0 { return pos, 1}

      let afterWs, se4 = _skipWs(b, afterKey, n)

      if se4 != 0 { return pos, 1}

      if afterWs >= n { return pos, 1}

      let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 || colon != 58 { return pos, 1}

      let afterVal, ve = _skipValue(b, afterWs + 1L, n)

      if ve != 0 { return pos, 1}

      let afterWs2, se5 = _skipWs(b, afterVal, n)

      if se5 != 0 { return pos, 1}

      if afterWs2 >= n { return pos, 1}

      let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

      if ec3 != 0 { return pos, 1}

      if sep == 44 { at = afterWs2 + 1L; continue }

      if sep == 125 { return afterWs2 + 1L, 0}

      return pos, 1

    }

  }

  return pos, 1
}

private fn _parseStrictLongAt(b: bytes, pos: long, n: long) -> long, long, int{

  let p0, se = _skipWs(b, pos, n)

  if se != 0 { return 0L, pos, 1}

  if p0 >= n { return 0L, pos, 1}

  let p = p0

  let c0, e0 = bstd.Bytes.getU8(b, p)

  if e0 != 0 { return 0L, pos, 1}

  let sign: long = 1L

  if c0 == 45 {
    sign = -1L
    p = p + 1L

    if p >= n { return 0L, pos, 1}

  }

  let d0, e1 = bstd.Bytes.getU8(b, p)

  if e1 != 0 { return 0L, pos, 1}

  if !_isDigit(d0) { return 0L, pos, 1}

  let v: long = 0L

  while true {

    if p >= n { break }

    let d, ed = bstd.Bytes.getU8(b, p)

    if ed != 0 { return 0L, pos, 1}

    if !_isDigit(d) { break }
    v = (v * 10L) + (long)(d - 48)
    p = p + 1L

  }

  if p < n {

    let nxt, ee2 = bstd.Bytes.getU8(b, p)

    if ee2 != 0 { return 0L, pos, 1}

    if nxt == 46 || nxt == 101 || nxt == 69 { return 0L, pos, 1}

  }

  return v * sign, p, 0
}

private fn _parseStrictBoolAt(b: bytes, pos: long, n: long) -> bool, long, int{

  let p, se = _skipWs(b, pos, n)

  if se != 0 { return false, pos, 1}

  if p >= n { return false, pos, 1}

  let c0, e0 = bstd.Bytes.getU8(b, p)

  if e0 != 0 { return false, pos, 1}

  if c0 == 116 { // true

    let lit:int[] = {116,114,117,101}

    let after, el = _skipLiteral(b, p, n, lit)

    if el != 0 { return false, pos, 1}

    return true, after, 0

  }

  if c0 == 102 { // false

    let lit:int[] = {102,97,108,115,101}

    let after, el = _skipLiteral(b, p, n, lit)

    if el != 0 { return false, pos, 1}

    return false, after, 0

  }

  return false, pos, 1
}

private fn _splitPathSegments(path: string) -> string[], int{

  let pb = bstd.Bytes.fromString(path)

  let n = bstd.Bytes.len(pb)

  if n <= 0L { return null, 1}

  let parts: string[] = {}

  let start: long = 0L

  let i: long = 0L

  while true {

    if i >= n { break }

    let c, e = bstd.Bytes.getU8(pb, i)

    if e != 0 { return null, 1}

    if c == 46 { // '.'

      if i == start { return null, 1}

      let seg = tua_str_from_bytes_copy(pb, start, i - start)
      parts.push(seg)
      start = i + 1L

    }
    i = i + 1L

  }

  if start >= n { return null, 1}

  let last = tua_str_from_bytes_copy(pb, start, n - start)
  parts.push(last)

  return parts, 0
}

private fn _scanObjectValuePos(b: bytes, objPos: long, n: long, key: string) -> long, int{

  let i, se = _skipWs(b, objPos, n)

  if se != 0 { return 0L, 1}

  if i >= n { return 0L, 1}

  let c, eo = bstd.Bytes.getU8(b, i)

  if eo != 0 || c != 123 { return 0L, 1} // '{'

  let at = i + 1L

  let j, se2 = _skipWs(b, at, n)

  if se2 != 0 { return 0L, 1}

  if j < n {

    let cc, ee = bstd.Bytes.getU8(b, j)

    if ee != 0 { return 0L, 1}

    if cc == 125 { return 0L, 2} // empty object

  }
  at = j

  while true {

    let kpos, se3 = _skipWs(b, at, n)

    if se3 != 0 { return 0L, 1}

    let k, afterKey, ke = _parseString(b, kpos, n)

    if ke != 0 { return 0L, 1}

    let afterWs, se4 = _skipWs(b, afterKey, n)

    if se4 != 0 { return 0L, 1}

    if afterWs >= n { return 0L, 1}

    let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

    if ec2 != 0 || colon != 58 { return 0L, 1}

    let vpos, se5 = _skipWs(b, afterWs + 1L, n)

    if se5 != 0 { return 0L, 1}

    if vpos >= n { return 0L, 1}

    if k == key { return vpos, 0}

    let afterVal, ve = _skipValue(b, vpos, n)

    if ve != 0 { return 0L, 1}

    let afterWs2, se6 = _skipWs(b, afterVal, n)

    if se6 != 0 { return 0L, 1}

    if afterWs2 >= n { return 0L, 1}

    let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

    if ec3 != 0 { return 0L, 1}

    if sep == 44 { at = afterWs2 + 1L; continue }

    if sep == 125 { break }

    return 0L, 1

  }

  return 0L, 2
}

private fn _scanKeyPathValuePos(b: bytes, path: string, n: long) -> long, int{

  let partsAny, pe = _splitPathSegments(path)

  if pe != 0 { return 0L, 1}

  let parts: string[] = partsAny

  if parts == null || parts.len() <= 0 { return 0L, 1}

  let root, se = _skipWs(b, 0L, n)

  if se != 0 { return 0L, 1}

  if root >= n { return 0L, 1}

  let rc, er = bstd.Bytes.getU8(b, root)

  if er != 0 || rc != 123 { return 0L, 1} // '{'

  let objPos = root

  let i: int = 0

  while true {

    if i >= parts.len() { break }

    let key = parts[i]

    let vpos, fe = _scanObjectValuePos(b, objPos, n, key)

    if fe != 0 { return 0L, fe}

    if i == parts.len() - 1 { return vpos, 0}

    let nextPos, se2 = _skipWs(b, vpos, n)

    if se2 != 0 { return 0L, 1}

    if nextPos >= n { return 0L, 1}

    let c, eo = bstd.Bytes.getU8(b, nextPos)

    if eo != 0 { return 0L, 1}

    if c != 123 { return 0L, 1} // type mismatch (expected object)
    objPos = nextPos
    i = i + 1

  }

  return 0L, 1
}

private fn _parseStringLongMapAt(b: bytes, pos: long, n: long) -> map, long, int{

  let i, se = _skipWs(b, pos, n)

  if se != 0 { return null, pos, 1}

  if i >= n { return null, pos, 1}

  let c, eo = bstd.Bytes.getU8(b, i)

  if eo != 0 || c != 123 { return null, pos, 1} // '{'

  let obj: map = tua_map_new()

  let at = i + 1L

  let j, se2 = _skipWs(b, at, n)

  if se2 != 0 { return null, pos, 1}

  if j < n {

    let cc, ee = bstd.Bytes.getU8(b, j)

    if ee != 0 { return null, pos, 1}

    if cc == 125 { return obj, j + 1L, 0} // empty object

  }
  at = j

  while true {

    let kpos, se3 = _skipWs(b, at, n)

    if se3 != 0 { return null, pos, 1}

    let key, afterKey, ke = _parseString(b, kpos, n)

    if ke != 0 { return null, pos, 1}

    let afterWs, se4 = _skipWs(b, afterKey, n)

    if se4 != 0 { return null, pos, 1}

    if afterWs >= n { return null, pos, 1}

    let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

    if ec2 != 0 || colon != 58 { return null, pos, 1}

    let v, afterVal, ve = _parseStrictLongAt(b, afterWs + 1L, n)

    if ve != 0 { return null, pos, 1}
    obj[key] = v

    let afterWs2, se5 = _skipWs(b, afterVal, n)

    if se5 != 0 { return null, pos, 1}

    if afterWs2 >= n { return null, pos, 1}

    let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

    if ec3 != 0 { return null, pos, 1}

    if sep == 44 { at = afterWs2 + 1L; continue }

    if sep == 125 { return obj, afterWs2 + 1L, 0}

    return null, pos, 1

  }

  return null, pos, 1
}

private fn _parseStringArrayAt(b: bytes, pos: long, n: long) -> string[], long, int{

  let i, se = _skipWs(b, pos, n)

  if se != 0 { return null, pos, 1}

  if i >= n { return null, pos, 1}

  let c, eo = bstd.Bytes.getU8(b, i)

  if eo != 0 || c != 91 { return null, pos, 1} // '['

  let arr: string[] = {}

  let at = i + 1L

  let j, se2 = _skipWs(b, at, n)

  if se2 != 0 { return null, pos, 1}

  if j < n {

    let cc, ee = bstd.Bytes.getU8(b, j)

    if ee != 0 { return null, pos, 1}

    if cc == 93 { return arr, j + 1L, 0} // empty array

  }
  at = j

  while true {

    let vpos, se3 = _skipWs(b, at, n)

    if se3 != 0 { return null, pos, 1}

    let v, afterVal, ve = _parseString(b, vpos, n)

    if ve != 0 { return null, pos, 1}
    arr.push(v)

    let afterWs, se4 = _skipWs(b, afterVal, n)

    if se4 != 0 { return null, pos, 1}

    if afterWs >= n { return null, pos, 1}

    let sep, ec2 = bstd.Bytes.getU8(b, afterWs)

    if ec2 != 0 { return null, pos, 1}

    if sep == 44 { at = afterWs + 1L; continue }

    if sep == 93 { return arr, afterWs + 1L, 0}

    return null, pos, 1

  }

  return null, pos, 1
}

object Json {

  fn parseBytes(b: bytes) -> any, int{

    if b == null { return null, 1}

    let n = bstd.Bytes.len(b)

    let v, end, e = _parseValue(b, 0L, n)

    if e != 0 { return null, 1}

    let tail, se = _skipWs(b, end, n)

    if se != 0 { return null, 1}

    if tail != n { return null, 1}

    return v, 0

  }

  fn parse(s: string) -> any, int{

    let b = bstd.Bytes.fromString(s)

    return Json.parseBytes(b)

  }

  // Parse JSON into a DOM like `parseBytes`, but abort when exceeding limits to avoid peak memory blowups.
  // Limits semantics:
  // - maxDepth: maximum nesting depth of `{}` / `[]` (root container counts as depth=1). <=0 means unlimited.
  // - maxNodes: maximum number of JSON values (including containers and strings, including object keys). <=0 means unlimited.
  // - maxStringBytes: maximum total UTF-8 bytes allocated for strings (including object keys). <=0 means unlimited.
  // Error codes:
  // - 0: ok
  // - 1: parse error
  // - 3: limit exceeded

  fn parseBytesWithLimits(b: bytes, maxDepth: int, maxNodes: long, maxStringBytes: long) -> any, int{

    if b == null { return null, 1}

    let n = bstd.Bytes.len(b)

    let v, end, _, _, e = _parseValueLimited(b, 0L, n, 0, maxDepth, maxNodes, maxStringBytes, 0L, 0L)

    if e != 0 { return null, e}

    let tail, se = _skipWs(b, end, n)

    if se != 0 { return null, 1}

    if tail != n { return null, 1}

    return v, 0

  }

  fn parseWithLimits(s: string, maxDepth: int, maxNodes: long, maxStringBytes: long) -> any, int{

    let b = bstd.Bytes.fromString(s)

    return Json.parseBytesWithLimits(b, maxDepth, maxNodes, maxStringBytes)

  }

  // DOM helper APIs (reduce `unwrap()+index` chains; assumes schema types are correct).

  fn getAny(m: map, key: string) -> Option<any> { return m[key] }

  fn getStr(m: map, key: string) -> Option<string> {

    let o = m[key]

    if o.isNone() { return None() }

    let v:any = o.unwrap()

    let s: string = v

    return Some(s)

  }

  fn getLong(m: map, key: string) -> Option<long> {

    let o = m[key]

    if o.isNone() { return None() }

    let v:any = o.unwrap()

    let x: long = v

    return Some(x)

  }

  fn getBool(m: map, key: string) -> Option<bool> {

    let o = m[key]

    if o.isNone() { return None() }

    let v:any = o.unwrap()

    let x: bool = v

    return Some(x)

  }

  fn getArr(m: map, key: string) -> Option<any[]> {

    let o = m[key]

    if o.isNone() { return None() }

    let v:any = o.unwrap()

    let a: any[] = v

    return Some(a)

  }

  fn getMap(m: map, key: string) -> Option<map> {

    let o = m[key]

    if o.isNone() { return None() }

    let v:any = o.unwrap()

    let mm: map = v

    return Some(mm)

  }

  // Scan a top-level JSON object and return the string value for `key` without building the full DOM.
  // Returns:
  // - 0, string on success
  // - 2, null if not found
  // - 1, null on parse error

  fn scanTopLevelString(b: bytes, key: string) -> string, int{

    if b == null || key == null { return null, 1}

    let n = bstd.Bytes.len(b)

    let i, se = _skipWs(b, 0L, n)

    if se != 0 { return null, 1}

    if i >= n { return null, 1}

    let c, eo = bstd.Bytes.getU8(b, i)

    if eo != 0 || c != 123 { return null, 1} // '{'

    let at = i + 1L

    let j, se2 = _skipWs(b, at, n)

    if se2 != 0 { return null, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return null, 1}

      if cc == 125 { return null, 2} // empty object

    }
    at = j

    while true {

      let kpos, se3 = _skipWs(b, at, n)

      if se3 != 0 { return null, 1}

      let k, afterKey, ke = _parseString(b, kpos, n)

      if ke != 0 { return null, 1}

      let afterWs, se4 = _skipWs(b, afterKey, n)

      if se4 != 0 { return null, 1}

      if afterWs >= n { return null, 1}

      let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 || colon != 58 { return null, 1}

      if k == key {

        let vpos, se5 = _skipWs(b, afterWs + 1L, n)

        if se5 != 0 { return null, 1}

        let s, afterVal, ve = _parseString(b, vpos, n)

        let _ = afterVal

        if ve != 0 { return null, 1}

        return s, 0

      }

      let afterVal, ve = _skipValue(b, afterWs + 1L, n)

      if ve != 0 { return null, 1}

      let afterWs2, se5 = _skipWs(b, afterVal, n)

      if se5 != 0 { return null, 1}

      if afterWs2 >= n { return null, 1}

      let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

      if ec3 != 0 { return null, 1}

      if sep == 44 { at = afterWs2 + 1L; continue }

      if sep == 125 { break }

      return null, 1

    }

    return null, 2

  }

  // Scan a top-level JSON object and parse the value for `key` without building the full DOM.
  // Unmatched keys are skipped via `_skipValue`.
  // Error codes: 0 ok, 1 parse error, 2 not found.

  fn scanTopLevelValue(b: bytes, key: string) -> any, int{

    if b == null || key == null { return null, 1}

    let n = bstd.Bytes.len(b)

    let i, se = _skipWs(b, 0L, n)

    if se != 0 { return null, 1}

    if i >= n { return null, 1}

    let c, eo = bstd.Bytes.getU8(b, i)

    if eo != 0 || c != 123 { return null, 1} // '{'

    let at = i + 1L

    let j, se2 = _skipWs(b, at, n)

    if se2 != 0 { return null, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return null, 1}

      if cc == 125 { return null, 2} // empty object

    }
    at = j

    while true {

      let kpos, se3 = _skipWs(b, at, n)

      if se3 != 0 { return null, 1}

      let k, afterKey, ke = _parseString(b, kpos, n)

      if ke != 0 { return null, 1}

      let afterWs, se4 = _skipWs(b, afterKey, n)

      if se4 != 0 { return null, 1}

      if afterWs >= n { return null, 1}

      let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 || colon != 58 { return null, 1}

      if k == key {

        let v, afterVal, ve = _parseValue(b, afterWs + 1L, n)

        let _ = afterVal

        if ve != 0 { return null, 1}

        return v, 0

      }

      let afterVal, ve = _skipValue(b, afterWs + 1L, n)

      if ve != 0 { return null, 1}

      let afterWs2, se5 = _skipWs(b, afterVal, n)

      if se5 != 0 { return null, 1}

      if afterWs2 >= n { return null, 1}

      let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

      if ec3 != 0 { return null, 1}

      if sep == 44 { at = afterWs2 + 1L; continue }

      if sep == 125 { break }

      return null, 1

    }

    return null, 2

  }

  // Scan a top-level JSON object and return the integer (no fraction/exponent) value for `key`.
  // Error codes: 0 ok, 1 parse error/type mismatch, 2 not found.

  fn scanTopLevelLong(b: bytes, key: string) -> long, int{

    if b == null || key == null { return 0L, 1}

    let n = bstd.Bytes.len(b)

    let i, se = _skipWs(b, 0L, n)

    if se != 0 { return 0L, 1}

    if i >= n { return 0L, 1}

    let c, eo = bstd.Bytes.getU8(b, i)

    if eo != 0 || c != 123 { return 0L, 1} // '{'

    let at = i + 1L

    let j, se2 = _skipWs(b, at, n)

    if se2 != 0 { return 0L, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return 0L, 1}

      if cc == 125 { return 0L, 2} // empty object

    }
    at = j

    while true {

      let kpos, se3 = _skipWs(b, at, n)

      if se3 != 0 { return 0L, 1}

      let k, afterKey, ke = _parseString(b, kpos, n)

      if ke != 0 { return 0L, 1}

      let afterWs, se4 = _skipWs(b, afterKey, n)

      if se4 != 0 { return 0L, 1}

      if afterWs >= n { return 0L, 1}

      let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 || colon != 58 { return 0L, 1}

      let vpos, se5 = _skipWs(b, afterWs + 1L, n)

      if se5 != 0 { return 0L, 1}

      if vpos >= n { return 0L, 1}

      if k == key {
        // Parse strict integer at vpos.

        let p = vpos

        let c0, e0 = bstd.Bytes.getU8(b, p)

        if e0 != 0 { return 0L, 1}

        let sign: long = 1L

        if c0 == 45 {
          sign = -1L
          p = p + 1L

          if p >= n { return 0L, 1}

        }

        let d0, e1 = bstd.Bytes.getU8(b, p)

        if e1 != 0 { return 0L, 1}

        if !_isDigit(d0) { return 0L, 1}

        let v: long = 0L

        while true {

          if p >= n { break }

          let d, ed = bstd.Bytes.getU8(b, p)

          if ed != 0 { return 0L, 1}

          if !_isDigit(d) { break }
          v = (v * 10L) + (long)(d - 48)
          p = p + 1L

        }
        // Reject float/exponent forms.

        if p < n {

          let nxt, ee2 = bstd.Bytes.getU8(b, p)

          if ee2 != 0 { return 0L, 1}

          if nxt == 46 || nxt == 101 || nxt == 69 { return 0L, 1}

        }

        return v * sign, 0

      }

      let afterVal, ve = _skipValue(b, vpos, n)

      if ve != 0 { return 0L, 1}

      let afterWs2, se6 = _skipWs(b, afterVal, n)

      if se6 != 0 { return 0L, 1}

      if afterWs2 >= n { return 0L, 1}

      let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

      if ec3 != 0 { return 0L, 1}

      if sep == 44 { at = afterWs2 + 1L; continue }

      if sep == 125 { break }

      return 0L, 1

    }

    return 0L, 2

  }

  // Scan a top-level JSON object and return the boolean value for `key`.
  // Error codes: 0 ok, 1 parse error/type mismatch, 2 not found.

  fn scanTopLevelBool(b: bytes, key: string) -> bool, int{

    if b == null || key == null { return false, 1}

    let n = bstd.Bytes.len(b)

    let i, se = _skipWs(b, 0L, n)

    if se != 0 { return false, 1}

    if i >= n { return false, 1}

    let c, eo = bstd.Bytes.getU8(b, i)

    if eo != 0 || c != 123 { return false, 1} // '{'

    let at = i + 1L

    let j, se2 = _skipWs(b, at, n)

    if se2 != 0 { return false, 1}

    if j < n {

      let cc, ee = bstd.Bytes.getU8(b, j)

      if ee != 0 { return false, 1}

      if cc == 125 { return false, 2}

    }
    at = j

    while true {

      let kpos, se3 = _skipWs(b, at, n)

      if se3 != 0 { return false, 1}

      let k, afterKey, ke = _parseString(b, kpos, n)

      if ke != 0 { return false, 1}

      let afterWs, se4 = _skipWs(b, afterKey, n)

      if se4 != 0 { return false, 1}

      if afterWs >= n { return false, 1}

      let colon, ec2 = bstd.Bytes.getU8(b, afterWs)

      if ec2 != 0 || colon != 58 { return false, 1}

      let vpos, se5 = _skipWs(b, afterWs + 1L, n)

      if se5 != 0 { return false, 1}

      if vpos >= n { return false, 1}

      if k == key {

        let c0, e0 = bstd.Bytes.getU8(b, vpos)

        if e0 != 0 { return false, 1}

        if c0 == 116 { // true

          let lit:int[] = {116,114,117,101}

          let _, el = _skipLiteral(b, vpos, n, lit)

          if el != 0 { return false, 1}

          return true, 0

        }

        if c0 == 102 { // false

          let lit:int[] = {102,97,108,115,101}

          let _, el = _skipLiteral(b, vpos, n, lit)

          if el != 0 { return false, 1}

          return false, 0

        }

        return false, 1

      }

      let afterVal, ve = _skipValue(b, vpos, n)

      if ve != 0 { return false, 1}

      let afterWs2, se6 = _skipWs(b, afterVal, n)

      if se6 != 0 { return false, 1}

      if afterWs2 >= n { return false, 1}

      let sep, ec3 = bstd.Bytes.getU8(b, afterWs2)

      if ec3 != 0 { return false, 1}

      if sep == 44 { at = afterWs2 + 1L; continue }

      if sep == 125 { break }

      return false, 1

    }

    return false, 2

  }

  // Scan a nested JSON object by dotted key path (e.g. "a.b.c") and return the string value.
  // Error codes: 0 ok, 1 parse error/type mismatch, 2 not found.

  fn scanKeyPathString(b: bytes, path: string) -> string, int{

    if b == null || path == null { return null, 1}

    let n = bstd.Bytes.len(b)

    let vpos, e = _scanKeyPathValuePos(b, path, n)

    if e == 2 { return null, 2}

    if e != 0 { return null, 1}

    let p, se = _skipWs(b, vpos, n)

    if se != 0 { return null, 1}

    let s, _, pe = _parseString(b, p, n)

    if pe != 0 { return null, 1}

    return s, 0

  }

  // Scan a nested JSON object by dotted key path (e.g. "a.b.c") and return the integer value (no fraction/exponent).
  // Error codes: 0 ok, 1 parse error/type mismatch, 2 not found.

  fn scanKeyPathLong(b: bytes, path: string) -> long, int{

    if b == null || path == null { return 0L, 1}

    let n = bstd.Bytes.len(b)

    let vpos, e = _scanKeyPathValuePos(b, path, n)

    if e == 2 { return 0L, 2}

    if e != 0 { return 0L, 1}

    let v, _, pe = _parseStrictLongAt(b, vpos, n)

    if pe != 0 { return 0L, 1}

    return v, 0

  }

  // Scan a nested JSON object by dotted key path (e.g. "a.b.c") and return the boolean value.
  // Error codes: 0 ok, 1 parse error/type mismatch, 2 not found.

  fn scanKeyPathBool(b: bytes, path: string) -> bool, int{

    if b == null || path == null { return false, 1}

    let n = bstd.Bytes.len(b)

    let vpos, e = _scanKeyPathValuePos(b, path, n)

    if e == 2 { return false, 2}

    if e != 0 { return false, 1}

    let v, _, pe = _parseStrictBoolAt(b, vpos, n)

    if pe != 0 { return false, 1}

    return v, 0

  }

  // Parse a nested JSON object by dotted key path (e.g. "a.b.c") into a `map<string,long>`.
  // Error codes: 0 ok, 1 parse error/type mismatch, 2 not found.

  fn parseKeyPathStringLongMap(b: bytes, path: string) -> map, int{

    if b == null || path == null { return null, 1}

    let n = bstd.Bytes.len(b)

    let vpos, e = _scanKeyPathValuePos(b, path, n)

    if e == 2 { return null, 2}

    if e != 0 { return null, 1}

    let m, _, pe = _parseStringLongMapAt(b, vpos, n)

    if pe != 0 { return null, 1}

    return m, 0

  }

  // Parse a nested JSON string array by dotted key path (e.g. "a.b.c") into `string[]`.
  // Error codes: 0 ok, 1 parse error/type mismatch, 2 not found.

  fn parseKeyPathStringArray(b: bytes, path: string) -> string[], int{

    if b == null || path == null { return null, 1}

    let n = bstd.Bytes.len(b)

    let vpos, e = _scanKeyPathValuePos(b, path, n)

    if e == 2 { return null, 2}

    if e != 0 { return null, 1}

    let arr, _, pe = _parseStringArrayAt(b, vpos, n)

    if pe != 0 { return null, 1}

    return arr, 0

  }
}
