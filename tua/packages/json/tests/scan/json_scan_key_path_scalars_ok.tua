import "std/bytes" as bstd
import "std/fs" as fs
import "json" as json
import "std/rt" as rt

fn main() {

  let data, _, fe = fs.Fs.readFile("packages/json/tests/fixtures/json_key_path_scalars.json")
  assert(fe == 0)
  assert(data != null)

  let b = bstd.Bytes.fromString(data)
  rt.Rt.free(data)

  let n, en = json.Json.scanKeyPathLong(b, "a.b.n")
  assert(en == 0)
  assert(n == 123L)

  let t, et = json.Json.scanKeyPathBool(b, "a.b.t")
  assert(et == 0)
  assert(t == true)

  let f, ef = json.Json.scanKeyPathBool(b, "a.b.f")
  assert(ef == 0)
  assert(f == false)

  let _, eBad1 = json.Json.scanKeyPathLong(b, "a.b.c")
  assert(eBad1 == 1)

  let _, eBad2 = json.Json.scanKeyPathBool(b, "a.b.n")
  assert(eBad2 == 1)
}
