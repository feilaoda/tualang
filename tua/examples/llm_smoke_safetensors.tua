import SafeTensors, SafeDtype from "../packages/llm/safetensors"

fn main(args: string[]) -> int {
    let path = "examples/models/qwen3-0.6b/model.safetensors"
    if args.len() >= 2 { path = args[1] }
    let e, st = SafeTensors.parseMmap(path)
    let n: int = 0
    let tensors: map = st.tensors
    if tensors != null { n = tensors.len() }
    let okEmbed: int = 0
    let okLm: int = 0
    let okNorm: int = 0
    let okL0In: int = 0
    let okL0Q: int = 0
    if tensors != null {
        if tensors["model.embed_tokens.weight"].isSome() { okEmbed = 1 }
        if tensors["lm_head.weight"].isSome() { okLm = 1 }
        if tensors["model.norm.weight"].isSome() { okNorm = 1 }
        if tensors["model.layers.0.input_layernorm.weight"].isSome() { okL0In = 1 }
        if tensors["model.layers.0.self_attn.q_proj.weight"].isSome() { okL0Q = 1 }
    }
    println("parseMmap e={} headerLen={} tensors={} embed={} lm_head={} norm={} l0_in={} l0_q={}", e, st.headerLen, n, okEmbed, okLm, okNorm, okL0In, okL0Q)
    if tensors != null && okEmbed != 0 {
        let opt = tensors["model.embed_tokens.weight"]
        let recAny: any = opt.unwrap()
        let rec: map = recAny
        let dtAny: any = rec["dtype"].unwrap()
        let dt: int = (int)dtAny
        println("embed.dtype={} isBF16={}", dt, dt == (int)SafeDtype.bfloat16)
    }
    return 0
}
