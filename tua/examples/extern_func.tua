
native fn atoi(s: string) int;

struct Foo {
    a: int

    fn atoi(s: string) int {
        println("Foo.atoi");
        return native.atoi(s);
    }

    fn bar() {
        println("Foo.bar");
        this.atoi("123");
    }
}

object Foo2 {
    fn atoi(s: string) int {
        println("Foo.object.atoi");
        return native.atoi(s);
    }

    fn hello() {
        println("Foo.object.hello");
    }

    fn bar() {
        println("Foo.object.bar");
        //Foo2.atoi("123");
        hello();
    }
}

let foo = Foo();
foo.bar();

Foo2.atoi("1234");
Foo2.bar();