import "std/fs" as fs

fn main(args: string[]) -> int {

  let path = "examples/models/qwen3-0.6b/model.safetensors"

  if args.len() >= 2 { path = args[1] }

  let kind, size, mtimeNs, mode, e = fs.Fs.stat(path)
  println("stat e={} kind={} size={} mtimeNs={} mode={}", e, kind, size, mtimeNs, mode)

  return 0
}
