import "std/time" as time
import BpeTokenizer from "../packages/llm/tokenizer_bpe"

fn main(args: string[]) -> int {

  let path = "examples/models/qwen3-0.6b/tokenizer.json"

  if args.len() >= 2 { path = args[1] }

  let text = "Hello, world!"

  if args.len() >= 3 { text = args[2] }

  let t0 = time.Time.monoNs()

  let tok, e0 = BpeTokenizer.loadFromTokenizerJson(path)

  let t1 = time.Time.monoNs()

  if e0 != 0 { println("load tokenizer failed err={}", e0); return 1 }

  let ids0, e1 = BpeTokenizer.encode(tok, text)

  let t2 = time.Time.monoNs()

  if e1 != 0 { println("encode failed err={}", e1); return 1 }

  let ids: long[] = ids0

  let out, e2 = BpeTokenizer.decode(tok, ids)

  let t3 = time.Time.monoNs()

  if e2 != 0 { println("decode failed err={}", e2); return 1 }

  let loadMs: long = (t1 - t0) / 1000L

  let encMs: long = (t2 - t1) / 1000L

  let decMs: long = (t3 - t2) / 1000L
  println("loadMs={} encodeMs={} decodeMs={} idsLen={} roundtripOk={} t1={} t2={} t3={}", loadMs, encMs, decMs, ids.len(), out == text, t1, t2, t3)

  return 0
}
