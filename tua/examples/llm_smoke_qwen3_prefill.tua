import BpeTokenizer from "../packages/llm/tokenizer_bpe"
import Qwen3, Qwen3Infer from "../packages/llm/qwen3"
import LlmArgs from "../packages/llm/options"

fn main(args: string[]) -> int {

  let modelDir = "examples/models/qwen3-0.6b"

  let prompt = "Hello"

  if args.len() >= 2 { modelDir = args[1] }

  if args.len() >= 3 { prompt = args[2] }

  let opts, oe = LlmArgs.parseArgv(args)

  if oe != 0 { println("bad args"); return 1 }

  let tok, te = BpeTokenizer.loadFromTokenizerJson(modelDir + "/tokenizer.json")
  println("loadTokenizer e={}", te)

  if te != 0 { return 1 }

  let ids0, ee = BpeTokenizer.encode(tok, prompt)

  let ids: long[] = ids0
  println("encode e={} ids_len={}", ee, ids.len())

  if ee != 0 { return 1 }

  let st, me = Qwen3.loadState(modelDir, opts)
  println("loadState e={}", me)

  if me != 0 { return 1 }

  let pe = Qwen3Infer.prefill(st, ids)
  println("prefill e={}", pe)

  let nextId, ne = Qwen3Infer.nextTokenArgmax(st)
  println("nextTokenArgmax e={} id={}", ne, nextId)

  if ne != 0 { return 1 }

  return 0
}
