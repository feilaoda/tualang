import "std/bytes" as bstd
import "std/strconv" as conv
import "std/fs" as fs

extern fn strlen(s: string) long
extern fn tua_str_from_bytes_copy(b: bytes, off: long, len: long) string

fn main(args: string[]) -> int {
 
 
  let path: string = "examples/models/qwen3-0.6b/README.md"
 
 
  let repeat: int = 20
 
 
  if args.len() >= 2 { path = args[1] }
 
 
  if args.len() >= 3 {
 
 
 
 
 
   let o = conv.Int.parse(args[2])
 
 
 
 
 
   if o.isSome() { repeat = o.unwrap() }
 
   }

 
 
  let text, _, fe = fs.Fs.readFile(path)
 
 
  if fe != 0 { println("read file failed err={} path={}", fe, path); return 1 }

 
 
  let tb = bstd.Bytes.fromString(text)
 
 
  let tlen = bstd.Bytes.len(tb)
    println("src bytes={} repeat={}", tlen, repeat)

 
 
  if repeat > 1 && tlen > 0L {
 
 
 
 
 
   let bigLen: long = ((long)repeat) * tlen
 
 
 
 
 
   let big = bstd.Bytes.newLong(bigLen)
 
 
 
 
 
   let ri: int = 0
 
 
 
 
 
   while ri < repeat {
 
 
 
 
 
       let _ = bstd.Bytes.copy(big, ((long)ri) * tlen, tb, 0L, tlen)
            ri = ri + 1
 
       }
 
 
 
 
 
   let s = tua_str_from_bytes_copy(big, 0L, bigLen)
        println("dst bytes={} strlen={}", bigLen, strlen(s))
 
 
 
 
 
   return 0
 
   }

    println("dst bytes={} strlen={}", tlen, strlen(text))
 
 
  return 0
}
