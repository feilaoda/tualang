import "std/bytes" as bstd
import "std/strconv" as conv
import "std/fs" as fs
import "std/time" as time

fn main(args: string[]) -> int {
 
 
  let path: string = "examples/models/qwen3-0.6b/README.md"
 
 
  let repeat: int = 20
 
 
  if args.len() >= 2 { path = args[1] }
 
 
  if args.len() >= 3 {
 
 
 
 
 
   let o = conv.Int.parse(args[2])
 
 
 
 
 
   if o.isSome() { repeat = o.unwrap() }
 
   }

 
 
  let text, _, fe = fs.Fs.readFile(path)
 
 
  if fe != 0 { println("read file failed err={} path={}", fe, path); return 1 }
 
 
  let src = bstd.Bytes.fromString(text)
 
 
  let slen = bstd.Bytes.len(src)
 
 
  if slen <= 0L { println("empty"); return 0 }

 
 
  let bigLen: long = ((long)repeat) * slen
 
 
  let big = bstd.Bytes.newLong(bigLen)
 
 
  let ri: int = 0
 
 
  while ri < repeat {
 
 
 
 
 
   let _ = bstd.Bytes.copy(big, ((long)ri) * slen, src, 0L, slen)
        ri = ri + 1
 
   }

 
 
  let t0 = time.Time.monoNs()
 
 
  let sum: long = 0L
 
 
  let i: long = 0L
 
 
  while i < bigLen {
 
 
 
 
 
   let v, e = bstd.Bytes.getU8(big, i)
 
 
 
 
 
   if e != 0 { println("getU8 failed"); return 1 }
        sum = sum + (long)v
        i = i + 1L
 
   }
 
 
  let t1 = time.Time.monoNs()
    println("bytes={} repeat={} sum={} dtMs={}", bigLen, repeat, sum, (t1 - t0) / 1000000L)
 
 
  return 0
}
