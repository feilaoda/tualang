fn <T> process(t:T) int,Error {
    if t % 2 == 0 {
        return t
    }else {
        return 0, Error()
    }
}

if err {
    panic(err)
}

assert(err)
continue(err)


fn seq() int,Error {
    var res = array<T>()
    for item in self {
        var r, err = process(item)
        if err {
            continue
        }
        res.append(r)
    }
    return res,Ok()
}


fn assert(isTrue: boolean, err: Error) int , Error {
    if !isTrue {
        exitCaller(__CALLER__,__VA_ARGS__,__CALLERLINE__, err)
    }
}

fn foo(n:int) int, Error {
    if n > 10 {
        return 0,Ok()
    } else {
        return n,Error("n不大于10")
    }

    return (n,Ok()) if n > 10 else (n, Error())
}

