struct SystemCode {
    code: int
}

struct Ok : SystemCode {

}

struct Error<T> : SystemCode{
    code:int,
    message:string,
    data: T
}

def Ok = Error(0)
def Err = Error(-1)


impl Error {
    init() {
        code = 1
    }
    init(code:int) {
        this.code = code
    }
    init(msg:string) {
        code = 1
        message = msg
    }
    init(code:int, msg:string, t:T) {
        this.code = code
        this.message = msg
        this.data = t
    }

    fn detail() string {

    }
}

